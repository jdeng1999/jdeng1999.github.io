---
/**
 * FooterLike — a lightweight, local-only like counter.
 *
 * The site is fully static, so there is no backend to aggregate likes.
 * The button remembers the visitor's own like in localStorage and keeps
 * the display count in sync, which is enough for the footer affordance.
 */
interface Props {
  base?: number;
  likeLabel: string;
  ariaLabel: string;
  class?: string;
}

const {
  base = 3744,
  likeLabel,
  ariaLabel,
  class: className = "",
} = Astro.props;

const formatted = new Intl.NumberFormat(Astro.currentLocale || "en").format(
  base
);
---

<button
  type="button"
  class:list={["footer-like", className]}
  data-footer-like
  data-base={base}
  data-label-like={likeLabel}
  aria-label={ariaLabel}
  aria-pressed="false"
>
  <svg
    class="footer-like-heart"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <span class="footer-like-count" data-footer-like-count>
    {formatted}
  </span>
  <span class="footer-like-label" data-footer-like-label>
    {likeLabel}
  </span>
</button>

<style>
  .footer-like {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 9.5rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid
      color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .footer-like:hover {
    color: color-mix(in srgb, var(--color-foreground) 85%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    box-shadow: 0 10px 22px -18px
      color-mix(in srgb, var(--color-accent) 90%, transparent);
    transform: translateY(-1px);
  }

  .footer-like:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 2px;
  }

  .footer-like-heart {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    transition:
      fill 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-like-count {
    font-variant-numeric: tabular-nums;
  }

  .footer-like-label {
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  .footer-like[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .footer-like[aria-pressed="true"] .footer-like-heart {
    fill: currentColor;
  }

  .footer-like.is-popping .footer-like-heart {
    animation: footer-like-pop 0.4s ease;
  }

  @keyframes footer-like-pop {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-like,
    .footer-like-heart {
      transition: none;
    }

    .footer-like:hover {
      transform: none;
    }

    .footer-like.is-popping .footer-like-heart {
      animation: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = "jdeng:liked";

  const readLiked = () => {
    try {
      return localStorage.getItem(STORAGE_KEY) === "true";
    } catch {
      return false;
    }
  };

  const writeLiked = (liked: boolean) => {
    try {
      localStorage.setItem(STORAGE_KEY, String(liked));
    } catch {
      /* storage can be unavailable in private mode */
    }
  };

  const sync = () => {
    const liked = readLiked();
    const locale = document.documentElement.lang || "en";

    document
      .querySelectorAll<HTMLButtonElement>("[data-footer-like]")
      .forEach(button => {
        const base = Number(button.dataset.base ?? 0);
        const count = button.querySelector<HTMLElement>(
          "[data-footer-like-count]"
        );
        const label = button.querySelector<HTMLElement>(
          "[data-footer-like-label]"
        );

        button.setAttribute("aria-pressed", String(liked));

        if (count) {
          count.textContent = new Intl.NumberFormat(locale).format(
            liked ? base + 1 : base
          );
        }

        if (label) {
          label.textContent = button.dataset.labelLike ?? "Likes";
        }
      });
  };

  document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-footer-like]");
    if (!button) return;

    const liked = !readLiked();
    writeLiked(liked);
    sync();

    if (!liked) return;

    button.classList.remove("is-popping");
    requestAnimationFrame(() => button.classList.add("is-popping"));
    button.addEventListener(
      "animationend",
      () => button.classList.remove("is-popping"),
      { once: true }
    );
  });

  document.addEventListener("astro:page-load", sync);
  sync();
</script>
