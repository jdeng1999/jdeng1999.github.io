---
/**
 * FooterLike — a shared like counter backed by a public counting API.
 *
 * The site is fully static, so the running total lives in a small public
 * counter service. Every visitor sees and increments the same number, while
 * the visitor's own pressed state is remembered in localStorage. If the
 * network request fails, the optimistic increment is rolled back.
 */
interface Props {
  base?: number;
  likeLabel: string;
  ariaLabel: string;
  class?: string;
}

const {
  base = 3744,
  likeLabel,
  ariaLabel,
  class: className = "",
} = Astro.props;

const formatted = new Intl.NumberFormat(Astro.currentLocale || "en").format(
  base
);
---

<button
  type="button"
  class:list={["footer-like", className]}
  data-footer-like
  data-base={base}
  data-label-like={likeLabel}
  aria-label={ariaLabel}
  aria-pressed="false"
>
  <svg
    class="footer-like-heart"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <span class="footer-like-count" data-footer-like-count>
    {formatted}
  </span>
  <span class="footer-like-label" data-footer-like-label>
    {likeLabel}
  </span>
</button>

<style>
  .footer-like {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 9.5rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid
      color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .footer-like:hover {
    color: color-mix(in srgb, var(--color-foreground) 85%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    box-shadow: 0 10px 22px -18px
      color-mix(in srgb, var(--color-accent) 90%, transparent);
    transform: translateY(-1px);
  }

  .footer-like:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 2px;
  }

  .footer-like-heart {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    transition:
      fill 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-like-count {
    font-variant-numeric: tabular-nums;
  }

  .footer-like-label {
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  .footer-like[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    cursor: default;
  }

  .footer-like[aria-pressed="true"] .footer-like-heart {
    fill: currentColor;
  }

  .footer-like.is-popping .footer-like-heart {
    animation: footer-like-pop 0.4s ease;
  }

  @keyframes footer-like-pop {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-like,
    .footer-like-heart {
      transition: none;
    }

    .footer-like:hover {
      transform: none;
    }

    .footer-like.is-popping .footer-like-heart {
      animation: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = "jdeng:liked";
  const CACHE_KEY = "jdeng:likes-cache";
  const LIKE_API = "https://countapi.mileshilliard.com/api/v1";
  const LIKE_KEY = "jdeng1999_github_io_footer_likes";

  let remoteLikes: number | null = null;
  let remotePromise: Promise<number | null> | null = null;
  let localChange = 0;

  const readLiked = () => {
    try {
      return localStorage.getItem(STORAGE_KEY) === "true";
    } catch {
      return false;
    }
  };

  const writeLiked = (liked: boolean) => {
    try {
      localStorage.setItem(STORAGE_KEY, String(liked));
    } catch {
      /* storage can be unavailable in private mode */
    }
  };

  // The counter API answers in 1-4s, so the last known total is cached and
  // painted straight away; the network read then refreshes it silently.
  const readCache = () => {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const value = Number((JSON.parse(raw) as { value?: unknown })?.value);
      return Number.isFinite(value) && value > 0 ? value : null;
    } catch {
      return null;
    }
  };

  const writeCache = (value: number) => {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({ value }));
    } catch {
      /* storage can be unavailable in private mode */
    }
  };

  const likeButtons = () =>
    Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-footer-like]")
    );

  const paint = () => {
    const liked = readLiked();
    const locale = document.documentElement.lang || "en";
    const formatter = new Intl.NumberFormat(locale);

    likeButtons().forEach(button => {
      const base = Number(button.dataset.base ?? 0);
      const count = button.querySelector<HTMLElement>(
        "[data-footer-like-count]"
      );
      const label = button.querySelector<HTMLElement>(
        "[data-footer-like-label]"
      );

      button.setAttribute("aria-pressed", String(liked));
      if (count) count.textContent = formatter.format(remoteLikes ?? base);
      if (label) label.textContent = button.dataset.labelLike ?? "Likes";
    });
  };

  const request = async (url: string) => {
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 8000);
    try {
      return await fetch(url, {
        signal: controller.signal,
        cache: "no-store",
        headers: { Accept: "application/json" },
      });
    } finally {
      window.clearTimeout(timer);
    }
  };

  const readValue = async (response: Response) => {
    if (!response.ok) return null;
    const data = (await response.json()) as { value?: number | string };
    const value = Number(data.value);
    return Number.isFinite(value) ? value : null;
  };

  const loadRemote = () => {
    if (remotePromise) return remotePromise;

    const promise = (async () => {
      const version = localChange;
      try {
        let response = await request(`${LIKE_API}/get/${LIKE_KEY}`);

        // Seed the shared counter on the first deployment. The baseline is the
        // count shown before real likes existed; after this one-time
        // initialisation every click increments the same public counter.
        if (response.status === 404) {
          const base = Number(likeButtons()[0]?.dataset.base ?? 0);
          response = await request(`${LIKE_API}/set/${LIKE_KEY}?value=${base}`);
        }

        const value = await readValue(response);
        if (value !== null && version === localChange) {
          remoteLikes = value;
          writeCache(value);
        }
      } catch {
        /* Keep the server-rendered baseline when the network is unavailable. */
      }

      return remoteLikes;
    })();

    remotePromise = promise;
    void promise.finally(() => {
      // An in-flight read from the previous page must not clear the promise
      // belonging to the page that replaced it.
      if (remotePromise === promise) remotePromise = null;
      paint();
    });

    return promise;
  };

  const incrementRemote = async () => {
    localChange += 1;
    const previous = remoteLikes;
    const base = Number(likeButtons()[0]?.dataset.base ?? 0);
    remoteLikes = (remoteLikes ?? base) + 1;
    paint();

    try {
      const response = await request(`${LIKE_API}/hit/${LIKE_KEY}`);
      const value = await readValue(response);
      if (value === null) throw new Error("Like counter did not respond");
      remoteLikes = value;
      writeCache(value);
    } catch {
      remoteLikes = previous;
      writeLiked(false);
    }

    paint();
  };

  document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-footer-like]");
    if (!button || readLiked()) return;

    writeLiked(true);
    paint();
    void incrementRemote();

    button.classList.remove("is-popping");
    requestAnimationFrame(() => button.classList.add("is-popping"));
    button.addEventListener(
      "animationend",
      () => button.classList.remove("is-popping"),
      { once: true }
    );
  });

  let navigated = false;

  document.addEventListener("astro:before-swap", () => {
    navigated = true;
  });

  document.addEventListener("astro:page-load", () => {
    // The first page-load fires alongside this script's own boot; only a real
    // client-side navigation needs a fresh read of the shared counter.
    if (!navigated) return;
    navigated = false;
    localChange += 1;
    remoteLikes = readCache();
    remotePromise = null;
    paint();
    void loadRemote();
  });

  remoteLikes = readCache();
  paint();
  void loadRemote();
</script>
