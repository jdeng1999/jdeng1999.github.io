---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n/utils";

type Props = {
  headings: MarkdownHeading[];
  isMobile?: boolean;
};

const { headings, isMobile = false } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

// Filter headings: only h2 and h3
const tocHeadings = headings.filter(h => h.depth > 1 && h.depth < 4);

if (tocHeadings.length === 0) {
  return null;
}
---

<nav class="toc-navigation" aria-label={t("toc.aria")}>
  {!isMobile && (
    <h2 class="toc-heading font-firacode text-[10px] tracking-widest text-foreground/45 uppercase select-none">
      {t("toc.title")}
    </h2>
  )}
  <ul
    class:list={["toc-list flex flex-col gap-1.5", isMobile ? "mt-0" : "mt-4"]}
  >
    {tocHeadings.map(heading => (
      <li class={`toc-item depth-${heading.depth}`}>
        <a
          href={`#${heading.slug}`}
          class="toc-link block font-firacode text-[12.5px] text-foreground/60 no-underline hover:text-accent"
          data-toc-link
        >
          <span class="toc-label">{heading.text}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function setupTocHighlight() {
    const headingElements = Array.from(
      document.querySelectorAll("#article h2, #article h3")
    );
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));

    if (headingElements.length === 0 || tocLinks.length === 0) return null;

    const activeHeaders = new Map<string, boolean>();

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          activeHeaders.set(entry.target.id, entry.isIntersecting);
        });

        // Find the first visible heading
        let activeId = "";
        for (const heading of headingElements) {
          if (activeHeaders.get(heading.id)) {
            activeId = heading.id;
            break;
          }
        }

        // If no heading is currently in view, find the last one that was above the viewport
        if (!activeId) {
          const scrollPosition = window.scrollY + 120; // offset for sticky header
          for (let i = headingElements.length - 1; i >= 0; i--) {
            const heading = headingElements[i];
            const offsetTop =
              heading.getBoundingClientRect().top + window.scrollY;
            if (scrollPosition >= offsetTop) {
              activeId = heading.id;
              break;
            }
          }
        }

        // Update active state in DOM
        tocLinks.forEach(link => {
          if (link.getAttribute("href") === `#${activeId}`) {
            link.classList.add("active");
          } else {
            link.classList.remove("active");
          }
        });
      },
      {
        rootMargin: "0px 0px -65% 0px",
        threshold: 0.1,
      }
    );

    headingElements.forEach(el => observer.observe(el));

    const clickController = new AbortController();
    document
      .querySelectorAll<HTMLAnchorElement>(".mobile-toc [data-toc-link]")
      .forEach(link => {
        link.addEventListener(
          "click",
          () => {
            const details = link.closest<HTMLDetailsElement>(".mobile-toc");
            if (details) details.open = false;
          },
          { signal: clickController.signal }
        );
      });

    // Return cleanup function
    return () => {
      observer.disconnect();
      clickController.abort();
    };
  }

  let cleanup: (() => void) | null = null;
  let carryTocState = false;

  // Only a language switch keeps the mobile TOC open. Re-entering the article
  // (reload, back navigation, or another post) starts from the collapsed
  // default, as the `<details>` element is rendered without `open`.
  document.addEventListener(
    "click",
    event => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-lang-toggle]")) {
        carryTocState = true;
      }
    },
    true
  );

  document.addEventListener("astro:before-swap", event => {
    if (!carryTocState) return;

    const current = document.querySelector<HTMLDetailsElement>(".mobile-toc");
    if (!current) {
      carryTocState = false;
      return;
    }

    const next = (
      event as Event & { newDocument: Document }
    ).newDocument.querySelector<HTMLDetailsElement>(".mobile-toc");
    if (next) next.open = current.open;
    carryTocState = false;
  });

  document.addEventListener("astro:page-load", () => {
    if (cleanup) cleanup();
    cleanup = setupTocHighlight();
    carryTocState = false;
  });
</script>

<script>
  let tocInteractionCleanup: AbortController | null = null;

  function initTocInteractions() {
    tocInteractionCleanup?.abort();
    const controller = new AbortController();
    tocInteractionCleanup = controller;
    const { signal } = controller;

    const clearDesktopReveal = () => {
      document
        .querySelectorAll<HTMLElement>(".sidebar-toc.is-toc-expanded")
        .forEach(aside => aside.classList.remove("is-toc-expanded"));
      document
        .querySelectorAll<HTMLElement>(".toc-link.is-toc-expanded")
        .forEach(link => link.classList.remove("is-toc-expanded"));
    };

    const revealDesktop = (link: HTMLAnchorElement) => {
      if (link.closest(".mobile-toc")) return;
      if (link.scrollWidth <= link.clientWidth + 2) {
        clearDesktopReveal();
        return;
      }

      const aside = link.closest(".sidebar-toc");
      if (!aside) return;

      clearDesktopReveal();
      aside.classList.add("is-toc-expanded");
      link.classList.add("is-toc-expanded");
    };

    document
      .querySelectorAll<HTMLAnchorElement>(".toc-link[data-toc-link]")
      .forEach(link => {
        if (link.closest(".mobile-toc")) return;
        link.addEventListener(
          "pointerenter",
          event => {
            if (event.pointerType === "touch") return;
            revealDesktop(link);
          },
          { signal }
        );
        link.addEventListener("pointerleave", clearDesktopReveal, { signal });
        link.addEventListener("focus", () => revealDesktop(link), { signal });
        link.addEventListener("blur", clearDesktopReveal, { signal });
      });

    window.addEventListener("scroll", clearDesktopReveal, {
      passive: true,
      capture: true,
      signal,
    });
    window.addEventListener("resize", clearDesktopReveal, { signal });

    // Mobile: drag the entire TOC content horizontally with edge resistance.
    // This keeps every row aligned and avoids a separate scrollbar.
    document
      .querySelectorAll<HTMLElement>(".mobile-toc .toc-navigation")
      .forEach(nav => {
        const list = nav.querySelector<HTMLElement>(".toc-list");
        if (!list) return;

        let shift = 0;
        let dragging = false;
        let moved = false;
        let captured = false;
        let startX = 0;
        let startShift = 0;
        let pointerId = -1;

        const minShift = () => Math.min(0, nav.clientWidth - list.scrollWidth);

        const apply = (value: number, animate: boolean) => {
          shift = value;
          list.style.transition = animate ? "" : "none";
          list.style.setProperty("--toc-mobile-shift", `${value}px`);
        };

        const sync = () => {
          apply(Math.max(minShift(), Math.min(0, shift)), false);
        };

        nav.addEventListener(
          "pointerdown",
          event => {
            if (event.pointerType === "mouse") return;
            if (minShift() > -1) return;

            dragging = true;
            moved = false;
            captured = false;
            pointerId = event.pointerId;
            startX = event.clientX;
            startShift = shift;
            nav.classList.add("is-toc-dragging");
          },
          { signal }
        );

        nav.addEventListener(
          "pointermove",
          event => {
            if (!dragging || event.pointerId !== pointerId) return;

            const dx = event.clientX - startX;
            if (Math.abs(dx) > 6) moved = true;

            if (moved && !captured) {
              captured = true;
              try {
                nav.setPointerCapture?.(event.pointerId);
              } catch {
                /* pointer may already be gone */
              }
            }

            const min = minShift();
            let next = startShift + dx;
            if (next > 0) next *= 0.3;
            else if (next < min) next = min + (next - min) * 0.3;

            apply(next, false);
            if (moved) event.preventDefault();
          },
          { signal }
        );

        const endDrag = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;

          dragging = false;
          pointerId = -1;
          nav.classList.remove("is-toc-dragging");
          apply(Math.max(minShift(), Math.min(0, shift)), true);

          try {
            if (captured && nav.hasPointerCapture?.(event.pointerId)) {
              nav.releasePointerCapture(event.pointerId);
            }
          } catch {
            /* capture may already be released */
          }
          captured = false;

          if (moved) {
            nav.dataset.tocDragged = "true";
            window.setTimeout(() => {
              delete nav.dataset.tocDragged;
            }, 240);
          }
        };

        nav.addEventListener("pointerup", endDrag, { signal });
        nav.addEventListener("pointercancel", endDrag, { signal });
        nav.addEventListener(
          "click",
          event => {
            if (nav.dataset.tocDragged !== "true") return;
            event.preventDefault();
            event.stopPropagation();
          },
          { capture: true, signal }
        );

        const details = nav.closest("details");
        details?.addEventListener(
          "toggle",
          () => {
            if (details.open) requestAnimationFrame(sync);
            else apply(0, false);
          },
          { signal }
        );

        window.addEventListener(
          "resize",
          () => apply(Math.max(minShift(), Math.min(0, shift)), false),
          { signal }
        );

        requestAnimationFrame(sync);
      });

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearDesktopReveal();
        controller.abort();
        tocInteractionCleanup = null;
      },
      { once: true, signal }
    );
  }

  initTocInteractions();
  document.addEventListener("astro:page-load", initTocInteractions);
</script>

<style>
  .toc-navigation {
    position: relative;
    padding-left: 0.5rem;
  }

  .toc-heading {
    padding-bottom: 0.35rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.85rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
    border-left: 1px solid color-mix(in srgb, var(--border) 10%, transparent);
    margin-left: 0.25rem;
  }

  .toc-link {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    line-height: 1.5;
    padding: 0.2rem 0;
    white-space: nowrap;
    text-overflow: clip;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 1.35rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 1.35rem),
      transparent 100%
    );
  }

  .toc-label {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  .toc-link.is-toc-expanded {
    overflow: visible;
    -webkit-mask-image: none;
    mask-image: none;
    color: var(--accent) !important;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  :global(.sidebar-toc.is-toc-expanded) {
    overflow: visible !important;
    z-index: 30;
  }

  .toc-link.active {
    color: var(--accent) !important;
    font-weight: 500;
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  @media (max-width: 1023px) {
    :global(.mobile-toc) .toc-navigation {
      overflow: hidden;
      touch-action: pan-y;
    }

    :global(.mobile-toc) .toc-list {
      width: max-content;
      min-width: 100%;
      padding-right: 1.35rem;
      transform: translate3d(var(--toc-mobile-shift, 0px), 0, 0);
      transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    :global(.mobile-toc) .toc-navigation.is-toc-dragging .toc-list {
      transition: none;
    }

    :global(.mobile-toc) .toc-link {
      width: 100%;
      max-width: none;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
      touch-action: pan-y;
      -webkit-user-select: none;
      user-select: none;
    }

    :global(.mobile-toc) .toc-label {
      width: max-content;
      min-width: 100%;
      transform: none;
    }
  }
</style>
