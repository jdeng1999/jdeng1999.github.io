---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n/utils";

type Props = {
  headings: MarkdownHeading[];
  isMobile?: boolean;
};

const { headings, isMobile = false } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

// Filter headings: only h2 and h3
const tocHeadings = headings.filter(h => h.depth > 1 && h.depth < 4);

if (tocHeadings.length === 0) {
  return null;
}
---

<nav class="toc-navigation" aria-label={t("toc.aria")}>
  {!isMobile && (
    <h2 class="toc-heading font-firacode text-[10px] tracking-widest text-foreground/45 uppercase select-none">
      {t("toc.title")}
    </h2>
  )}
  <ul
    class:list={["toc-list flex flex-col gap-1.5", isMobile ? "mt-0" : "mt-4"]}
  >
    {tocHeadings.map(heading => (
      <li class={`toc-item depth-${heading.depth}`}>
        <a
          href={`#${heading.slug}`}
          class="toc-link block font-firacode text-[12.5px] text-foreground/60 no-underline transition-all duration-200 hover:text-accent"
          data-toc-link
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function setupTocHighlight() {
    const headingElements = Array.from(
      document.querySelectorAll("#article h2, #article h3")
    );
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));

    if (headingElements.length === 0 || tocLinks.length === 0) return null;

    const activeHeaders = new Map<string, boolean>();

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          activeHeaders.set(entry.target.id, entry.isIntersecting);
        });

        // Find the first visible heading
        let activeId = "";
        for (const heading of headingElements) {
          if (activeHeaders.get(heading.id)) {
            activeId = heading.id;
            break;
          }
        }

        // If no heading is currently in view, find the last one that was above the viewport
        if (!activeId) {
          const scrollPosition = window.scrollY + 120; // offset for sticky header
          for (let i = headingElements.length - 1; i >= 0; i--) {
            const heading = headingElements[i];
            const offsetTop =
              heading.getBoundingClientRect().top + window.scrollY;
            if (scrollPosition >= offsetTop) {
              activeId = heading.id;
              break;
            }
          }
        }

        // Update active state in DOM
        tocLinks.forEach(link => {
          if (link.getAttribute("href") === `#${activeId}`) {
            link.classList.add("active");
          } else {
            link.classList.remove("active");
          }
        });
      },
      {
        rootMargin: "0px 0px -65% 0px",
        threshold: 0.1,
      }
    );

    headingElements.forEach(el => observer.observe(el));

    const clickController = new AbortController();
    document
      .querySelectorAll<HTMLAnchorElement>(".mobile-toc [data-toc-link]")
      .forEach(link => {
        link.addEventListener(
          "click",
          () => {
            const details = link.closest<HTMLDetailsElement>(".mobile-toc");
            if (details) details.open = false;
          },
          { signal: clickController.signal }
        );
      });

    // Return cleanup function
    return () => {
      observer.disconnect();
      clickController.abort();
    };
  }

  let cleanup: (() => void) | null = null;
  let carryTocState = false;

  // Only a language switch keeps the mobile TOC open. Re-entering the article
  // (reload, back navigation, or another post) starts from the collapsed
  // default, as the `<details>` element is rendered without `open`.
  document.addEventListener(
    "click",
    event => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-lang-toggle]")) {
        carryTocState = true;
      }
    },
    true
  );

  document.addEventListener("astro:before-swap", event => {
    if (!carryTocState) return;

    const current = document.querySelector<HTMLDetailsElement>(".mobile-toc");
    if (!current) {
      carryTocState = false;
      return;
    }

    const next = (
      event as Event & { newDocument: Document }
    ).newDocument.querySelector<HTMLDetailsElement>(".mobile-toc");
    if (next) next.open = current.open;
    carryTocState = false;
  });

  document.addEventListener("astro:page-load", () => {
    if (cleanup) cleanup();
    cleanup = setupTocHighlight();
    carryTocState = false;
  });
</script>

<script>
  let tocPreviewCleanup: AbortController | null = null;

  function initTocPreview() {
    tocPreviewCleanup?.abort();
    const controller = new AbortController();
    tocPreviewCleanup = controller;
    const { signal } = controller;

    let preview = document.getElementById("toc-hover-preview");
    if (!preview) {
      preview = document.createElement("div");
      preview.id = "toc-hover-preview";
      preview.className = "toc-hover-preview";
      preview.setAttribute("aria-hidden", "true");
      document.body.appendChild(preview);
    }

    const hide = () => {
      preview?.classList.remove("is-open");
      document
        .querySelectorAll<HTMLElement>(".toc-link.is-previewing")
        .forEach(link => link.classList.remove("is-previewing"));
    };

    const show = (link: HTMLAnchorElement) => {
      if (!preview) return;
      if (link.scrollWidth <= link.clientWidth + 2) {
        hide();
        return;
      }

      const rect = link.getBoundingClientRect();
      preview.textContent = link.textContent?.trim() ?? "";
      preview.style.left = `${Math.round(rect.left - 7)}px`;
      preview.style.top = `${Math.round(rect.top - 3)}px`;
      preview.classList.add("is-open");

      document
        .querySelectorAll<HTMLElement>(".toc-link.is-previewing")
        .forEach(item => {
          if (item !== link) item.classList.remove("is-previewing");
        });
      link.classList.add("is-previewing");
    };

    document
      .querySelectorAll<HTMLAnchorElement>(".toc-link[data-toc-link]")
      .forEach(link => {
        link.addEventListener("pointerenter", () => show(link), { signal });
        link.addEventListener("pointerleave", hide, { signal });
        link.addEventListener("focus", () => show(link), { signal });
        link.addEventListener("blur", hide, { signal });
      });

    window.addEventListener("scroll", hide, {
      passive: true,
      capture: true,
      signal,
    });
    window.addEventListener("resize", hide, { signal });

    document.addEventListener(
      "astro:before-swap",
      () => {
        hide();
        controller.abort();
        tocPreviewCleanup = null;
      },
      { once: true, signal }
    );
  }

  initTocPreview();
  document.addEventListener("astro:page-load", initTocPreview);
</script>

<style>
  .toc-navigation {
    position: relative;
    padding-left: 0.5rem;
  }

  .toc-heading {
    padding-bottom: 0.35rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.85rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
    border-left: 1px solid color-mix(in srgb, var(--border) 10%, transparent);
    margin-left: 0.25rem;
  }

  .toc-link {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    line-height: 1.5;
    padding: 0.2rem 0;
    white-space: nowrap;
    text-overflow: clip;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 1.35rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 1.35rem),
      transparent 100%
    );
  }

  .toc-link.is-previewing {
    color: transparent !important;
    text-shadow: none !important;
  }

  .toc-link.active {
    color: var(--accent) !important;
    font-weight: 500;
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  :global(.toc-hover-preview) {
    position: fixed;
    z-index: 220;
    max-width: none;
    padding: 0.2rem 0.45rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--background) 97%, transparent);
    box-shadow: 0 0 18px 8px
      color-mix(in srgb, var(--background) 82%, transparent);
    color: var(--accent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 12.5px;
    line-height: 1.5;
    white-space: nowrap;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  :global(.toc-hover-preview.is-open) {
    visibility: visible;
    opacity: 1;
  }
</style>
