---
/**
 * NowPlaying — a custom, theme-aware music card for the footer.
 *
 * Playback order:
 *   1. A local audio file (`public/audio/...`) gives every visitor the full
 *      track, with no login and no 30-second preview limit.
 *   2. If that file is missing, the card falls back to Spotify's official
 *      iFrame API (which streams a 30s preview to anonymous visitors).
 *
 * The card shows the current track, controls, and a short "enjoy" line; the
 * deck itself is a three-card stack that switches one card per gesture.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import IconSpotify from "@/assets/icons/IconSpotify.svg";
import { SITE } from "@/config";

interface Props {
  label?: string;
  enjoyLabel?: string;
  openLabel?: string;
  playLabel?: string;
  pauseLabel?: string;
  restartLabel?: string;
  seekLabel?: string;
  previewLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  modeLabel?: string;
  orderLabel?: string;
  repeatLabel?: string;
  shuffleLabel?: string;
  class?: string;
}

const {
  label = "On repeat",
  enjoyLabel = "Enjoy the music ~",
  openLabel = "Open in Spotify",
  playLabel = "Play",
  pauseLabel = "Pause",
  restartLabel = "Restart",
  seekLabel = "Seek",
  previewLabel = "Preview",
  previousLabel = "Previous track",
  nextLabel = "Next track",
  modeLabel = "Playback mode",
  orderLabel = "Sequential",
  repeatLabel = "Repeat one",
  shuffleLabel = "Shuffle",
  class: className = "",
} = Astro.props;

const formatTime = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

const tracks = SITE.spotify.tracks.map(track => {
  const src = track.src ?? "";
  const isRemote = /^https?:\/\//i.test(src);
  const localPath =
    src.startsWith("/") && !isRemote
      ? fileURLToPath(new URL(`../../public${src}`, import.meta.url))
      : "";
  const isLocal =
    Boolean(src) && (isRemote || (localPath && existsSync(localPath)));
  const match = track.url.match(/track\/([A-Za-z0-9]+)/);

  return {
    title: track.title,
    artist: track.artist,
    album: track.album,
    cover: track.cover,
    url: track.url,
    src,
    isLocal: Boolean(isLocal),
    spotifyUri: match ? `spotify:track:${match[1]}` : "",
    duration: track.duration,
    lyrics: [...track.lyrics],
  };
});

const first = tracks[0];
if (!first) {
  throw new Error(
    "NowPlaying requires at least one track in SITE.spotify.tracks"
  );
}

const payload = {
  tracks,
  labels: {
    open: openLabel,
    play: playLabel,
    pause: pauseLabel,
    restart: restartLabel,
    seek: seekLabel,
    preview: previewLabel,
    previous: previousLabel,
    next: nextLabel,
    mode: modeLabel,
    order: orderLabel,
    repeat: repeatLabel,
    shuffle: shuffleLabel,
  },
};

const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");
const totalLabel = formatTime(first.duration);
---

<aside
  class:list={["now-playing", className]}
  aria-label={label}
  data-np
  data-np-playing="false"
>
  <div class="np-stack" data-np-stack>
    <div class="np-stage" data-np-stage>
      <div class="np-card" data-np-card data-np-track-index="0">
        <button
          type="button"
          class="np-peek-face"
          data-np-peek-face
          aria-label={`${first.title} — ${nextLabel}`}
        >
          <img
            class="np-peek-cover"
            data-np-peek-cover
            src={first.cover}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
          <span class="np-peek-title" data-np-peek-title>
            {first.title}
          </span>
          <span class="np-peek-arrow" aria-hidden="true">
            ↗
          </span>
        </button>

        <div class="np-art">
          <img
            data-np-cover
            src={first.cover}
            alt=""
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
          />
          <span class="np-art-sheen" aria-hidden="true"></span>
        </div>

        <div class="np-body" data-np-body>
          <div class="np-head">
            <p class="np-eyebrow">
              <span class="np-eq" aria-hidden="true">
                {Array.from({ length: 4 }).map((_, index) => (
                  <i style={`--i: ${index}`} />
                ))}
              </span>
              <span>{label}</span>
            </p>

            <div class="np-head-right">
              <span class="np-count" data-np-count>
                01 / {String(tracks.length).padStart(2, "0")}
              </span>
              <a
                class="np-open"
                data-np-link
                href={first.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={openLabel}
              >
                <IconSpotify class="np-open-icon" />
                <span>Spotify</span>
                <span class="np-open-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </div>
          </div>

          <div class="np-meta">
            <p class="np-title" data-np-title>
              {first.title}
            </p>
            <p class="np-sub">
              <span data-np-artist>{first.artist}</span>
              <span class="np-dot" aria-hidden="true">
                ·
              </span>
              <span class="np-album" data-np-album>
                {first.album}
              </span>
            </p>
          </div>

          <p class="np-enjoy">{enjoyLabel}</p>

          <div class="np-progress">
            <span class="np-time" data-np-current>
              0:00
            </span>
            <div
              class="np-seek"
              data-np-seek
              role="slider"
              tabindex="0"
              aria-label={seekLabel}
              aria-valuemin="0"
              aria-valuemax={String(first.duration)}
              aria-valuenow="0"
              aria-valuetext="0:00"
            >
              <span class="np-seek-rail">
                <span class="np-seek-fill" data-np-fill></span>
              </span>
              <span class="np-seek-thumb" aria-hidden="true"></span>
            </div>
            <span class="np-time" data-np-total>
              {totalLabel}
            </span>
          </div>

          <div class="np-controls">
            <button
              type="button"
              class="np-skip"
              data-np-prev
              aria-label={previousLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.5 5.5v13l-9-6.5 9-6.5Z" />
                <path d="M6.5 5.5v13" />
              </svg>
            </button>

            <button
              type="button"
              class="np-toggle"
              data-np-toggle
              aria-label={playLabel}
              aria-pressed="false"
            >
              <svg
                class="np-icon np-icon-play"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
              </svg>
              <svg
                class="np-icon np-icon-pause"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8.25 4.5h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Zm5 0h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Z" />
              </svg>
            </button>

            <button
              type="button"
              class="np-skip"
              data-np-next
              aria-label={nextLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.5 5.5v13l9-6.5-9-6.5Z" />
                <path d="M17.5 5.5v13" />
              </svg>
            </button>

            <button
              type="button"
              class="np-restart"
              data-np-restart
              aria-label={restartLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 5.25v4.5h4.5" />
                <path d="M4.78 9.5a8 8 0 1 1 .3 5.6" />
              </svg>
            </button>

            <button
              type="button"
              class="np-mode"
              data-np-mode
              data-mode="order"
              aria-label="Playback mode"
            >
              <svg
                class="np-mode-icon np-mode-icon--order"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M4 7h13l-3-3" />
                <path d="M20 17H7l3 3" />
              </svg>
              <svg
                class="np-mode-icon np-mode-icon--repeat"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M17 3.5 20.5 7 17 10.5" />
                <path d="M20 7H7a3.5 3.5 0 0 0-3.5 3.5V12" />
                <path d="M7 20.5 3.5 17 7 13.5" />
                <path d="M4 17h13a3.5 3.5 0 0 0 3.5-3.5V12" />
                <text x="11.4" y="14.8" class="np-mode-one">
                  1
                </text>
              </svg>
              <svg
                class="np-mode-icon np-mode-icon--shuffle"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M3 6h3.2c1.4 0 2.6.7 3.4 1.9l5 7.2c.8 1.2 2 1.9 3.4 1.9H21" />
                <path d="m18 14 3 3-3 3" />
                <path d="M3 18h3.2c1.4 0 2.6-.7 3.4-1.9l1-1.4" />
                <path d="m18 3 3 3-3 3" />
                <path d="M14.5 9.2c.6-1.2 1.8-2.2 3.3-2.2H21" />
              </svg>
            </button>

            <a
              class="np-preview"
              data-np-preview
              href={first.url}
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              <span class="np-preview-dot" aria-hidden="true"></span>
              {previewLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Spotify's preview player lives here; it is never shown. -->
  <div class="np-embed" aria-hidden="true">
    <div data-np-embed></div>
  </div>
  <audio class="np-audio" data-np-audio preload="metadata"></audio>
</aside>

<script
  type="application/json"
  data-np-data
  is:inline
  set:html={payloadJson}
></script>

<style>
  .now-playing {
    position: relative;
    display: block;
    min-width: 0;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    overscroll-behavior: contain;
  }

  .now-playing img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .np-stack {
    position: relative;
    isolation: isolate;
    /* Reserve room for the deepest card and keep transformed cards from
       extending the document's scrollable height. */
    padding-top: 3.5rem;
    contain: paint;
    touch-action: none;
  }

  .np-stage {
    position: relative;
    overflow: visible;
    clip-path: inset(-3.8rem 0 0 0);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .now-playing[data-np-moving="true"] .np-body,
  .now-playing[data-np-moving="true"] .np-peek-face {
    pointer-events: none;
  }

  .np-card.np-clone {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    border-radius: 1.05rem;
    will-change: transform, opacity, filter;
  }

  .np-peek-face {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    height: 3.1rem;
    padding: 0.3rem 0.85rem 0;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 1.05rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 7%,
      var(--color-background)
    );
    color: color-mix(in srgb, var(--color-foreground) 48%, transparent);
    font-family: inherit;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-peek-face[data-interactive="true"] {
    cursor: pointer;
    pointer-events: auto;
  }

  .np-peek-face[data-interactive="true"]:hover {
    border-color: color-mix(in srgb, var(--color-accent) 34%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    color: var(--color-accent);
  }

  .np-peek-face:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-peek-cover {
    display: block;
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 0.26rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .np-peek-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.63rem;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-peek-arrow {
    flex: none;
    margin-left: auto;
    font-size: 0.55rem;
    line-height: 1.2;
    opacity: 0.5;
  }

  .np-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: 0.95rem;
    min-height: 10.25rem;
    padding: 0.82rem;
    overflow: hidden;
    border: 0;
    border-radius: 1.05rem;
    background:
      radial-gradient(
        105% 130% at 92% -18%,
        color-mix(in srgb, var(--color-accent) 11%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
    box-shadow:
      0 8px 20px -20px
        color-mix(in srgb, var(--color-foreground) 38%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 6%, transparent);
    transform-origin: 50% 0%;
    will-change: transform, opacity, filter;
    transition: box-shadow 0.25s ease;
  }

  .np-card:hover {
    box-shadow:
      0 16px 34px -26px
        color-mix(in srgb, var(--color-foreground) 42%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 9%, transparent);
  }

  .np-art {
    position: relative;
    align-self: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 8%,
      var(--color-background)
    );
    box-shadow: 0 12px 24px -16px
      color-mix(in srgb, var(--color-foreground) 80%, transparent);
  }

  .np-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    transform: scale(1.09);
  }

  .np-art-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.16),
      transparent 42%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .np-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    pointer-events: auto;
  }

  .np-body[inert] {
    pointer-events: none;
  }

  .np-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .np-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-eq {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 2px;
    width: 0.62rem;
    height: 0.7rem;
  }

  .np-eq i {
    --i: 0;

    display: block;
    flex: 1;
    width: 1.5px;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }

  .now-playing[data-np-playing="true"] .np-eq i {
    animation: np-eq 1.05s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.17s);
  }

  .np-eq i:nth-child(1) {
    transform: scaleY(0.35);
  }

  .np-eq i:nth-child(2) {
    transform: scaleY(0.85);
  }

  .np-eq i:nth-child(3) {
    transform: scaleY(0.5);
  }

  .np-eq i:nth-child(4) {
    transform: scaleY(0.95);
  }

  @keyframes np-eq {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .np-head-right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
  }

  .np-count {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-foreground) 34%, transparent);
    white-space: nowrap;
  }

  .np-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-open:hover {
    color: var(--color-accent);
  }

  .np-open:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-open-icon {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0.85;
  }

  .np-open-arrow {
    font-size: 0.68rem;
    line-height: 1;
    opacity: 0.7;
  }

  .np-meta {
    min-width: 0;
    margin-top: 0.45rem;
  }

  .np-title {
    overflow: hidden;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-sub {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: 0.14rem;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    white-space: nowrap;
  }

  .np-album {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.8;
  }

  .np-dot {
    opacity: 0.5;
  }

  .np-enjoy {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 1.75rem;
    margin: 0.55rem 0 0;
    padding-left: 0.75rem;
    font-size: 0.74rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-foreground) 64%, transparent);
  }

  .np-enjoy::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 1.3rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-accent) 42%, transparent),
      transparent
    );
    content: "";
    transform: translateY(-50%);
  }

  .np-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .np-time {
    flex: none;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .np-seek {
    --np-p: 0%;

    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    height: 0.9rem;
    min-width: 0;
    cursor: pointer;
    touch-action: none;
  }

  .np-seek:focus-visible {
    border-radius: 999px;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-seek-rail {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    transition: height 0.18s ease;
  }

  .np-seek-fill {
    display: block;
    width: var(--np-p);
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
  }

  .np-seek-thumb {
    position: absolute;
    top: 50%;
    left: var(--np-p);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 16%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  .np-seek:hover .np-seek-rail,
  .np-seek[data-dragging="true"] .np-seek-rail {
    height: 3px;
  }

  .np-seek:hover .np-seek-thumb,
  .np-seek:focus-visible .np-seek-thumb,
  .np-seek[data-dragging="true"] .np-seek-thumb {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: 0.6rem;
  }

  .np-skip {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 44%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .np-skip:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .np-skip:focus-visible,
  .np-restart:focus-visible,
  .np-toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-skip svg {
    width: 0.82rem;
    height: 0.82rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-toggle {
    position: relative;
    display: inline-grid;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-accent);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .np-toggle:hover {
    color: color-mix(in srgb, var(--color-accent) 80%, #ffffff);
    transform: translateY(-1px);
  }

  .np-toggle:active {
    transform: translateY(0);
  }

  .np-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .np-icon-pause {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-play {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-pause {
    display: block;
  }

  .np-restart {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    margin-left: 0.15rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-restart:hover {
    color: var(--color-accent);
  }

  .np-restart svg {
    width: 0.82rem;
    height: 0.82rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-mode {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    margin-left: 0.15rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-mode:hover {
    color: var(--color-accent);
  }

  .np-mode:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-mode[data-mode="repeat"],
  .np-mode[data-mode="shuffle"] {
    color: var(--color-accent);
  }

  .np-mode svg {
    width: 0.92rem;
    height: 0.92rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-mode-icon {
    display: none;
  }

  .np-mode[data-mode="order"] .np-mode-icon--order,
  .np-mode[data-mode="repeat"] .np-mode-icon--repeat,
  .np-mode[data-mode="shuffle"] .np-mode-icon--shuffle {
    display: block;
  }

  .np-mode-one {
    font-family: inherit;
    font-size: 6.5px;
    font-weight: 700;
    stroke: none;
    fill: currentColor;
  }

  .np-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-preview[hidden] {
    display: none;
  }

  .np-preview:hover {
    color: var(--color-accent);
  }

  .np-preview:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-preview-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0.75;
  }

  /* Spotify's preview embed is used for audio only; it never paints the card. */
  .np-embed {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    clip-path: inset(50%);
  }

  .np-audio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .now-playing[data-np-loading="true"] .np-toggle {
    animation: np-pulse 1.4s ease-in-out infinite;
  }

  @keyframes np-pulse {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 28rem) {
    .np-card {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.8rem;
      min-height: 10.5rem;
    }

    .np-title {
      font-size: 0.96rem;
    }

    .np-count {
      display: none;
    }

    .np-enjoy {
      font-size: 0.66rem;
    }

    .np-skip {
      width: 1.4rem;
      height: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-card,
    .np-seek-rail,
    .np-seek-thumb,
    .np-toggle,
    .np-skip {
      transition: none;
    }

    .now-playing[data-np-playing="true"] .np-eq i {
      animation: none;
    }

    .now-playing[data-np-loading="true"] .np-toggle {
      animation: none;
    }
  }
</style>

<script>
  type LyricLine = { at: number; text: string };

  type MusicTrack = {
    title: string;
    artist: string;
    album: string;
    cover: string;
    url: string;
    src: string;
    isLocal: boolean;
    spotifyUri: string;
    duration: number;
    lyrics: LyricLine[];
  };

  type MusicLabels = {
    open: string;
    play: string;
    pause: string;
    restart: string;
    seek: string;
    preview: string;
    previous: string;
    next: string;
    mode: string;
    order: string;
    repeat: string;
    shuffle: string;
  };

  type MusicPayload = {
    tracks: MusicTrack[];
    labels: MusicLabels;
  };

  type SpotifyPlaybackData = {
    isPaused: boolean;
    isBuffering: boolean;
    duration: number;
    position: number;
  };

  type SpotifyEmbedController = {
    play: () => void;
    pause: () => void;
    resume: () => void;
    togglePlay: () => void;
    seek: (seconds: number) => void;
    addListener: (
      event: string,
      callback: (event: { data: SpotifyPlaybackData }) => void
    ) => void;
    destroy: () => void;
    loadUri?: (uri: string) => void;
  };

  type SpotifyIframeApi = {
    createController: (
      element: HTMLElement,
      options: {
        uri: string;
        width?: string | number;
        height?: string | number;
      },
      callback: (controller: SpotifyEmbedController) => void
    ) => void;
  };

  type SpotifyWindow = Window & {
    SpotifyIframeApi?: SpotifyIframeApi;
    onSpotifyIframeApiReady?: (api: SpotifyIframeApi) => void;
  };

  type MusicState = {
    index: number;
    count: number;
    title: string;
    artist: string;
    album: string;
    playing: boolean;
    current: number;
    duration: number;
    source: "local" | "spotify";
    isPreview: boolean;
    isLocal: boolean;
    lyrics: string[];
  };

  type BlogMusicApi = {
    tracks: {
      title: string;
      artist: string;
      album: string;
      duration: number;
      lyrics: string[];
      isLocal: boolean;
    }[];
    getState: () => MusicState;
    play: (index?: number) => void;
    pause: () => void;
    toggle: () => void;
    next: () => void;
    previous: () => void;
    seek: (seconds: number) => void;
  };

  declare global {
    interface Window {
      __blogMusic?: BlogMusicApi;
    }
  }

  let spotifyApi: SpotifyIframeApi | null = null;
  let apiPromise: Promise<SpotifyIframeApi> | null = null;
  let mediaKeysCleanup: AbortController | null = null;

  const loadSpotifyApi = (): Promise<SpotifyIframeApi> => {
    if (spotifyApi) return Promise.resolve(spotifyApi);
    if (apiPromise) return apiPromise;

    const w = window as SpotifyWindow;
    if (w.SpotifyIframeApi) {
      spotifyApi = w.SpotifyIframeApi;
      return Promise.resolve(spotifyApi);
    }

    apiPromise = new Promise<SpotifyIframeApi>((resolve, reject) => {
      const timeout = window.setTimeout(
        () => reject(new Error("Spotify embed API timed out")),
        12000
      );

      w.onSpotifyIframeApiReady = (embedApi: SpotifyIframeApi) => {
        window.clearTimeout(timeout);
        spotifyApi = embedApi;
        resolve(embedApi);
      };

      let script = document.getElementById(
        "spotify-iframe-api"
      ) as HTMLScriptElement | null;

      if (!script) {
        script = document.createElement("script");
        script.id = "spotify-iframe-api";
        script.src = "https://open.spotify.com/embed/iframe-api/v1";
        script.async = true;
        script.addEventListener("error", () => {
          window.clearTimeout(timeout);
          reject(new Error("Spotify embed API failed to load"));
        });
        document.head.appendChild(script);
      }
    });

    apiPromise.catch(() => {
      apiPromise = null;
    });

    return apiPromise;
  };

  const readData = (): MusicPayload | null => {
    const el = document.querySelector<HTMLScriptElement>("[data-np-data]");
    if (!el?.textContent) return null;

    try {
      return JSON.parse(el.textContent) as MusicPayload;
    } catch {
      return null;
    }
  };

  const formatTime = (ms: number) => {
    const total = Math.max(0, Math.round(ms / 1000));
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const initNowPlaying = () => {
    const root = document.querySelector<HTMLElement>("[data-np]");
    if (!root || root.dataset.npReady === "true") return;

    const data = readData();
    if (!data?.tracks.length) return;

    root.dataset.npReady = "true";

    const labels = data.labels;
    const tracks = data.tracks;
    const visibleCount = Math.min(tracks.length, 4);

    const stack = root.querySelector<HTMLElement>("[data-np-stack]");
    const stage = root.querySelector<HTMLElement>("[data-np-stage]");
    const serverCard = root.querySelector<HTMLElement>("[data-np-card]");
    const embedHost = root.querySelector<HTMLElement>("[data-np-embed]");
    const audio = root.querySelector<HTMLAudioElement>("[data-np-audio]");

    if (!stack || !stage || !serverCard || !embedHost || !audio) return;

    // One full card per track. Cloning the server card keeps the complete
    // markup in a single place while giving the deck four independent layers.
    const deckCards: HTMLElement[] = [serverCard];
    for (let i = 1; i < visibleCount; i++) {
      const clone = serverCard.cloneNode(true) as HTMLElement;
      clone.classList.add("np-clone");
      clone.removeAttribute("data-np-card");
      clone
        .querySelectorAll("[id]")
        .forEach(node => node.removeAttribute("id"));
      stage.appendChild(clone);
      deckCards.push(clone);
    }

    let activeCard = deckCards[0]!;
    let index = 0;

    const getBody = (card: HTMLElement) =>
      card.querySelector<HTMLElement>("[data-np-body]");
    const activeEl = <T extends Element>(selector: string) =>
      activeCard.querySelector<T>(selector);

    const setText = (card: HTMLElement, selector: string, value: string) => {
      const node = card.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    const applyCardContent = (
      card: HTMLElement,
      track: MusicTrack,
      trackIndex: number
    ) => {
      card.dataset.npTrackIndex = String(trackIndex);

      const coverEl = card.querySelector<HTMLImageElement>("[data-np-cover]");
      if (coverEl) coverEl.src = track.cover;
      setText(card, "[data-np-title]", track.title);
      setText(card, "[data-np-artist]", track.artist);
      setText(card, "[data-np-album]", track.album);
      setText(
        card,
        "[data-np-count]",
        `${String(trackIndex + 1).padStart(2, "0")} / ${String(
          tracks.length
        ).padStart(2, "0")}`
      );
      setText(card, "[data-np-total]", formatTime(track.duration * 1000));

      const link = card.querySelector<HTMLAnchorElement>("[data-np-link]");
      if (link) link.href = track.url;

      const preview =
        card.querySelector<HTMLAnchorElement>("[data-np-preview]");
      if (preview) {
        preview.href = track.url;
        preview.hidden = track.isLocal;
      }

      const peekFace = card.querySelector<HTMLButtonElement>(
        "[data-np-peek-face]"
      );
      if (peekFace) {
        peekFace.setAttribute("aria-label", `${track.title} — ${labels.next}`);
      }
      const peekCover = card.querySelector<HTMLImageElement>(
        "[data-np-peek-cover]"
      );
      if (peekCover) peekCover.src = track.cover;
      setText(card, "[data-np-peek-title]", track.title);
    };

    deckCards.forEach((card, trackIndex) => {
      applyCardContent(card, tracks[trackIndex]!, trackIndex);
    });

    const setActiveCard = (card: HTMLElement) => {
      activeCard = card;
      index = Number(card.dataset.npTrackIndex) || 0;

      deckCards.forEach(other => {
        const body = getBody(other);
        if (!body) return;
        const isActive = other === activeCard;
        body.toggleAttribute("inert", !isActive);
        if (isActive) body.removeAttribute("aria-hidden");
        else body.setAttribute("aria-hidden", "true");
      });
    };

    let source: "local" | "spotify" = "local";
    let isPlaying = false;
    let isDragging = false;
    let positionMs = 0;
    let durationMs = tracks[0]!.duration * 1000;
    let requestedPlay = false;
    let connecting = false;
    let spotifyController: SpotifyEmbedController | null = null;
    let spotifyUri = "";
    let localFailed = false;
    let endedHandled = false;
    let playMode: "order" | "repeat" | "shuffle" = "order";

    const nowPlayingLabel = root.getAttribute("aria-label") ?? "On repeat";

    const emitState = () => {
      window.dispatchEvent(
        new CustomEvent("blog-music:state", { detail: getState() })
      );
    };

    const setPlaying = (playing: boolean) => {
      isPlaying = playing;
      root.dataset.npPlaying = String(playing);
      root
        .querySelectorAll<HTMLButtonElement>("[data-np-toggle]")
        .forEach(toggle => {
          toggle.setAttribute("aria-pressed", String(playing));
          toggle.setAttribute(
            "aria-label",
            playing ? labels.pause : labels.play
          );
        });
      emitState();
    };

    const paintDuration = () => {
      const totalText = activeEl<HTMLElement>("[data-np-total]");
      const seek = activeEl<HTMLElement>("[data-np-seek]");
      if (totalText) totalText.textContent = formatTime(durationMs);
      if (seek) {
        seek.setAttribute(
          "aria-valuemax",
          String(Math.round(durationMs / 1000))
        );
      }
    };

    const paintProgress = (ms: number) => {
      const seek = activeEl<HTMLElement>("[data-np-seek]");
      const fill = activeEl<HTMLElement>("[data-np-fill]");
      const currentText = activeEl<HTMLElement>("[data-np-current]");
      if (!seek || !fill || !currentText) return;

      positionMs = clamp(ms, 0, Math.max(durationMs, 0));
      const ratio = durationMs > 0 ? positionMs / durationMs : 0;
      seek.style.setProperty("--np-p", `${ratio * 100}%`);
      seek.setAttribute("aria-valuenow", String(Math.round(positionMs / 1000)));
      seek.setAttribute("aria-valuetext", formatTime(positionMs));
      currentText.textContent = formatTime(positionMs);
    };

    const previewEl = () => activeEl<HTMLAnchorElement>("[data-np-preview]");
    const setPreviewHidden = (hidden: boolean) => {
      const preview = previewEl();
      if (preview) preview.hidden = hidden;
    };

    const stopLocalAudio = () => {
      audio.pause();
      audio.removeAttribute("src");
      audio.load();
    };

    const pauseSpotify = () => {
      spotifyController?.pause();
    };

    const connectSpotify = async (
      track: MusicTrack,
      autoplay: boolean
    ): Promise<SpotifyEmbedController | null> => {
      if (!track.spotifyUri) {
        root.dataset.npUnavailable = "true";
        return null;
      }

      if (spotifyController) {
        if (track.spotifyUri !== spotifyUri && spotifyController.loadUri) {
          spotifyController.pause();
          spotifyController.loadUri(track.spotifyUri);
          spotifyUri = track.spotifyUri;
          spotifyController.seek(0);
        }

        if (autoplay) {
          requestedPlay = true;
          spotifyController.play();
        }

        return spotifyController;
      }

      if (connecting) return null;
      connecting = true;
      root.dataset.npLoading = "true";

      try {
        const api = await loadSpotifyApi();

        await new Promise<void>((resolve, reject) => {
          const guard = window.setTimeout(
            () => reject(new Error("Spotify controller timed out")),
            12000
          );

          const host = document.createElement("div");
          embedHost.replaceChildren(host);

          api.createController(
            host,
            {
              uri: track.spotifyUri,
              width: "100%",
              height: 152,
            },
            embed => {
              window.clearTimeout(guard);
              spotifyController = embed;
              spotifyUri = track.spotifyUri;
              root.dataset.npLoading = "false";
              root.dataset.npUnavailable = "false";
              resolve();

              embed.addListener("playback_update", event => {
                const playback = event.data;
                if (playback.duration > 0) {
                  durationMs = playback.duration;
                  paintDuration();
                }

                if (typeof playback.position === "number" && !isDragging) {
                  paintProgress(playback.position);
                }

                setPlaying(!playback.isPaused);
                setPreviewHidden(false);
                root.dataset.npSource = "spotify";

                if (playback.duration > 0) {
                  if (playback.position >= playback.duration - 400) {
                    if (!endedHandled) {
                      endedHandled = true;
                      setPlaying(false);
                      advanceByMode();
                    }
                  } else if (playback.position < playback.duration - 1500) {
                    endedHandled = false;
                  }
                }
              });

              if (autoplay || requestedPlay) {
                requestedPlay = false;
                embed.play();
              }
            }
          );
        });
      } catch {
        root.dataset.npLoading = "false";
        root.dataset.npUnavailable = "true";
        setPreviewHidden(false);
      } finally {
        connecting = false;
      }

      return spotifyController;
    };

    const activateTrack = (autoplay: boolean) => {
      const track = tracks[index];
      if (!track) return;

      endedHandled = false;
      durationMs = track.duration * 1000;
      positionMs = 0;
      paintDuration();
      paintProgress(0);

      if (track.isLocal && !localFailed) {
        source = "local";
        pauseSpotify();
        audio.pause();
        audio.src = track.src;
        audio.currentTime = 0;
        audio.load();
        root.dataset.npSource = "local";
        setPreviewHidden(true);

        if (autoplay) {
          void audio.play().catch(() => {
            localFailed = true;
            source = "spotify";
            void connectSpotify(track, true);
          });
        }
        emitState();
        return;
      }

      source = "spotify";
      stopLocalAudio();
      setPreviewHidden(false);
      root.dataset.npSource = "spotify";
      if (autoplay) {
        requestedPlay = true;
        void connectSpotify(track, true);
      }
      emitState();
    };

    const pauseCurrent = () => {
      if (source === "local") audio.pause();
      else spotifyController?.pause();
    };

    const getCardHeight = () => serverCard.offsetHeight || 0;

    const syncStageHeight = () => {
      const height = getCardHeight();
      if (height > 0) stage.style.height = `${height}px`;
    };

    const unitRem = () =>
      Number.parseFloat(getComputedStyle(document.documentElement).fontSize) ||
      16;

    // Natural deck slots. Role 0 is the front; the other roles are the three
    // cards peeking above it, from nearest to deepest.
    let remSize = 16;
    const slotYRem = [0, -1.8, -2.9, -3.5];
    const slotScale = [1, 0.97, 0.94, 0.91];
    const slotOpacity = [1, 0.92, 0.74, 0.52];
    const slotBlur = [0, 0.12, 0.32, 0.6];
    const slotRotate = [0, -0.5, -1.05, -1.55];
    const slotZ = [4, 3, 2, 1];
    const lastRole = visibleCount - 1;

    const measureDeck = () => {
      remSize = unitRem();
      syncStageHeight();
    };

    const slotAt = (role: number) => {
      const i = Math.min(Math.max(role, 0), 3);
      return {
        y: slotYRem[i]! * remSize,
        scale: slotScale[i]!,
        opacity: slotOpacity[i]!,
        blur: slotBlur[i]!,
        rotate: slotRotate[i]!,
        z: slotZ[i]!,
      };
    };

    const clamp01 = (value: number) => Math.max(0, Math.min(1, value));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const smoothstep = (edge0: number, edge1: number, value: number) => {
      const t = clamp01((value - edge0) / (edge1 - edge0));
      return t * t * (3 - 2 * t);
    };

    const renderDeck = () => {
      const phase = deckOffset;
      const settled =
        !draggingDeck &&
        !springing &&
        Math.abs(deckTarget - deckOffset) < 0.001;

      deckCards.forEach((card, role) => {
        const from = role;
        let to = role;
        let t = 0;

        if (phase > 0.001) {
          t = clamp01(phase);
          to = role === 0 ? lastRole : role - 1;
        } else if (phase < -0.001) {
          t = clamp01(-phase);
          to = role === lastRole ? 0 : role + 1;
        }

        const a = slotAt(from);
        const b = slotAt(to);

        let y = lerp(a.y, b.y, t);
        // The outgoing front card first follows the finger down, then tucks
        // up into the back of the stack while it fades.
        if (phase > 0.001 && role === 0) {
          y += 2.4 * remSize * Math.sin(Math.PI * t);
        }

        const scale = lerp(a.scale, b.scale, t);
        const opacity = lerp(a.opacity, b.opacity, t);
        const blur = lerp(a.blur, b.blur, t);
        const rotate = lerp(a.rotate, b.rotate, t);

        // Keep the card that owns the gesture on top while it shrinks; only
        // hand the front z-index to the incoming card near the end. This
        // prevents the next card from flashing over it mid-gesture.
        let z: number;
        if (phase > 0.001) {
          if (role === 0) {
            z = 4 - 3 * smoothstep(0.55, 0.95, t);
          } else if (role === 1) {
            z = 3 + smoothstep(0.45, 0.9, t);
          } else {
            z = lerp(a.z, b.z, t);
          }
        } else if (phase < -0.001) {
          if (role === 0) {
            z = 4 - smoothstep(0.5, 0.9, t);
          } else if (role === lastRole) {
            z = 1 + 3 * smoothstep(0.4, 0.9, t);
          } else {
            z = lerp(a.z, b.z, t);
          }
        } else {
          z = a.z;
        }

        card.style.transform = `translate3d(0, ${y}px, 0) scale(${scale}) rotate(${rotate}deg)`;
        card.style.opacity = String(opacity);
        card.style.filter = blur > 0.01 ? `blur(${blur}px)` : "none";
        card.style.zIndex = String(Math.round(z));

        const face = card.querySelector<HTMLButtonElement>(
          "[data-np-peek-face]"
        );
        if (face) {
          // The peek face belongs to the back of the card. It is only
          // removed as that card actually reaches the front layer, so tiny
          // drags, snap-backs and direction changes never flash content.
          const faceOpacity = 1 - smoothstep(3.15, 3.9, z);
          face.style.opacity = String(clamp01(faceOpacity));
          const interactive = settled && (role === 1 || role === 2);
          face.dataset.interactive = String(interactive);
          face.toggleAttribute("inert", !interactive);
          face.tabIndex = interactive ? 0 : -1;
        }
      });

      root.dataset.npMoving = String(!settled);
    };

    let deckOffset = 0;
    let deckTarget = 0;
    let deckFrame = 0;
    let deckVelocity = 0;
    let springing = false;
    let resumeAfterCommit = false;

    let draggingDeck = false;
    let dragPointerId = -1;
    let dragStartY = 0;
    let dragStartOffset = 0;
    let dragLastRaw = 0;
    let dragLastTime = 0;
    let dragVelocity = 0;

    let wheelAccum = 0;
    let wheelTimer = 0;
    let wheelLocked = false;
    let wheelUnlockTimer = 0;

    const pendingMoves: Array<{
      direction: 1 | -1;
      autoplay: boolean;
    }> = [];

    const clampDrag = (value: number) => Math.max(-1, Math.min(1, value));

    const startDeck = () => {
      if (!deckFrame) deckFrame = requestAnimationFrame(deckTick);
    };

    const commitIfNeeded = () => {
      let moved = 0;

      while (deckOffset >= 1) {
        deckCards.push(deckCards.shift()!);
        deckOffset -= 1;
        deckTarget -= 1;
        moved += 1;
      }

      while (deckOffset <= -1) {
        deckCards.unshift(deckCards.pop()!);
        deckOffset += 1;
        deckTarget += 1;
        moved -= 1;
      }

      if (!moved) return false;

      deckOffset = 0;
      deckTarget = 0;
      deckVelocity = 0;
      springing = false;

      setActiveCard(deckCards[0]!);
      const autoplay = resumeAfterCommit;
      resumeAfterCommit = false;
      if (!autoplay) pauseCurrent();
      localFailed = false;
      activateTrack(autoplay);
      syncStageHeight();
      return true;
    };

    const deckTick = () => {
      if (draggingDeck) {
        const diff = deckTarget - deckOffset;
        deckOffset += diff * 0.3;
        if (Math.abs(diff) < 0.001) deckOffset = deckTarget;
      } else if (springing) {
        deckVelocity = (deckVelocity + (deckTarget - deckOffset) * 0.16) * 0.78;
        deckOffset += deckVelocity;

        if (deckTarget !== 0) {
          if (
            (deckTarget > 0 && deckOffset >= deckTarget) ||
            (deckTarget < 0 && deckOffset <= deckTarget)
          ) {
            deckOffset = deckTarget;
            commitIfNeeded();
          }
        } else if (
          Math.abs(deckOffset) < 0.004 &&
          Math.abs(deckVelocity) < 0.003
        ) {
          deckOffset = 0;
          deckVelocity = 0;
          springing = false;
        }
      } else {
        const diff = deckTarget - deckOffset;
        deckOffset += diff * 0.26;
        if (Math.abs(diff) < 0.001) deckOffset = deckTarget;
        if (deckOffset >= 1 || deckOffset <= -1) commitIfNeeded();
      }

      renderDeck();

      const moving =
        draggingDeck || springing || Math.abs(deckTarget - deckOffset) > 0.0005;

      if (moving) {
        deckFrame = requestAnimationFrame(deckTick);
      } else {
        deckFrame = 0;
        if (pendingMoves.length) {
          const next = pendingMoves.shift()!;
          slideToTrack(next.direction, next.autoplay);
        }
      }
    };

    const slideToTrack = (direction: 1 | -1, autoplay = false) => {
      if (visibleCount < 2) return;
      resumeAfterCommit = autoplay;
      if (!autoplay) pauseCurrent();
      springing = false;
      deckVelocity = 0;
      const base = Math.round(deckOffset);
      deckTarget = clampDrag(base + direction);
      startDeck();
    };

    const requestMove = (direction: 1 | -1, autoplay = false) => {
      const busy =
        draggingDeck || springing || Math.abs(deckTarget - deckOffset) > 0.0005;

      if (busy) {
        if (pendingMoves.length < 6) {
          pendingMoves.push({ direction, autoplay });
        }
        return;
      }

      slideToTrack(direction, autoplay);
    };

    const jumpToTrack = (targetIndex: number, autoplay: boolean) => {
      const target = deckCards.find(
        card => Number(card.dataset.npTrackIndex) === targetIndex
      );
      if (!target) return;

      const position = deckCards.indexOf(target);
      if (position > 0) {
        deckCards.push(...deckCards.splice(0, position));
      }

      deckOffset = 0;
      deckTarget = 0;
      deckVelocity = 0;
      springing = false;
      draggingDeck = false;
      dragPointerId = -1;
      pendingMoves.length = 0;
      setActiveCard(deckCards[0]!);
      renderDeck();
      activateTrack(autoplay);
    };

    const nextTrack = (forceAutoplay?: boolean) => {
      requestMove(1, forceAutoplay ?? isPlaying);
    };

    const previousTrack = () => {
      const elapsed = positionMs / 1000;
      if (elapsed > 3) {
        seekToSeconds(0);
        return;
      }
      requestMove(-1, isPlaying);
    };

    const advanceByMode = () => {
      if (playMode === "repeat") {
        seekToSeconds(0);
        if (source === "local") {
          void audio.play().catch(() => {});
        } else {
          spotifyController?.play();
        }
        endedHandled = false;
        return;
      }

      if (playMode === "shuffle" && tracks.length > 1) {
        let target = index;
        while (target === index) {
          target = Math.floor(Math.random() * tracks.length);
        }
        jumpToTrack(target, true);
        return;
      }

      requestMove(1, true);
    };

    const setMode = (mode: "order" | "repeat" | "shuffle") => {
      playMode = mode;
      root
        .querySelectorAll<HTMLButtonElement>("[data-np-mode]")
        .forEach(button => {
          button.dataset.mode = mode;
          const label =
            mode === "repeat"
              ? labels.repeat
              : mode === "shuffle"
                ? labels.shuffle
                : labels.order;
          button.setAttribute("aria-label", `${labels.mode}: ${label}`);
        });
    };

    const togglePlayback = () => {
      if (source === "local") {
        if (audio.paused) {
          void audio.play().catch(() => {
            localFailed = true;
            const track = tracks[index];
            if (track) {
              source = "spotify";
              setPreviewHidden(false);
              void connectSpotify(track, true);
            }
          });
        } else {
          audio.pause();
        }
        return;
      }

      if (spotifyController) {
        spotifyController.togglePlay();
        return;
      }

      const track = tracks[index];
      if (track) {
        requestedPlay = true;
        void connectSpotify(track, true);
      }
    };

    const seekToSeconds = (seconds: number) => {
      const ms = clamp(seconds * 1000, 0, durationMs);
      paintProgress(ms);

      if (source === "local") {
        if (Number.isFinite(audio.duration)) {
          audio.currentTime = Math.min(seconds, audio.duration);
        }
        return;
      }

      spotifyController?.seek(seconds);
    };

    const seekToRatio = (ratio: number) => {
      seekToSeconds((ratio * durationMs) / 1000);
    };

    const ratioFromPointer = (event: PointerEvent, seek: HTMLElement) => {
      const rect = seek.getBoundingClientRect();
      if (!rect.width) return 0;
      return clamp((event.clientX - rect.left) / rect.width, 0, 1);
    };

    const getState = (): MusicState => {
      const track = tracks[index]!;
      return {
        index,
        count: tracks.length,
        title: track.title,
        artist: track.artist,
        album: track.album,
        playing: isPlaying,
        current: positionMs / 1000,
        duration: durationMs / 1000,
        source,
        isPreview: source === "spotify",
        isLocal: source === "local",
        lyrics: track.lyrics.map(line => line.text),
      };
    };

    // ── Local audio events ────────────────────────────────────────
    audio.addEventListener("play", () => setPlaying(true));
    audio.addEventListener("pause", () => setPlaying(false));
    audio.addEventListener("ended", () => {
      setPlaying(false);
      advanceByMode();
    });
    audio.addEventListener("loadedmetadata", () => {
      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        durationMs = audio.duration * 1000;
        paintDuration();
      }
    });
    audio.addEventListener("timeupdate", () => {
      if (!isDragging) paintProgress(audio.currentTime * 1000);
    });
    audio.addEventListener("error", () => {
      if (source !== "local") return;
      localFailed = true;
      source = "spotify";
      setPreviewHidden(false);
      const track = tracks[index];
      if (track) void connectSpotify(track, isPlaying);
    });

    const canStartDeckDrag = (target: EventTarget | null) =>
      !(target instanceof Element) ||
      !target.closest("button, a, input, [role='slider'], [role='button']");

    stack.addEventListener("pointerdown", event => {
      if (event.button !== 0 || !canStartDeckDrag(event.target)) return;
      if (visibleCount < 2) return;

      event.preventDefault();
      draggingDeck = true;
      springing = false;
      deckVelocity = 0;
      pendingMoves.length = 0;
      dragPointerId = event.pointerId;
      dragStartY = event.clientY;
      dragStartOffset = deckOffset;
      dragLastRaw = deckOffset;
      dragLastTime = performance.now();
      dragVelocity = 0;
      deckTarget = deckOffset;

      try {
        stack.setPointerCapture?.(event.pointerId);
      } catch {
        /* pointer may already be gone on very fast taps */
      }
      startDeck();
    });

    stack.addEventListener("pointermove", event => {
      if (!draggingDeck || event.pointerId !== dragPointerId) return;

      const height = getCardHeight();
      if (!height) return;

      const now = performance.now();
      const dt = Math.max(8, now - dragLastTime);
      const raw = dragStartOffset + (event.clientY - dragStartY) / height;

      dragVelocity = (raw - dragLastRaw) / dt;
      dragLastRaw = raw;
      dragLastTime = now;

      deckTarget = clampDrag(raw);
      startDeck();
    });

    const endDeckDrag = (event: PointerEvent) => {
      if (!draggingDeck || event.pointerId !== dragPointerId) return;
      draggingDeck = false;
      dragPointerId = -1;

      try {
        if (stack.hasPointerCapture?.(event.pointerId)) {
          stack.releasePointerCapture(event.pointerId);
        }
      } catch {
        /* capture may have been released by the browser */
      }

      if (performance.now() - dragLastTime > 90) dragVelocity = 0;
      const projected = deckOffset + dragVelocity * 200;
      let target = 0;
      if (projected > 0.5) target = 1;
      else if (projected < -0.5) target = -1;

      resumeAfterCommit = false;
      deckTarget = target;
      deckVelocity = Math.max(-0.16, Math.min(0.16, dragVelocity * 18));
      springing = true;
      startDeck();
    };

    stack.addEventListener("pointerup", endDeckDrag);
    stack.addEventListener("pointercancel", endDeckDrag);

    root.addEventListener(
      "wheel",
      event => {
        event.preventDefault();
        if (visibleCount < 2) return;

        if (wheelLocked) {
          window.clearTimeout(wheelUnlockTimer);
          wheelUnlockTimer = window.setTimeout(() => {
            wheelLocked = false;
            wheelAccum = 0;
          }, 220);
          return;
        }

        wheelAccum += event.deltaY;
        window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          if (Math.abs(wheelAccum) >= 24) {
            requestMove(wheelAccum > 0 ? 1 : -1, false);
          }
          wheelAccum = 0;
          wheelLocked = true;
          wheelUnlockTimer = window.setTimeout(() => {
            wheelLocked = false;
          }, 220);
        }, 90);
      },
      { passive: false }
    );

    // ── Per-card controls ─────────────────────────────────────────
    const wireCard = (card: HTMLElement) => {
      const body = getBody(card);
      if (!body) return;

      const toggle = body.querySelector<HTMLButtonElement>("[data-np-toggle]");
      const prevButton =
        body.querySelector<HTMLButtonElement>("[data-np-prev]");
      const nextButton =
        body.querySelector<HTMLButtonElement>("[data-np-next]");
      const restartButton =
        body.querySelector<HTMLButtonElement>("[data-np-restart]");
      const modeButton =
        body.querySelector<HTMLButtonElement>("[data-np-mode]");
      const seek = body.querySelector<HTMLElement>("[data-np-seek]");
      const face = card.querySelector<HTMLButtonElement>("[data-np-peek-face]");

      toggle?.addEventListener("click", () => {
        if (card !== activeCard) return;
        togglePlayback();
      });
      prevButton?.addEventListener("click", () => {
        if (card !== activeCard) return;
        previousTrack();
      });
      nextButton?.addEventListener("click", () => {
        if (card !== activeCard) return;
        nextTrack();
      });
      restartButton?.addEventListener("click", () => {
        if (card !== activeCard) return;
        seekToSeconds(0);
        if (source === "local") {
          void audio.play().catch(() => {});
        } else {
          spotifyController?.play();
        }
      });
      modeButton?.addEventListener("click", () => {
        if (card !== activeCard) return;
        const order = ["order", "repeat", "shuffle"] as const;
        const next = order[(order.indexOf(playMode) + 1) % order.length]!;
        setMode(next);
      });

      if (seek) {
        seek.addEventListener("pointerdown", event => {
          if (card !== activeCard) return;
          isDragging = true;
          seek.dataset.dragging = "true";
          seek.setPointerCapture?.(event.pointerId);
          paintProgress(ratioFromPointer(event, seek) * durationMs);
        });

        seek.addEventListener("pointermove", event => {
          if (card !== activeCard || !isDragging) return;
          paintProgress(ratioFromPointer(event, seek) * durationMs);
        });

        const endSeek = (event: PointerEvent) => {
          if (card !== activeCard || !isDragging) return;
          isDragging = false;
          delete seek.dataset.dragging;
          seekToRatio(ratioFromPointer(event, seek));

          if (seek.hasPointerCapture?.(event.pointerId)) {
            seek.releasePointerCapture(event.pointerId);
          }
        };

        seek.addEventListener("pointerup", endSeek);
        seek.addEventListener("pointercancel", endSeek);
        seek.addEventListener("keydown", event => {
          if (card !== activeCard) return;
          let next = positionMs / 1000;
          if (event.key === "ArrowRight") next += 5;
          else if (event.key === "ArrowLeft") next -= 5;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = durationMs / 1000;
          else return;

          event.preventDefault();
          seekToSeconds(next);
        });
      }

      face?.addEventListener("click", () => {
        if (card === activeCard || !face.dataset.interactive) return;
        const role = deckCards.indexOf(card);
        if (role === 1) {
          requestMove(1, false);
        } else if (role === 2) {
          requestMove(1, false);
          requestMove(1, false);
        }
      });
    };

    deckCards.forEach(wireCard);

    // ── Media keyboard shortcuts ──────────────────────────────────
    if (mediaKeysCleanup) mediaKeysCleanup.abort();
    mediaKeysCleanup = new AbortController();

    const isTypingTarget = (target: EventTarget | null) =>
      target instanceof HTMLElement &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.tagName === "SELECT" ||
        target.isContentEditable);

    const hasBlockingOverlay = () => {
      const terminal = document.querySelector<HTMLElement>("[data-terminal]");
      if (terminal && !terminal.hidden) return true;
      const search = document.getElementById("search-modal");
      if (search && search.classList.contains("active")) return true;
      const shortcuts = document.querySelector<HTMLElement>("[data-shortcuts]");
      if (shortcuts && !shortcuts.hidden) return true;
      return false;
    };

    document.addEventListener(
      "keydown",
      event => {
        if (event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        if (isTypingTarget(event.target) || hasBlockingOverlay()) return;

        if (event.key.toLowerCase() === "k") {
          event.preventDefault();
          togglePlayback();
          return;
        }

        if (event.shiftKey && event.key === "ArrowLeft") {
          event.preventDefault();
          previousTrack();
          return;
        }

        if (event.shiftKey && event.key === "ArrowRight") {
          event.preventDefault();
          nextTrack();
        }
      },
      { signal: mediaKeysCleanup.signal }
    );

    // ── Initialise ────────────────────────────────────────────────
    setActiveCard(deckCards[0]!);
    setMode("order");
    activateTrack(false);
    paintDuration();
    paintProgress(0);
    syncStageHeight();
    measureDeck();
    renderDeck();

    if ("ResizeObserver" in window) {
      const stageObserver = new ResizeObserver(() => {
        measureDeck();
        renderDeck();
      });
      stageObserver.observe(serverCard);
    }

    // Warm up Spotify only when the card enters the viewport.
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          const track = tracks[index];
          if (track && !track.isLocal) void connectSpotify(track, false);
        },
        { rootMargin: "240px 0px" }
      );
      observer.observe(root);
    }

    // ── Public API used by the hero terminal ──────────────────────
    window.__blogMusic = {
      tracks: tracks.map(track => ({
        title: track.title,
        artist: track.artist,
        album: track.album,
        duration: track.duration,
        lyrics: track.lyrics.map(line => line.text),
        isLocal: track.isLocal,
      })),
      getState,
      play: (nextIndex?: number) => {
        if (typeof nextIndex === "number" && tracks[nextIndex]) {
          const wasPlaying = isPlaying;
          jumpToTrack(nextIndex, wasPlaying);
          if (!wasPlaying) togglePlayback();
          return;
        }

        if (!isPlaying) togglePlayback();
      },
      pause: () => {
        if (source === "local") audio.pause();
        else spotifyController?.pause();
      },
      toggle: togglePlayback,
      next: nextTrack,
      previous: previousTrack,
      seek: seekToSeconds,
    };

    emitState();
    void nowPlayingLabel;
  };

  document.addEventListener("astro:page-load", initNowPlaying);
  initNowPlaying();
</script>
