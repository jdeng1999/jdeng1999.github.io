---
/**
 * NowPlaying — a custom, theme-aware music card for the footer.
 *
 * Playback order:
 *   1. A local audio file (`public/audio/...`) gives every visitor the full
 *      track, with no login and no 30-second preview limit.
 *   2. If that file is missing, the card falls back to Spotify's official
 *      iFrame API (which streams a 30s preview to anonymous visitors).
 *
 * The card also shows the current track's two-line lyric excerpt: the first
 * line is crisp, the second dissolves downward with a mask.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import IconSpotify from "@/assets/icons/IconSpotify.svg";
import { SITE } from "@/config";

interface Props {
  label?: string;
  openLabel?: string;
  playLabel?: string;
  pauseLabel?: string;
  restartLabel?: string;
  seekLabel?: string;
  previewLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  class?: string;
}

const {
  label = "On repeat",
  openLabel = "Open in Spotify",
  playLabel = "Play",
  pauseLabel = "Pause",
  restartLabel = "Restart",
  seekLabel = "Seek",
  previewLabel = "Preview",
  previousLabel = "Previous track",
  nextLabel = "Next track",
  class: className = "",
} = Astro.props;

const formatTime = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

const tracks = SITE.spotify.tracks.map(track => {
  const src = track.src ?? "";
  const isRemote = /^https?:\/\//i.test(src);
  const localPath =
    src.startsWith("/") && !isRemote
      ? fileURLToPath(new URL(`../../public${src}`, import.meta.url))
      : "";
  const isLocal =
    Boolean(src) && (isRemote || (localPath && existsSync(localPath)));
  const match = track.url.match(/track\/([A-Za-z0-9]+)/);

  return {
    title: track.title,
    artist: track.artist,
    album: track.album,
    cover: track.cover,
    url: track.url,
    src,
    isLocal: Boolean(isLocal),
    spotifyUri: match ? `spotify:track:${match[1]}` : "",
    duration: track.duration,
    lyrics: [...track.lyrics],
  };
});

const first = tracks[0];
if (!first) {
  throw new Error(
    "NowPlaying requires at least one track in SITE.spotify.tracks"
  );
}

const payload = {
  tracks,
  labels: {
    open: openLabel,
    play: playLabel,
    pause: pauseLabel,
    restart: restartLabel,
    seek: seekLabel,
    preview: previewLabel,
    previous: previousLabel,
    next: nextLabel,
  },
};

const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");
const totalLabel = formatTime(first.duration);
---

<aside
  class:list={["now-playing", className]}
  aria-label={label}
  data-np
  data-np-playing="false"
>
  <div class="np-stack">
    {tracks.length > 1 && (
      <button
        type="button"
        class="np-peek"
        data-np-peek
        aria-label={`${nextLabel}: ${tracks[1]!.title}`}
        title={tracks[1]!.title}
      >
        <img
          class="np-peek-cover"
          data-np-peek-cover
          src={tracks[1]!.cover}
          alt=""
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
        <span class="np-peek-title" data-np-peek-title>
          {tracks[1]!.title}
        </span>
        <span class="np-peek-arrow" aria-hidden="true">
          ↗
        </span>
      </button>
    )}

    <div class="np-card">
      <span class="np-ambient" aria-hidden="true">
        <img data-np-ambient src={first.cover} alt="" width="96" height="96" />
      </span>

      <div class="np-art">
        <img
          data-np-cover
          src={first.cover}
          alt=""
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
        <span class="np-art-sheen" aria-hidden="true"></span>
      </div>

      <div class="np-body">
        <div class="np-head">
          <p class="np-eyebrow">
            <span class="np-eq" aria-hidden="true">
              {Array.from({ length: 4 }).map((_, index) => (
                <i style={`--i: ${index}`} />
              ))}
            </span>
            <span>{label}</span>
          </p>

          <div class="np-head-right">
            <span class="np-count" data-np-count>
              01 / {String(tracks.length).padStart(2, "0")}
            </span>
            <a
              class="np-open"
              data-np-link
              href={first.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={openLabel}
              title={openLabel}
            >
              <IconSpotify class="np-open-icon" />
              <span>Spotify</span>
              <span class="np-open-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </div>
        </div>

        <div class="np-meta">
          <p class="np-title" data-np-title title={first.title}>
            {first.title}
          </p>
          <p class="np-sub">
            <span data-np-artist>{first.artist}</span>
            <span class="np-dot" aria-hidden="true">
              ·
            </span>
            <span class="np-album" data-np-album>
              {first.album}
            </span>
          </p>
        </div>

        <div class="np-lyrics" data-np-lyrics aria-live="polite">
          <p class="np-lyric np-lyric-current" data-np-lyric-current>
            {first.lyrics[0] ?? ""}
          </p>
          <p class="np-lyric np-lyric-next" data-np-lyric-next>
            {first.lyrics[1] ?? ""}
          </p>
        </div>

        <div class="np-progress">
          <span class="np-time" data-np-current>
            0:00
          </span>
          <div
            class="np-seek"
            data-np-seek
            role="slider"
            tabindex="0"
            aria-label={seekLabel}
            aria-valuemin="0"
            aria-valuemax={String(first.duration)}
            aria-valuenow="0"
            aria-valuetext="0:00"
          >
            <span class="np-seek-rail">
              <span class="np-seek-fill" data-np-fill></span>
            </span>
            <span class="np-seek-thumb" aria-hidden="true"></span>
          </div>
          <span class="np-time" data-np-total>
            {totalLabel}
          </span>
        </div>

        <div class="np-controls">
          <button
            type="button"
            class="np-skip"
            data-np-prev
            aria-label={previousLabel}
            title={previousLabel}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.5 5.5v13l-9-6.5 9-6.5Z" />
              <path d="M6.5 5.5v13" />
            </svg>
          </button>

          <button
            type="button"
            class="np-toggle"
            data-np-toggle
            aria-label={playLabel}
            aria-pressed="false"
          >
            <svg
              class="np-icon np-icon-play"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
            </svg>
            <svg
              class="np-icon np-icon-pause"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8.25 4.5h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Zm5 0h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Z" />
            </svg>
            <span class="np-toggle-ring" aria-hidden="true"></span>
          </button>

          <button
            type="button"
            class="np-skip"
            data-np-next
            aria-label={nextLabel}
            title={nextLabel}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5.5 5.5v13l9-6.5-9-6.5Z" />
              <path d="M17.5 5.5v13" />
            </svg>
          </button>

          <button
            type="button"
            class="np-restart"
            data-np-restart
            aria-label={restartLabel}
            title={restartLabel}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.5 5.25v4.5h4.5" />
              <path d="M4.78 9.5a8 8 0 1 1 .3 5.6" />
            </svg>
          </button>

          <a
            class="np-preview"
            data-np-preview
            href={first.url}
            target="_blank"
            rel="noopener noreferrer"
            title={openLabel}
            hidden
          >
            <span class="np-preview-dot" aria-hidden="true"></span>
            {previewLabel}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Spotify's preview player lives here; it is never shown. -->
  <div class="np-embed" aria-hidden="true">
    <div data-np-embed></div>
  </div>
  <audio class="np-audio" data-np-audio preload="metadata"></audio>
</aside>

<script
  type="application/json"
  data-np-data
  is:inline
  set:html={payloadJson}
></script>

<style>
  .now-playing {
    position: relative;
    display: block;
    min-width: 0;
  }

  .np-stack {
    position: relative;
    padding-top: 1.6rem;
  }

  .np-peek {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0.55rem;
    left: 0.55rem;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    height: 2.9rem;
    padding: 0.3rem 0.85rem 0;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 11%, transparent);
    border-radius: 1.1rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 7%,
      var(--color-background)
    );
    color: color-mix(in srgb, var(--color-foreground) 48%, transparent);
    font-family: inherit;
    text-align: left;
    transform: rotate(-1deg);
    transform-origin: 50% 100%;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-peek:hover {
    border-color: color-mix(in srgb, var(--color-accent) 34%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    color: var(--color-accent);
    transform: rotate(0deg) translateY(-3px);
  }

  .np-peek:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-peek-cover {
    display: block;
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 0.26rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .np-peek-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.63rem;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-peek-arrow {
    flex: none;
    margin-left: auto;
    font-size: 0.55rem;
    line-height: 1.2;
    opacity: 0.5;
  }

  .np-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 11rem;
    padding: 0.9rem;
    border: 0;
    border-radius: 1.15rem;
    background:
      radial-gradient(
        105% 130% at 92% -18%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-foreground) 4.5%, var(--color-background));
    box-shadow:
      0 22px 44px -34px
        color-mix(in srgb, var(--color-foreground) 70%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 7%, transparent);
    transition:
      box-shadow 0.35s ease,
      background-color 0.35s ease;
  }

  /* Blurred cover glow that sits behind the card */
  .np-ambient {
    position: absolute;
    z-index: -1;
    inset: -14% -5% -22%;
    overflow: hidden;
    border-radius: 2rem;
    opacity: 0.32;
    filter: blur(34px) saturate(1.35);
    transform: translateZ(0);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 20%,
      rgba(0, 0, 0, 0.5) 60%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 20%,
      rgba(0, 0, 0, 0.5) 60%,
      transparent 100%
    );
    pointer-events: none;
  }

  .np-ambient img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }

  /* Hairline gradient border */
  .np-card::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent) 55%, transparent),
      color-mix(in srgb, var(--color-foreground) 6%, transparent) 38%,
      transparent 62%,
      color-mix(in srgb, var(--color-accent) 22%, transparent)
    );
    content: "";
    pointer-events: none;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .np-card:hover {
    box-shadow:
      0 26px 50px -32px
        color-mix(in srgb, var(--color-foreground) 62%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 9%, transparent);
  }

  .np-art {
    position: relative;
    align-self: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 8%,
      var(--color-background)
    );
    box-shadow: 0 12px 24px -16px
      color-mix(in srgb, var(--color-foreground) 80%, transparent);
  }

  .np-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }

  .np-art-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.16),
      transparent 42%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .np-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .np-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .np-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-eq {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 2px;
    width: 0.62rem;
    height: 0.7rem;
  }

  .np-eq i {
    --i: 0;

    display: block;
    flex: 1;
    width: 1.5px;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }

  .now-playing[data-np-playing="true"] .np-eq i {
    animation: np-eq 1.05s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.17s);
  }

  .np-eq i:nth-child(1) {
    transform: scaleY(0.35);
  }

  .np-eq i:nth-child(2) {
    transform: scaleY(0.85);
  }

  .np-eq i:nth-child(3) {
    transform: scaleY(0.5);
  }

  .np-eq i:nth-child(4) {
    transform: scaleY(0.95);
  }

  @keyframes np-eq {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .np-head-right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
  }

  .np-count {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-foreground) 34%, transparent);
    white-space: nowrap;
  }

  .np-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-open:hover {
    color: var(--color-accent);
  }

  .np-open:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-open-icon {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0.85;
  }

  .np-open-arrow {
    font-size: 0.68rem;
    line-height: 1;
    opacity: 0.7;
  }

  .np-meta {
    min-width: 0;
    margin-top: 0.45rem;
  }

  .np-title {
    overflow: hidden;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-sub {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: 0.14rem;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    white-space: nowrap;
  }

  .np-album {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.8;
  }

  .np-dot {
    opacity: 0.5;
  }

  .np-lyrics {
    position: relative;
    min-width: 0;
    margin-top: 0.65rem;
    padding-left: 0.75rem;
  }

  .np-lyrics::before {
    position: absolute;
    top: 0.05rem;
    left: 0;
    width: 1px;
    height: 2.4rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-accent) 38%, transparent),
      transparent
    );
    content: "";
  }

  .np-lyric {
    overflow: hidden;
    margin: 0;
    font-family:
      "Noto Serif SC", "Songti SC", "Noto Serif CJK SC", "SimSun",
      var(--font-app), serif;
    font-size: 0.72rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-lyric-current {
    color: color-mix(in srgb, var(--color-foreground) 76%, transparent);
  }

  .np-lyric-next {
    margin-top: 0.08rem;
    color: color-mix(in srgb, var(--color-foreground) 58%, transparent);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.55) 55%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.55) 55%,
      transparent 100%
    );
  }

  .np-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .np-time {
    flex: none;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .np-seek {
    --np-p: 0%;

    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    height: 0.9rem;
    min-width: 0;
    cursor: pointer;
    touch-action: none;
  }

  .np-seek:focus-visible {
    border-radius: 999px;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-seek-rail {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    transition: height 0.18s ease;
  }

  .np-seek-fill {
    display: block;
    width: var(--np-p);
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
  }

  .np-seek-thumb {
    position: absolute;
    top: 50%;
    left: var(--np-p);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 16%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  .np-seek:hover .np-seek-rail,
  .np-seek[data-dragging="true"] .np-seek-rail {
    height: 3px;
  }

  .np-seek:hover .np-seek-thumb,
  .np-seek:focus-visible .np-seek-thumb,
  .np-seek[data-dragging="true"] .np-seek-thumb {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.6rem;
  }

  .np-skip {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 44%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .np-skip:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .np-skip:focus-visible,
  .np-restart:focus-visible,
  .np-toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-skip svg {
    width: 0.82rem;
    height: 0.82rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-toggle {
    position: relative;
    display: inline-grid;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .np-toggle:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    box-shadow: 0 6px 16px -8px
      color-mix(in srgb, var(--color-accent) 65%, transparent);
    transform: translateY(-1px);
  }

  .np-toggle:active {
    transform: translateY(0);
  }

  .np-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .np-icon-pause {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-play {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-pause {
    display: block;
  }

  .np-toggle-ring {
    position: absolute;
    inset: -0.22rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.86);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    pointer-events: none;
  }

  .np-toggle:hover .np-toggle-ring {
    opacity: 1;
    transform: scale(1);
  }

  .np-restart {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    margin-left: 0.15rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-restart:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .np-restart svg {
    width: 0.82rem;
    height: 0.82rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-preview[hidden] {
    display: none;
  }

  .np-preview:hover {
    color: var(--color-accent);
  }

  .np-preview:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-preview-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0.75;
  }

  /* Spotify's preview embed is used for audio only; it never paints the card. */
  .np-embed {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    clip-path: inset(50%);
  }

  .np-audio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .now-playing[data-np-loading="true"] .np-toggle {
    animation: np-pulse 1.4s ease-in-out infinite;
  }

  @keyframes np-pulse {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 28rem) {
    .np-card {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.8rem;
      min-height: 10.5rem;
    }

    .np-title {
      font-size: 0.96rem;
    }

    .np-count {
      display: none;
    }

    .np-lyric {
      font-size: 0.63rem;
    }

    .np-skip {
      width: 1.4rem;
      height: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-card,
    .np-seek-rail,
    .np-seek-thumb,
    .np-toggle,
    .np-toggle-ring,
    .np-skip {
      transition: none;
    }

    .now-playing[data-np-playing="true"] .np-eq i {
      animation: none;
    }

    .now-playing[data-np-loading="true"] .np-toggle {
      animation: none;
    }
  }
</style>

<script>
  type MusicTrack = {
    title: string;
    artist: string;
    album: string;
    cover: string;
    url: string;
    src: string;
    isLocal: boolean;
    spotifyUri: string;
    duration: number;
    lyrics: string[];
  };

  type MusicLabels = {
    open: string;
    play: string;
    pause: string;
    restart: string;
    seek: string;
    preview: string;
    previous: string;
    next: string;
  };

  type MusicPayload = {
    tracks: MusicTrack[];
    labels: MusicLabels;
  };

  type SpotifyPlaybackData = {
    isPaused: boolean;
    isBuffering: boolean;
    duration: number;
    position: number;
  };

  type SpotifyEmbedController = {
    play: () => void;
    pause: () => void;
    resume: () => void;
    togglePlay: () => void;
    seek: (seconds: number) => void;
    addListener: (
      event: string,
      callback: (event: { data: SpotifyPlaybackData }) => void
    ) => void;
    destroy: () => void;
    loadUri?: (uri: string) => void;
  };

  type SpotifyIframeApi = {
    createController: (
      element: HTMLElement,
      options: {
        uri: string;
        width?: string | number;
        height?: string | number;
      },
      callback: (controller: SpotifyEmbedController) => void
    ) => void;
  };

  type SpotifyWindow = Window & {
    SpotifyIframeApi?: SpotifyIframeApi;
    onSpotifyIframeApiReady?: (api: SpotifyIframeApi) => void;
  };

  type MusicState = {
    index: number;
    count: number;
    title: string;
    artist: string;
    album: string;
    playing: boolean;
    current: number;
    duration: number;
    source: "local" | "spotify";
    isPreview: boolean;
    isLocal: boolean;
    lyrics: string[];
  };

  type BlogMusicApi = {
    tracks: {
      title: string;
      artist: string;
      album: string;
      duration: number;
      lyrics: string[];
      isLocal: boolean;
    }[];
    getState: () => MusicState;
    play: (index?: number) => void;
    pause: () => void;
    toggle: () => void;
    next: () => void;
    previous: () => void;
    seek: (seconds: number) => void;
  };

  declare global {
    interface Window {
      __blogMusic?: BlogMusicApi;
    }
  }

  let spotifyApi: SpotifyIframeApi | null = null;
  let apiPromise: Promise<SpotifyIframeApi> | null = null;

  const loadSpotifyApi = (): Promise<SpotifyIframeApi> => {
    if (spotifyApi) return Promise.resolve(spotifyApi);
    if (apiPromise) return apiPromise;

    const w = window as SpotifyWindow;
    if (w.SpotifyIframeApi) {
      spotifyApi = w.SpotifyIframeApi;
      return Promise.resolve(spotifyApi);
    }

    apiPromise = new Promise<SpotifyIframeApi>((resolve, reject) => {
      const timeout = window.setTimeout(
        () => reject(new Error("Spotify embed API timed out")),
        12000
      );

      w.onSpotifyIframeApiReady = (embedApi: SpotifyIframeApi) => {
        window.clearTimeout(timeout);
        spotifyApi = embedApi;
        resolve(embedApi);
      };

      let script = document.getElementById(
        "spotify-iframe-api"
      ) as HTMLScriptElement | null;

      if (!script) {
        script = document.createElement("script");
        script.id = "spotify-iframe-api";
        script.src = "https://open.spotify.com/embed/iframe-api/v1";
        script.async = true;
        script.addEventListener("error", () => {
          window.clearTimeout(timeout);
          reject(new Error("Spotify embed API failed to load"));
        });
        document.head.appendChild(script);
      }
    });

    apiPromise.catch(() => {
      apiPromise = null;
    });

    return apiPromise;
  };

  const readData = (): MusicPayload | null => {
    const el = document.querySelector<HTMLScriptElement>("[data-np-data]");
    if (!el?.textContent) return null;

    try {
      return JSON.parse(el.textContent) as MusicPayload;
    } catch {
      return null;
    }
  };

  const formatTime = (ms: number) => {
    const total = Math.max(0, Math.round(ms / 1000));
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const initNowPlaying = () => {
    const root = document.querySelector<HTMLElement>("[data-np]");
    if (!root || root.dataset.npReady === "true") return;

    const data = readData();
    if (!data?.tracks.length) return;

    root.dataset.npReady = "true";

    const labels = data.labels;
    const tracks = data.tracks;

    const cover = root.querySelector<HTMLImageElement>("[data-np-cover]");
    const ambient = root.querySelector<HTMLImageElement>("[data-np-ambient]");
    const peek = root.querySelector<HTMLButtonElement>("[data-np-peek]");
    const peekCover = root.querySelector<HTMLImageElement>(
      "[data-np-peek-cover]"
    );
    const peekTitle = root.querySelector<HTMLElement>("[data-np-peek-title]");
    const titleEl = root.querySelector<HTMLElement>("[data-np-title]");
    const artistEl = root.querySelector<HTMLElement>("[data-np-artist]");
    const albumEl = root.querySelector<HTMLElement>("[data-np-album]");
    const countEl = root.querySelector<HTMLElement>("[data-np-count]");
    const linkEl = root.querySelector<HTMLAnchorElement>("[data-np-link]");
    const lyricCurrent = root.querySelector<HTMLElement>(
      "[data-np-lyric-current]"
    );
    const lyricNext = root.querySelector<HTMLElement>("[data-np-lyric-next]");
    const lyricsEl = root.querySelector<HTMLElement>("[data-np-lyrics]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-np-toggle]");
    const prevButton = root.querySelector<HTMLButtonElement>("[data-np-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-np-next]");
    const restartButton =
      root.querySelector<HTMLButtonElement>("[data-np-restart]");
    const previewLink =
      root.querySelector<HTMLAnchorElement>("[data-np-preview]");
    const seek = root.querySelector<HTMLElement>("[data-np-seek]");
    const fill = root.querySelector<HTMLElement>("[data-np-fill]");
    const currentText = root.querySelector<HTMLElement>("[data-np-current]");
    const totalText = root.querySelector<HTMLElement>("[data-np-total]");
    const embedHost = root.querySelector<HTMLElement>("[data-np-embed]");
    const audio = root.querySelector<HTMLAudioElement>("[data-np-audio]");

    if (
      !cover ||
      !titleEl ||
      !artistEl ||
      !albumEl ||
      !countEl ||
      !linkEl ||
      !lyricCurrent ||
      !lyricNext ||
      !lyricsEl ||
      !toggle ||
      !prevButton ||
      !nextButton ||
      !restartButton ||
      !previewLink ||
      !seek ||
      !fill ||
      !currentText ||
      !totalText ||
      !embedHost ||
      !audio
    ) {
      return;
    }

    let index = 0;
    let source: "local" | "spotify" = "local";
    let isPlaying = false;
    let isDragging = false;
    let positionMs = 0;
    let durationMs = tracks[0]!.duration * 1000;
    let requestedPlay = false;
    let connecting = false;
    let spotifyController: SpotifyEmbedController | null = null;
    let spotifyUri = "";
    let localFailed = false;

    const nowPlayingLabel = root.getAttribute("aria-label") ?? "On repeat";

    const emitState = () => {
      window.dispatchEvent(
        new CustomEvent("blog-music:state", { detail: getState() })
      );
    };

    const setPlaying = (playing: boolean) => {
      isPlaying = playing;
      root.dataset.npPlaying = String(playing);
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute("aria-label", playing ? labels.pause : labels.play);
      emitState();
    };

    const paintDuration = () => {
      totalText.textContent = formatTime(durationMs);
      seek.setAttribute("aria-valuemax", String(Math.round(durationMs / 1000)));
    };

    const paintProgress = (ms: number) => {
      positionMs = clamp(ms, 0, Math.max(durationMs, 0));
      const ratio = durationMs > 0 ? positionMs / durationMs : 0;
      seek.style.setProperty("--np-p", `${ratio * 100}%`);
      seek.setAttribute("aria-valuenow", String(Math.round(positionMs / 1000)));
      seek.setAttribute("aria-valuetext", formatTime(positionMs));
      currentText.textContent = formatTime(positionMs);
    };

    const updateLyrics = (track: MusicTrack) => {
      lyricCurrent.textContent = track.lyrics[0] ?? "";
      lyricNext.textContent = track.lyrics[1] ?? "";
      lyricNext.hidden = !track.lyrics[1];
      lyricsEl.hidden = track.lyrics.length === 0;
    };

    const updateTrackUi = (track: MusicTrack) => {
      cover.src = track.cover;
      cover.alt = "";
      if (ambient) ambient.src = track.cover;
      titleEl.textContent = track.title;
      titleEl.title = track.title;
      artistEl.textContent = track.artist;
      albumEl.textContent = track.album;
      linkEl.href = track.url;
      previewLink.href = track.url;
      countEl.textContent = `${String(index + 1).padStart(2, "0")} / ${String(
        tracks.length
      ).padStart(2, "0")}`;

      if (peek && peekCover && peekTitle && tracks.length > 1) {
        const peekTrack = tracks[(index + 1) % tracks.length]!;
        peek.hidden = false;
        peekCover.src = peekTrack.cover;
        peekTitle.textContent = peekTrack.title;
        peek.title = peekTrack.title;
        peek.setAttribute("aria-label", `${labels.next}: ${peekTrack.title}`);
      }

      updateLyrics(track);
      durationMs = track.duration * 1000;
      positionMs = 0;
      paintDuration();
      paintProgress(0);
      previewLink.hidden = track.isLocal;
      root.dataset.npSource = track.isLocal ? "local" : "spotify";
    };

    const stopLocalAudio = () => {
      audio.pause();
      audio.removeAttribute("src");
      audio.load();
    };

    const pauseSpotify = () => {
      spotifyController?.pause();
    };

    const connectSpotify = async (
      track: MusicTrack,
      autoplay: boolean
    ): Promise<SpotifyEmbedController | null> => {
      if (!track.spotifyUri) {
        root.dataset.npUnavailable = "true";
        return null;
      }

      if (spotifyController) {
        if (track.spotifyUri !== spotifyUri && spotifyController.loadUri) {
          spotifyController.loadUri(track.spotifyUri);
          spotifyUri = track.spotifyUri;
        }

        if (autoplay) {
          requestedPlay = true;
          spotifyController.play();
        }

        return spotifyController;
      }

      if (connecting) return null;
      connecting = true;
      root.dataset.npLoading = "true";

      try {
        const api = await loadSpotifyApi();

        await new Promise<void>((resolve, reject) => {
          const guard = window.setTimeout(
            () => reject(new Error("Spotify controller timed out")),
            12000
          );

          const host = document.createElement("div");
          embedHost.replaceChildren(host);

          api.createController(
            host,
            {
              uri: track.spotifyUri,
              width: "100%",
              height: 152,
            },
            embed => {
              window.clearTimeout(guard);
              spotifyController = embed;
              spotifyUri = track.spotifyUri;
              root.dataset.npLoading = "false";
              root.dataset.npUnavailable = "false";
              resolve();

              embed.addListener("playback_update", event => {
                const playback = event.data;
                if (playback.duration > 0) {
                  durationMs = playback.duration;
                  paintDuration();
                }

                if (typeof playback.position === "number" && !isDragging) {
                  paintProgress(playback.position);
                }

                setPlaying(!playback.isPaused);
                previewLink.hidden = false;
                root.dataset.npSource = "spotify";
              });

              if (autoplay || requestedPlay) {
                requestedPlay = false;
                embed.play();
              }
            }
          );
        });
      } catch {
        root.dataset.npLoading = "false";
        root.dataset.npUnavailable = "true";
        previewLink.hidden = false;
      } finally {
        connecting = false;
      }

      return spotifyController;
    };

    const activateTrack = (autoplay: boolean) => {
      const track = tracks[index];
      if (!track) return;

      updateTrackUi(track);

      if (track.isLocal && !localFailed) {
        source = "local";
        pauseSpotify();
        audio.src = track.src;
        audio.load();
        root.dataset.npSource = "local";
        previewLink.hidden = true;

        if (autoplay) {
          void audio.play().catch(() => {
            localFailed = true;
            source = "spotify";
            void connectSpotify(track, true);
          });
        }
        return;
      }

      source = "spotify";
      stopLocalAudio();
      previewLink.hidden = false;
      root.dataset.npSource = "spotify";
      if (autoplay) {
        requestedPlay = true;
        void connectSpotify(track, true);
      }
    };

    const nextTrack = (forceAutoplay?: boolean) => {
      const wasPlaying = forceAutoplay ?? isPlaying;
      index = (index + 1) % tracks.length;
      localFailed = false;
      activateTrack(wasPlaying);
    };

    const previousTrack = () => {
      const elapsed = positionMs / 1000;
      if (elapsed > 3) {
        seekToSeconds(0);
        return;
      }

      const wasPlaying = isPlaying;
      index = (index - 1 + tracks.length) % tracks.length;
      localFailed = false;
      activateTrack(wasPlaying);
    };

    const togglePlayback = () => {
      if (source === "local") {
        if (audio.paused) {
          void audio.play().catch(() => {
            localFailed = true;
            const track = tracks[index];
            if (track) {
              source = "spotify";
              previewLink.hidden = false;
              void connectSpotify(track, true);
            }
          });
        } else {
          audio.pause();
        }
        return;
      }

      if (spotifyController) {
        spotifyController.togglePlay();
        return;
      }

      const track = tracks[index];
      if (track) {
        requestedPlay = true;
        void connectSpotify(track, true);
      }
    };

    const seekToSeconds = (seconds: number) => {
      const ms = clamp(seconds * 1000, 0, durationMs);
      paintProgress(ms);

      if (source === "local") {
        if (Number.isFinite(audio.duration)) {
          audio.currentTime = Math.min(seconds, audio.duration);
        }
        return;
      }

      spotifyController?.seek(seconds);
    };

    const seekToRatio = (ratio: number) => {
      seekToSeconds((ratio * durationMs) / 1000);
    };

    const ratioFromPointer = (event: PointerEvent) => {
      const rect = seek.getBoundingClientRect();
      if (!rect.width) return 0;
      return clamp((event.clientX - rect.left) / rect.width, 0, 1);
    };

    const getState = (): MusicState => {
      const track = tracks[index]!;
      return {
        index,
        count: tracks.length,
        title: track.title,
        artist: track.artist,
        album: track.album,
        playing: isPlaying,
        current: positionMs / 1000,
        duration: durationMs / 1000,
        source,
        isPreview: source === "spotify",
        isLocal: source === "local",
        lyrics: track.lyrics,
      };
    };

    // ── Local audio events ────────────────────────────────────────
    audio.addEventListener("play", () => setPlaying(true));
    audio.addEventListener("pause", () => setPlaying(false));
    audio.addEventListener("ended", () => {
      setPlaying(false);
      nextTrack(true);
    });
    audio.addEventListener("loadedmetadata", () => {
      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        durationMs = audio.duration * 1000;
        paintDuration();
      }
    });
    audio.addEventListener("timeupdate", () => {
      if (!isDragging) paintProgress(audio.currentTime * 1000);
    });
    audio.addEventListener("error", () => {
      if (source !== "local") return;
      localFailed = true;
      source = "spotify";
      previewLink.hidden = false;
      const track = tracks[index];
      if (track) void connectSpotify(track, isPlaying);
    });

    // ── Controls ──────────────────────────────────────────────────
    toggle.addEventListener("click", togglePlayback);
    prevButton.addEventListener("click", previousTrack);
    nextButton.addEventListener("click", () => nextTrack());
    peek?.addEventListener("click", () => nextTrack(true));
    restartButton.addEventListener("click", () => {
      seekToSeconds(0);
      if (source === "local") {
        void audio.play().catch(() => {});
      } else {
        spotifyController?.play();
      }
    });

    seek.addEventListener("pointerdown", event => {
      isDragging = true;
      seek.dataset.dragging = "true";
      seek.setPointerCapture?.(event.pointerId);
      paintProgress(ratioFromPointer(event) * durationMs);
    });

    seek.addEventListener("pointermove", event => {
      if (!isDragging) return;
      paintProgress(ratioFromPointer(event) * durationMs);
    });

    const endDrag = (event: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      delete seek.dataset.dragging;
      seekToRatio(ratioFromPointer(event));

      if (seek.hasPointerCapture?.(event.pointerId)) {
        seek.releasePointerCapture(event.pointerId);
      }
    };

    seek.addEventListener("pointerup", endDrag);
    seek.addEventListener("pointercancel", endDrag);

    seek.addEventListener("keydown", event => {
      let next = positionMs / 1000;
      if (event.key === "ArrowRight") next += 5;
      else if (event.key === "ArrowLeft") next -= 5;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = durationMs / 1000;
      else return;

      event.preventDefault();
      seekToSeconds(next);
    });

    // ── Initial track ─────────────────────────────────────────────
    activateTrack(false);
    paintDuration();
    paintProgress(0);

    // Warm up Spotify only when the card enters the viewport.
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          const track = tracks[index];
          if (track && !track.isLocal) void connectSpotify(track, false);
        },
        { rootMargin: "240px 0px" }
      );
      observer.observe(root);
    }

    // ── Public API used by the hero terminal ──────────────────────
    window.__blogMusic = {
      tracks: tracks.map(track => ({
        title: track.title,
        artist: track.artist,
        album: track.album,
        duration: track.duration,
        lyrics: track.lyrics,
        isLocal: track.isLocal,
      })),
      getState,
      play: (nextIndex?: number) => {
        if (typeof nextIndex === "number" && tracks[nextIndex]) {
          const wasPlaying = isPlaying;
          index = nextIndex;
          localFailed = false;
          activateTrack(wasPlaying);
          if (!wasPlaying) togglePlayback();
          return;
        }

        if (!isPlaying) togglePlayback();
      },
      pause: () => {
        if (source === "local") audio.pause();
        else spotifyController?.pause();
      },
      toggle: togglePlayback,
      next: nextTrack,
      previous: previousTrack,
      seek: seekToSeconds,
    };

    emitState();
    void nowPlayingLabel;
  };

  document.addEventListener("astro:page-load", initNowPlaying);
  initNowPlaying();
</script>
