---
/**
 * NowPlaying — a custom, theme-aware music card for the footer.
 *
 * Playback order:
 *   1. A local audio file (`public/audio/...`) gives every visitor the full
 *      track, with no login and no 30-second preview limit.
 *   2. If that file is missing, the card falls back to Spotify's official
 *      iFrame API (which streams a 30s preview to anonymous visitors).
 *
 * The card shows the current track, controls, and a short "enjoy" line; the
 * footer deck is a four-layer stack that advances one track per gesture.
 * Tapping a non-control area of the front card lifts the whole deck into a
 * centered 3D carousel of every track in the playlist.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import IconSpotify from "@/assets/icons/IconSpotify.svg";
import { SITE } from "@/config";

interface Props {
  label?: string;
  enjoyLabel?: string;
  openLabel?: string;
  playLabel?: string;
  pauseLabel?: string;
  restartLabel?: string;
  seekLabel?: string;
  previewLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  modeLabel?: string;
  orderLabel?: string;
  repeatLabel?: string;
  shuffleLabel?: string;
  class?: string;
}

const {
  label = "On repeat",
  enjoyLabel = "Enjoy the music ~",
  openLabel = "Open in Spotify",
  playLabel = "Play",
  pauseLabel = "Pause",
  restartLabel = "Restart",
  seekLabel = "Seek",
  previewLabel = "Preview",
  previousLabel = "Previous track",
  nextLabel = "Next track",
  modeLabel = "Playback mode",
  orderLabel = "Sequential",
  repeatLabel = "Repeat one",
  shuffleLabel = "Shuffle",
  class: className = "",
} = Astro.props;

const formatTime = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

const tracks = SITE.spotify.tracks.map(track => {
  const src = track.src ?? "";
  const isRemote = /^https?:\/\//i.test(src);
  const localPath =
    src.startsWith("/") && !isRemote
      ? fileURLToPath(new URL(`../../public${src}`, import.meta.url))
      : "";
  const isLocal =
    Boolean(src) && (isRemote || (localPath && existsSync(localPath)));
  const match = track.url.match(/track\/([A-Za-z0-9]+)/);

  return {
    title: track.title,
    artist: track.artist,
    album: track.album,
    cover: track.cover,
    url: track.url,
    src,
    isLocal: Boolean(isLocal),
    spotifyUri: match ? `spotify:track:${match[1]}` : "",
    duration: track.duration,
    lyrics: [...track.lyrics],
  };
});

const first = tracks[0];
if (!first) {
  throw new Error(
    "NowPlaying requires at least one track in SITE.spotify.tracks"
  );
}

const payload = {
  tracks,
  labels: {
    open: openLabel,
    play: playLabel,
    pause: pauseLabel,
    restart: restartLabel,
    seek: seekLabel,
    preview: previewLabel,
    previous: previousLabel,
    next: nextLabel,
    mode: modeLabel,
    order: orderLabel,
    repeat: repeatLabel,
    shuffle: shuffleLabel,
  },
};

const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");
const totalLabel = formatTime(first.duration);
---

<aside
  class:list={["now-playing", className]}
  aria-label={label}
  data-np
  data-np-playing="false"
>
  <div class="np-aura" aria-hidden="true">
    {Array.from({ length: 6 }).map(() => (
      <i />
    ))}
  </div>
  <div class="np-stack" data-np-stack>
    <div class="np-stage" data-np-stage>
      <div class="np-card" data-np-card data-np-track-index="0">
        <span
          class="np-hover-title"
          data-np-hover-title
          aria-hidden="true"
        ></span>
        <div class="np-art">
          <img
            data-np-cover
            src={first.cover}
            alt=""
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
          />
          <span class="np-art-sheen" aria-hidden="true"></span>
        </div>

        <div class="np-body" data-np-body>
          <div class="np-head">
            <p class="np-eyebrow">
              <span class="np-eq" aria-hidden="true">
                {Array.from({ length: 4 }).map((_, index) => (
                  <i style={`--i: ${index}`} />
                ))}
              </span>
              <span>{label}</span>
            </p>

            <div class="np-head-right">
              <span class="np-count" data-np-count>
                01 / {String(tracks.length).padStart(2, "0")}
              </span>
              <a
                class="np-open"
                data-np-link
                href={first.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={openLabel}
              >
                <IconSpotify class="np-open-icon" />
                <span>Spotify</span>
                <span class="np-open-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </div>
          </div>

          <div class="np-meta">
            <p class="np-title" data-np-title>
              {first.title}
            </p>
            <p class="np-sub">
              <span data-np-artist>{first.artist}</span>
              <span class="np-dot" aria-hidden="true">
                ·
              </span>
              <span class="np-album" data-np-album>
                {first.album}
              </span>
            </p>
          </div>

          <p class="np-enjoy">{enjoyLabel}</p>

          <div class="np-progress">
            <span class="np-time" data-np-current>
              0:00
            </span>
            <div
              class="np-seek"
              data-np-seek
              role="slider"
              tabindex="0"
              aria-label={seekLabel}
              aria-valuemin="0"
              aria-valuemax={String(first.duration)}
              aria-valuenow="0"
              aria-valuetext="0:00"
            >
              <span class="np-seek-rail">
                <span class="np-seek-fill" data-np-fill></span>
              </span>
              <span class="np-seek-thumb" aria-hidden="true"></span>
            </div>
            <span class="np-time" data-np-total>
              {totalLabel}
            </span>
          </div>

          <div class="np-controls">
            <button
              type="button"
              class="np-skip"
              data-np-prev
              aria-label={previousLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.5 5.5v13l-9-6.5 9-6.5Z" />
                <path d="M6.5 5.5v13" />
              </svg>
            </button>

            <button
              type="button"
              class="np-toggle"
              data-np-toggle
              aria-label={playLabel}
              aria-pressed="false"
            >
              <svg
                class="np-icon np-icon-play"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
              </svg>
              <svg
                class="np-icon np-icon-pause"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8.25 4.5h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Zm5 0h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Z" />
              </svg>
            </button>

            <button
              type="button"
              class="np-skip"
              data-np-next
              aria-label={nextLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.5 5.5v13l9-6.5-9-6.5Z" />
                <path d="M17.5 5.5v13" />
              </svg>
            </button>

            <button
              type="button"
              class="np-restart"
              data-np-restart
              aria-label={restartLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 5.25v4.5h4.5" />
                <path d="M4.78 9.5a8 8 0 1 1 .3 5.6" />
              </svg>
            </button>

            <button
              type="button"
              class="np-mode"
              data-np-mode
              data-mode="order"
              aria-label="Playback mode"
            >
              <svg
                class="np-mode-icon np-mode-icon--order"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M4 7h13l-3-3" />
                <path d="M20 17H7l3 3" />
              </svg>
              <svg
                class="np-mode-icon np-mode-icon--repeat"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M17 3.5 20.5 7 17 10.5" />
                <path d="M20 7H7a3.5 3.5 0 0 0-3.5 3.5V12" />
                <path d="M7 20.5 3.5 17 7 13.5" />
                <path d="M4 17h13a3.5 3.5 0 0 0 3.5-3.5V12" />
                <text x="11.4" y="14.8" class="np-mode-one">
                  1
                </text>
              </svg>
              <svg
                class="np-mode-icon np-mode-icon--shuffle"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M3 6h3.2c1.4 0 2.6.7 3.4 1.9l5 7.2c.8 1.2 2 1.9 3.4 1.9H21" />
                <path d="m18 14 3 3-3 3" />
                <path d="M3 18h3.2c1.4 0 2.6-.7 3.4-1.9l1-1.4" />
                <path d="m18 3 3 3-3 3" />
                <path d="M14.5 9.2c.6-1.2 1.8-2.2 3.3-2.2H21" />
              </svg>
            </button>

            <a
              class="np-preview"
              data-np-preview
              href={first.url}
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              <span class="np-preview-dot" aria-hidden="true"></span>
              {previewLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Spotify's preview player lives here; it is never shown. -->
  <div class="np-embed" aria-hidden="true">
    <div data-np-embed></div>
  </div>
  <audio class="np-audio" data-np-audio preload="metadata"></audio>
</aside>

<script
  type="application/json"
  data-np-data
  is:inline
  set:html={payloadJson}
></script>

<style>
  .now-playing {
    position: relative;
    display: block;
    min-width: 0;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    overscroll-behavior: contain;
  }

  .now-playing img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .np-stack {
    position: relative;
    z-index: 1;
    isolation: isolate;
    /* The extra top room is cancelled by the negative margin, so the front
       card keeps its place while the tilted back cards get space to breathe. */
    padding-top: 5.45rem;
    margin-top: -2rem;
    contain: paint;
    touch-action: none;
  }

  .np-stage {
    position: relative;
    overflow: visible;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .now-playing[data-np-moving="true"] .np-body {
    pointer-events: none;
  }

  .np-card.np-clone {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    border-radius: 1.05rem;
    will-change: transform, opacity, filter;
  }

  .np-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: 0.95rem;
    min-height: 10.25rem;
    padding: 0.82rem;
    overflow: hidden;
    border: 0;
    border-radius: 1.05rem;
    background:
      radial-gradient(
        105% 130% at 92% -18%,
        color-mix(in srgb, var(--color-accent) 11%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
    box-shadow:
      0 8px 20px -20px
        color-mix(in srgb, var(--color-foreground) 38%, transparent),
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-foreground) 5%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 6%, transparent);
    transform-origin: 50% 0%;
    will-change: transform, opacity, filter;
    transition: box-shadow 0.25s ease;
  }

  .np-card[data-np-role="1"],
  .np-card[data-np-role="2"] {
    cursor: pointer;
  }

  .now-playing[data-np-returning="true"] .np-card {
    transition:
      opacity 0.26s ease,
      filter 0.26s ease;
  }

  .np-hover-title {
    position: absolute;
    z-index: 3;
    top: 0.16rem;
    left: 0.82rem;
    max-width: calc(100% - 1.7rem);
    overflow: hidden;
    padding: 0.1rem 0.38rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 78%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-accent);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-0.18rem);
    transition:
      opacity 0.14s ease,
      transform 0.14s ease;
    pointer-events: none;
  }

  .np-card[data-np-role="1"]:hover .np-hover-title,
  .np-card[data-np-role="2"]:hover .np-hover-title {
    opacity: 1;
    transform: none;
  }

  .np-card[data-np-role="3"] .np-hover-title {
    display: none;
  }

  .np-card:hover {
    box-shadow:
      0 16px 34px -26px
        color-mix(in srgb, var(--color-foreground) 42%, transparent),
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-foreground) 7%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 9%, transparent);
  }

  .np-art {
    position: relative;
    align-self: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 8%,
      var(--color-background)
    );
    box-shadow: 0 12px 24px -16px
      color-mix(in srgb, var(--color-foreground) 80%, transparent);
  }

  .np-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    transform: scale(1.09);
  }

  .np-art-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.16),
      transparent 42%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .np-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    pointer-events: auto;
  }

  .np-body[inert] {
    pointer-events: none;
  }

  .np-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .np-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-eq {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 2px;
    width: 0.62rem;
    height: 0.7rem;
  }

  .np-eq i {
    --i: 0;

    display: block;
    flex: 1;
    width: 1.5px;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }

  .now-playing[data-np-playing="true"] .np-card.np-active .np-eq i {
    animation: np-eq 1.05s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.17s);
  }

  .np-eq i:nth-child(1) {
    transform: scaleY(0.35);
  }

  .np-eq i:nth-child(2) {
    transform: scaleY(0.85);
  }

  .np-eq i:nth-child(3) {
    transform: scaleY(0.5);
  }

  .np-eq i:nth-child(4) {
    transform: scaleY(0.95);
  }

  @keyframes np-eq {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .np-head-right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
  }

  .np-count {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-foreground) 34%, transparent);
    white-space: nowrap;
  }

  .np-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-open:hover {
    color: var(--color-accent);
  }

  .np-open:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-open-icon {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0.85;
  }

  .np-open-arrow {
    font-size: 0.68rem;
    line-height: 1;
    opacity: 0.7;
  }

  .np-meta {
    min-width: 0;
    margin-top: 0.45rem;
  }

  .np-title {
    overflow: hidden;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-sub {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: 0.14rem;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    white-space: nowrap;
  }

  .np-album {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.8;
  }

  .np-dot {
    opacity: 0.5;
  }

  .np-enjoy {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 1.75rem;
    margin: 0.55rem 0 0;
    padding-left: 0.75rem;
    font-size: 0.74rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-foreground) 64%, transparent);
  }

  .np-enjoy::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 1.3rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-accent) 42%, transparent),
      transparent
    );
    content: "";
    transform: translateY(-50%);
  }

  .np-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .np-time {
    flex: none;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .np-seek {
    --np-p: 0%;

    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    height: 0.9rem;
    min-width: 0;
    cursor: pointer;
    touch-action: none;
  }

  .np-seek:focus-visible {
    border-radius: 999px;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-seek-rail {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    transition: height 0.18s ease;
  }

  .np-seek-fill {
    display: block;
    width: var(--np-p);
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
  }

  .np-seek-thumb {
    position: absolute;
    top: 50%;
    left: var(--np-p);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 16%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  .np-seek:hover .np-seek-rail,
  .np-seek[data-dragging="true"] .np-seek-rail {
    height: 3px;
  }

  .np-seek:hover .np-seek-thumb,
  .np-seek:focus-visible .np-seek-thumb,
  .np-seek[data-dragging="true"] .np-seek-thumb {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.6rem;
  }

  .np-skip {
    display: inline-grid;
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 44%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .np-skip:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .np-skip:focus-visible,
  .np-restart:focus-visible,
  .np-toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-skip svg {
    width: 0.9rem;
    height: 0.9rem;
