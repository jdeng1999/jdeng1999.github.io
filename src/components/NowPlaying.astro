---
/**
 * NowPlaying — a custom, theme-aware Spotify card for the footer.
 *
 * The official Spotify embed owns the whole iframe surface (artwork, buttons,
 * typography) and exposes no styling hooks, so this card is drawn by us. Real
 * playback is still handled by Spotify through their official iFrame API: the
 * embed itself is kept invisible behind the card and only its controller is
 * used (play/pause, seek, restart, progress). If the API is unavailable the
 * controls gracefully fall back to opening the track on Spotify.
 */
import IconSpotify from "@/assets/icons/IconSpotify.svg";

interface Props {
  url: string;
  title: string;
  artist: string;
  album?: string;
  cover?: string;
  duration?: number; // fallback duration in seconds, replaced by the API
  label?: string;
  openLabel?: string;
  playLabel?: string;
  pauseLabel?: string;
  restartLabel?: string;
  seekLabel?: string;
  previewLabel?: string;
  class?: string;
}

const {
  url,
  title,
  artist,
  album = "",
  cover = "",
  duration = 0,
  label = "On repeat",
  openLabel = "Open in Spotify",
  playLabel = "Play",
  pauseLabel = "Pause",
  restartLabel = "Restart",
  seekLabel = "Seek",
  previewLabel = "Preview",
  class: className = "",
} = Astro.props;

const trackId = url.match(
  /open\.spotify\.com\/(?:intl-[a-z-]+\/)?track\/([A-Za-z0-9]+)/
)?.[1];

const formatTime = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

const totalLabel = formatTime(duration);
---

<aside
  class:list={["now-playing", className]}
  aria-label={label}
  data-np
  data-np-uri={trackId ? `spotify:track:${trackId}` : ""}
  data-np-url={url}
  data-np-duration={String(duration)}
  data-np-playing="false"
  data-label-play={playLabel}
  data-label-pause={pauseLabel}
>
  <div class="np-card">
    <div class="np-art">
      {cover ? (
        <img
          src={cover}
          alt=""
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="np-art-fallback" aria-hidden="true">
          <IconSpotify class="np-art-icon" />
        </span>
      )}
      <span class="np-art-sheen" aria-hidden="true" />
    </div>

    <div class="np-body">
      <div class="np-head">
        <p class="np-eyebrow">
          <span class="np-eq" aria-hidden="true">
            {Array.from({ length: 4 }).map((_, index) => (
              <i style={`--i: ${index}`} />
            ))}
          </span>
          <span>{label}</span>
        </p>

        <a
          class="np-open"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={openLabel}
          title={openLabel}
        >
          <IconSpotify class="np-open-icon" />
          <span>Spotify</span>
          <span class="np-open-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>

      <div class="np-meta">
        <p class="np-title" title={title}>
          {title}
        </p>
        <p class="np-sub">
          <span>{artist}</span>
          {album && (
            <>
              <span class="np-dot" aria-hidden="true">
                ·
              </span>
              <span class="np-album">{album}</span>
            </>
          )}
        </p>
      </div>

      <div class="np-progress">
        <span class="np-time" data-np-current>
          0:00
        </span>
        <div
          class="np-seek"
          data-np-seek
          role="slider"
          tabindex="0"
          aria-label={seekLabel}
          aria-valuemin="0"
          aria-valuemax={String(duration)}
          aria-valuenow="0"
          aria-valuetext="0:00"
        >
          <span class="np-seek-rail">
            <span class="np-seek-fill" data-np-fill></span>
          </span>
          <span class="np-seek-thumb" aria-hidden="true"></span>
        </div>
        <span class="np-time" data-np-total>
          {totalLabel}
        </span>
      </div>

      <div class="np-controls">
        <button
          type="button"
          class="np-toggle"
          data-np-toggle
          aria-label={playLabel}
          aria-pressed="false"
        >
          <svg
            class="np-icon np-icon-play"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
          </svg>
          <svg
            class="np-icon np-icon-pause"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M8.25 4.5h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Zm5 0h2.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Z" />
          </svg>
          <span class="np-toggle-ring" aria-hidden="true"></span>
        </button>

        <button
          type="button"
          class="np-restart"
          data-np-restart
          aria-label={restartLabel}
          title={restartLabel}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 5.25v4.5h4.5" />
            <path d="M4.78 9.5a8 8 0 1 1 .3 5.6" />
          </svg>
        </button>

        <a
          class="np-preview"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          data-np-preview
          title={openLabel}
          hidden
        >
          <span class="np-preview-dot" aria-hidden="true"></span>
          {previewLabel}
        </a>
      </div>
    </div>
  </div>

  <!-- Spotify's real player lives here; it is never shown. -->
  <div class="np-embed" aria-hidden="true">
    <div data-np-embed></div>
  </div>
</aside>

<style>
  .now-playing {
    display: block;
    min-width: 0;
  }

  .np-card {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 9.5rem;
    padding: 0.9rem;
    border: 0;
    border-radius: 1.15rem;
    background:
      radial-gradient(
        105% 130% at 92% -18%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-foreground) 4.5%, var(--color-background));
    box-shadow:
      0 22px 44px -34px
        color-mix(in srgb, var(--color-foreground) 70%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 7%, transparent);
    transition:
      box-shadow 0.35s ease,
      background-color 0.35s ease;
  }

  .np-card:hover {
    box-shadow:
      0 26px 50px -32px
        color-mix(in srgb, var(--color-foreground) 62%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 9%, transparent);
  }

  .np-art {
    position: relative;
    align-self: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 8%,
      var(--color-background)
    );
    box-shadow: 0 12px 24px -16px
      color-mix(in srgb, var(--color-foreground) 80%, transparent);
  }

  .np-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }

  .np-art-fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: color-mix(in srgb, var(--color-accent) 75%, transparent);
  }

  .np-art-icon {
    width: 2rem;
    height: 2rem;
  }

  .np-art-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.18),
      transparent 42%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .np-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .np-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .np-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 52%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-eq {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 2px;
    width: 0.62rem;
    height: 0.7rem;
  }

  .np-eq i {
    --i: 0;

    display: block;
    flex: 1;
    width: 1.5px;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }

  .now-playing[data-np-playing="true"] .np-eq i {
    animation: np-eq 1.05s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.17s);
  }

  .np-eq i:nth-child(1) {
    transform: scaleY(0.35);
  }

  .np-eq i:nth-child(2) {
    transform: scaleY(0.85);
  }

  .np-eq i:nth-child(3) {
    transform: scaleY(0.5);
  }

  .np-eq i:nth-child(4) {
    transform: scaleY(0.95);
  }

  @keyframes np-eq {
    0%,
    100% {
      transform: scaleY(0.28);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .np-open {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-open:hover {
    color: var(--color-accent);
  }

  .np-open:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-open-icon {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0.85;
  }

  .np-open-arrow {
    font-size: 0.68rem;
    line-height: 1;
    opacity: 0.7;
  }

  .np-meta {
    min-width: 0;
    margin-top: 0.5rem;
  }

  .np-title {
    overflow: hidden;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-sub {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: 0.16rem;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    white-space: nowrap;
  }

  .np-album {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.8;
  }

  .np-dot {
    opacity: 0.5;
  }

  .np-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.8rem;
  }

  .np-time {
    flex: none;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .np-seek {
    --np-p: 0%;

    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    height: 0.9rem;
    min-width: 0;
    cursor: pointer;
    touch-action: none;
  }

  .np-seek:focus-visible {
    border-radius: 999px;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-seek-rail {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    transition: height 0.18s ease;
  }

  .np-seek-fill {
    display: block;
    width: var(--np-p);
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
  }

  .np-seek-thumb {
    position: absolute;
    top: 50%;
    left: var(--np-p);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 16%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  .np-seek:hover .np-seek-rail,
  .np-seek[data-dragging="true"] .np-seek-rail {
    height: 3px;
  }

  .np-seek:hover .np-seek-thumb,
  .np-seek:focus-visible .np-seek-thumb,
  .np-seek[data-dragging="true"] .np-seek-thumb {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .np-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.65rem;
  }

  .np-toggle {
    position: relative;
    display: inline-grid;
    flex: none;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .np-toggle:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    box-shadow: 0 6px 16px -8px
      color-mix(in srgb, var(--color-accent) 65%, transparent);
    transform: translateY(-1px);
  }

  .np-toggle:active {
    transform: translateY(0);
  }

  .np-toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  .np-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .np-icon-pause {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-play {
    display: none;
  }

  .now-playing[data-np-playing="true"] .np-icon-pause {
    display: block;
  }

  .np-toggle-ring {
    position: absolute;
    inset: -0.22rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.86);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    pointer-events: none;
  }

  .np-toggle:hover .np-toggle-ring {
    opacity: 1;
    transform: scale(1);
  }

  .np-restart {
    display: inline-grid;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    margin-left: 0.15rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .np-restart:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .np-restart:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 1px;
  }

  .np-restart svg {
    width: 0.82rem;
    height: 0.82rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .np-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .np-preview[hidden] {
    display: none;
  }

  .np-preview:hover {
    color: var(--color-accent);
  }

  .np-preview:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .np-preview-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0.75;
  }

  /* Spotify's embed is used for audio only; it never paints the card. */
  .np-embed {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    clip-path: inset(50%);
  }

  .now-playing {
    position: relative;
  }

  .now-playing[data-np-loading="true"] .np-toggle {
    animation: np-pulse 1.4s ease-in-out infinite;
  }

  @keyframes np-pulse {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 26rem) {
    .np-card {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.75rem;
      min-height: 8.25rem;
    }

    .np-title {
      font-size: 0.96rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-card,
    .np-seek-rail,
    .np-seek-thumb,
    .np-toggle,
    .np-toggle-ring {
      transition: none;
    }

    .now-playing[data-np-playing="true"] .np-eq i {
      animation: none;
    }

    .now-playing[data-np-loading="true"] .np-toggle {
      animation: none;
    }
  }
</style>

<script>
  type SpotifyPlaybackData = {
    isPaused: boolean;
    isBuffering: boolean;
    duration: number;
    position: number;
  };

  type SpotifyEmbedController = {
    play: () => void;
    pause: () => void;
    resume: () => void;
    togglePlay: () => void;
    seek: (seconds: number) => void;
    addListener: (
      event: string,
      callback: (event: { data: SpotifyPlaybackData }) => void
    ) => void;
    destroy: () => void;
  };

  type SpotifyIframeApi = {
    createController: (
      element: HTMLElement,
      options: {
        uri: string;
        width?: string | number;
        height?: string | number;
      },
      callback: (controller: SpotifyEmbedController) => void
    ) => void;
  };

  type SpotifyWindow = Window & {
    SpotifyIframeApi?: SpotifyIframeApi;
    onSpotifyIframeApiReady?: (api: SpotifyIframeApi) => void;
  };

  let spotifyApi: SpotifyIframeApi | null = null;
  let apiPromise: Promise<SpotifyIframeApi> | null = null;

  const loadSpotifyApi = (): Promise<SpotifyIframeApi> => {
    if (spotifyApi) return Promise.resolve(spotifyApi);
    if (apiPromise) return apiPromise;

    const w = window as SpotifyWindow;
    if (w.SpotifyIframeApi) {
      spotifyApi = w.SpotifyIframeApi;
      return Promise.resolve(spotifyApi);
    }

    apiPromise = new Promise<SpotifyIframeApi>((resolve, reject) => {
      const timeout = window.setTimeout(
        () => reject(new Error("Spotify embed API timed out")),
        12000
      );

      w.onSpotifyIframeApiReady = (embedApi: SpotifyIframeApi) => {
        window.clearTimeout(timeout);
        spotifyApi = embedApi;
        resolve(embedApi);
      };

      let script = document.getElementById(
        "spotify-iframe-api"
      ) as HTMLScriptElement | null;

      if (!script) {
        script = document.createElement("script");
        script.id = "spotify-iframe-api";
        script.src = "https://open.spotify.com/embed/iframe-api/v1";
        script.async = true;
        script.addEventListener("error", () => {
          window.clearTimeout(timeout);
          reject(new Error("Spotify embed API failed to load"));
        });
        document.head.appendChild(script);
      }
    });

    apiPromise.catch(() => {
      apiPromise = null;
    });

    return apiPromise;
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const setupPlayer = (root: HTMLElement) => {
    if (root.dataset.npSetup === "true") return;
    root.dataset.npSetup = "true";

    const uri = root.dataset.npUri ?? "";
    const trackUrl = root.dataset.npUrl ?? "";
    if (!uri) {
      root.dataset.npUnavailable = "true";
      return;
    }

    const embedHost = root.querySelector<HTMLElement>("[data-np-embed]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-np-toggle]");
    const seek = root.querySelector<HTMLElement>("[data-np-seek]");
    const fill = root.querySelector<HTMLElement>("[data-np-fill]");
    const currentText = root.querySelector<HTMLElement>("[data-np-current]");
    const totalText = root.querySelector<HTMLElement>("[data-np-total]");
    const restartButton =
      root.querySelector<HTMLButtonElement>("[data-np-restart]");
    const previewLink =
      root.querySelector<HTMLAnchorElement>("[data-np-preview]");

    if (
      !embedHost ||
      !toggle ||
      !seek ||
      !fill ||
      !currentText ||
      !totalText ||
      !restartButton ||
      !previewLink
    ) {
      return;
    }

    const playLabel = root.dataset.labelPlay ?? "Play";
    const pauseLabel = root.dataset.labelPause ?? "Pause";

    let controller: SpotifyEmbedController | null = null;
    let duration = Number(root.dataset.npDuration ?? 0) * 1000;
    let position = 0;
    let dragging = false;
    let requestedPlay = false;
    let connecting = false;

    const format = (ms: number) => {
      const total = Math.max(0, Math.round(ms / 1000));
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
    };

    const paintProgress = (ms: number) => {
      const ratio = duration > 0 ? clamp(ms / duration, 0, 1) : 0;
      seek.style.setProperty("--np-p", `${ratio * 100}%`);
      seek.setAttribute("aria-valuenow", String(Math.round(ms / 1000)));
      seek.setAttribute("aria-valuetext", format(ms));
      currentText.textContent = format(ms);
    };

    const paintDuration = () => {
      totalText.textContent = format(duration);
      seek.setAttribute("aria-valuemax", String(Math.round(duration / 1000)));
    };

    const setPlaying = (playing: boolean) => {
      root.dataset.npPlaying = playing ? "true" : "false";
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute("aria-label", playing ? pauseLabel : playLabel);
    };

    const renderPlayback = (data: SpotifyPlaybackData) => {
      if (typeof data.duration === "number" && data.duration > 0) {
        duration = data.duration;
        paintDuration();
      }

      if (typeof data.position === "number") {
        position = data.position;
        if (!dragging) paintProgress(position);
      }

      // Anonymous listeners only get a 30s preview; surface that instead of
      // silently shortening the timeline.
      const isPreview = duration > 0 && duration <= 35000;
      previewLink.hidden = !isPreview;

      setPlaying(!data.isPaused);
    };

    const connect = async (): Promise<SpotifyEmbedController | null> => {
      if (controller) return controller;
      if (connecting) return null;
      connecting = true;
      root.dataset.npLoading = "true";

      try {
        const api = await loadSpotifyApi();

        await new Promise<void>((resolve, reject) => {
          const guard = window.setTimeout(
            () => reject(new Error("Spotify controller timed out")),
            12000
          );

          api.createController(
            embedHost,
            { uri, width: "100%", height: 152 },
            embed => {
              window.clearTimeout(guard);
              controller = embed;
              root.dataset.npLoading = "false";
              root.dataset.npUnavailable = "false";
              resolve();

              embed.addListener("playback_update", event => {
                renderPlayback(event.data);
              });

              if (requestedPlay) {
                requestedPlay = false;
                embed.play();
              }
            }
          );
        });
      } catch {
        root.dataset.npLoading = "false";
        root.dataset.npUnavailable = "true";
      } finally {
        connecting = false;
      }

      return controller;
    };

    const seekToRatio = (ratio: number) => {
      position = ratio * duration;
      paintProgress(position);
      controller?.seek(position / 1000);
    };

    const ratioFromPointer = (event: PointerEvent) => {
      const rect = seek.getBoundingClientRect();
      if (!rect.width) return 0;
      return clamp((event.clientX - rect.left) / rect.width, 0, 1);
    };

    toggle.addEventListener("click", () => {
      if (controller) {
        controller.togglePlay();
        return;
      }

      if (root.dataset.npUnavailable === "true") {
        window.open(trackUrl, "_blank", "noopener,noreferrer");
        return;
      }

      requestedPlay = true;
      void connect();
    });

    seek.addEventListener("pointerdown", event => {
      if (!controller) {
        requestedPlay = true;
        void connect();
        return;
      }

      dragging = true;
      seek.dataset.dragging = "true";
      seek.setPointerCapture?.(event.pointerId);
      paintProgress(ratioFromPointer(event) * duration);
    });

    seek.addEventListener("pointermove", event => {
      if (!dragging) return;
      paintProgress(ratioFromPointer(event) * duration);
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      delete seek.dataset.dragging;
      seekToRatio(ratioFromPointer(event));

      if (seek.hasPointerCapture?.(event.pointerId)) {
        seek.releasePointerCapture(event.pointerId);
      }
    };

    seek.addEventListener("pointerup", endDrag);
    seek.addEventListener("pointercancel", endDrag);

    seek.addEventListener("keydown", event => {
      if (!controller || duration <= 0) return;

      let next = position / 1000;
      if (event.key === "ArrowRight") next += 5;
      else if (event.key === "ArrowLeft") next -= 5;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = duration / 1000;
      else return;

      event.preventDefault();
      next = clamp(next, 0, duration / 1000);
      position = next * 1000;
      paintProgress(position);
      controller.seek(next);
    });

    restartButton.addEventListener("click", () => {
      if (!controller) {
        requestedPlay = true;
        void connect();
        return;
      }

      position = 0;
      paintProgress(0);
      controller.seek(0);
      controller.play();
    });

    paintDuration();
    paintProgress(0);

    // Warm the controller up when the footer comes into view, so the first
    // click feels instant without loading Spotify on every page.
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          void connect();
        },
        { rootMargin: "240px 0px" }
      );
      observer.observe(root);
    }
  };

  const initNowPlaying = () => {
    document.querySelectorAll<HTMLElement>("[data-np]").forEach(setupPlayer);
  };

  document.addEventListener("astro:page-load", initNowPlaying);
  initNowPlaying();
</script>
