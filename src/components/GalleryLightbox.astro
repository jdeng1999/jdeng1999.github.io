---
type Props = {
  id: string;
  label?: string;
};

const { id, label = "Image viewer" } = Astro.props;
---

<dialog
  id={id}
  class="lightbox"
  data-gallery-lightbox
  aria-label={label}
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span class="lightbox-counter font-firacode" data-lb-counter></span>
      <button
        class="lightbox-btn"
        data-lb-close
        aria-label="Close"
        title="Close (Esc)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav lightbox-prev"
        data-lb-prev
        aria-label="Previous"
        title="Previous (Left Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-slider" data-lb-slider tabindex="-1">
          <div class="lightbox-track" data-lb-track>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                data-lb-img-prev
              />
            </div>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                data-lb-img
              />
            </div>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                data-lb-img-next
              />
            </div>
          </div>
        </div>
        <p class="lightbox-caption text-foreground/80" data-lb-caption></p>
      </div>

      <button
        class="lightbox-btn lightbox-nav lightbox-next"
        data-lb-next
        aria-label="Next"
        title="Next (Right Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  let lightboxController: AbortController | null = null;

  function initLightboxes() {
    lightboxController?.abort();
    lightboxController = new AbortController();
    const { signal } = lightboxController;

    document
      .querySelectorAll<HTMLDialogElement>("[data-gallery-lightbox]")
      .forEach(dialog => {
        const items = Array.from(
          document.querySelectorAll<HTMLButtonElement>(
            `button[data-lb="${dialog.id}"]`
          )
        );
        if (items.length === 0) return;

        const lbImg = dialog.querySelector<HTMLImageElement>("[data-lb-img]");
        const lbPrevImg =
          dialog.querySelector<HTMLImageElement>("[data-lb-img-prev]");
        const lbNextImg =
          dialog.querySelector<HTMLImageElement>("[data-lb-img-next]");
        const slider = dialog.querySelector<HTMLElement>("[data-lb-slider]");
        const track = dialog.querySelector<HTMLElement>("[data-lb-track]");
        const lbCaption =
          dialog.querySelector<HTMLElement>("[data-lb-caption]");
        const lbCounter =
          dialog.querySelector<HTMLElement>("[data-lb-counter]");
        const closeBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-close]");
        const prevBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-prev]");
        const nextBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-next]");

        if (!lbImg || !lbPrevImg || !lbNextImg || !slider || !track) return;

        const count = items.length;
        let current = 0;
        let displayOffset = 0;
        let dragTarget = 0;
        let dragging = false;
        let animating = false;
        let pointerId = -1;
        let startX = 0;
        let lastRaw = 0;
        let lastTime = 0;
        let velocity = 0;
        let followFrame = 0;
        let finishTimer = 0;
        let animationToken = 0;
        let lastCaption = "";

        const imageAt = (idx: number) =>
          items[(idx + count) % count]?.querySelector("img");

        const setSlideImage = (
          element: HTMLImageElement,
          idx: number,
          empty: boolean
        ) => {
          const img = imageAt(idx);
          if (img) {
            element.src = img.src;
            element.alt = img.alt;
          }
          element.parentElement?.setAttribute("data-empty", String(empty));
        };

        const updateCaption = () => {
          const img = imageAt(current);
          if (!lbCaption || !img) return;
          const caption = img.alt.trim();
          const hasCaption = caption.length > 0 && !/^\d+$/.test(caption);
          const nextCaption = hasCaption ? caption : "";
          if (nextCaption === lastCaption) {
            lbCaption.hidden = !hasCaption;
            return;
          }
          lastCaption = nextCaption;
          lbCaption.textContent = nextCaption;
          lbCaption.hidden = !hasCaption;
        };

        const renderSlides = () => {
          setSlideImage(lbPrevImg, current - 1, current === 0);
          setSlideImage(lbImg, current, false);
          setSlideImage(lbNextImg, current + 1, current === count - 1);

          if (lbCounter) {
            lbCounter.textContent = `${current + 1} / ${count}`;
          }
          updateCaption();
          if (prevBtn) {
            prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
          }
          if (nextBtn) {
            nextBtn.style.visibility =
              current === count - 1 ? "hidden" : "visible";
          }

          displayOffset = 0;
          dragTarget = 0;
          track.style.transition = "none";
          track.style.transform = "translate3d(0, 0, 0)";
        };

        const applyOffset = () => {
          track.style.transform = `translate3d(${-displayOffset * 100}%, 0, 0)`;
        };

        const follow = () => {
          if (!dragging) return;
          displayOffset += (dragTarget - displayOffset) * 0.32;
          applyOffset();
          followFrame = requestAnimationFrame(follow);
        };

        const stopFollow = () => {
          window.cancelAnimationFrame(followFrame);
          followFrame = 0;
        };

        const finishAnimation = (delta: number) => {
          window.clearTimeout(finishTimer);
          if (!animating) return;
          animating = false;
          animationToken += 1;
          if (delta !== 0) {
            current = Math.max(0, Math.min(count - 1, current + delta));
          }
          renderSlides();
        };

        const animateTo = (delta: number, releaseVelocity: number) => {
          if (animating) return;
          const target = Math.max(0, Math.min(count - 1, current + delta));
          const actualDelta = target - current;
          if (actualDelta === 0 && Math.abs(displayOffset) < 0.01) {
            renderSlides();
            return;
          }

          animating = true;
          const token = ++animationToken;
          const speed = Math.min(1, Math.abs(releaseVelocity) * 220);
          const duration = 300 + Math.round(speed * 150);
          track.style.transition = `transform ${duration}ms cubic-bezier(0.22, 1, 0.36, 1)`;
          // Let the browser paint the current dragged position first.
          requestAnimationFrame(() => {
            if (token !== animationToken) return;
            track.style.transform = `translate3d(${-actualDelta * 100}%, 0, 0)`;
          });

          const finish = () => {
            if (token !== animationToken) return;
            finishAnimation(actualDelta);
          };
          track.addEventListener("transitionend", finish, { once: true });
          finishTimer = window.setTimeout(finish, duration + 40);
        };

        function open(idx: number) {
          current = Math.max(0, Math.min(idx, count - 1));
          renderSlides();
          if (!dialog.open) dialog.showModal();
          slider?.focus({ preventScroll: true });
          document.body.style.overflow = "hidden";
        }

        function close() {
          stopFollow();
          dragging = false;
          animating = false;
          animationToken += 1;
          window.clearTimeout(finishTimer);
          track!.style.transition = "none";
          track!.style.transform = "translate3d(0, 0, 0)";
          dialog.close();
          document.body.style.overflow = "";
        }

        items.forEach((btn, idx) => {
          btn.addEventListener("click", () => open(idx), { signal });
        });

        closeBtn?.addEventListener("click", close, { signal });
        prevBtn?.addEventListener("click", () => animateTo(-1, 0), {
          signal,
        });
        nextBtn?.addEventListener("click", () => animateTo(1, 0), {
          signal,
        });

        slider.addEventListener(
          "pointerdown",
          event => {
            if (event.button !== 0 || animating) return;
            pointerId = event.pointerId;
            dragging = true;
            startX = event.clientX;
            lastRaw = 0;
            lastTime = performance.now();
            velocity = 0;
            displayOffset = 0;
            dragTarget = 0;
            track.style.transition = "none";
            applyOffset();
            try {
              slider.setPointerCapture(event.pointerId);
            } catch {
              /* pointer may already be gone */
            }
            stopFollow();
            followFrame = requestAnimationFrame(follow);
          },
          { signal }
        );

        slider.addEventListener(
          "pointermove",
          event => {
            if (!dragging || event.pointerId !== pointerId) return;
            const width = slider.getBoundingClientRect().width;
            if (!width) return;

            const raw = -(event.clientX - startX) / width;
            const atStart = current === 0;
            const atEnd = current === count - 1;
            if ((atStart && raw < 0) || (atEnd && raw > 0)) {
              dragTarget =
                Math.sign(raw) * (1 - 1 / (Math.abs(raw) * 2.6 + 1)) * 0.48;
            } else {
              dragTarget = Math.max(-1, Math.min(1, raw));
            }

            const now = performance.now();
            const dt = Math.max(8, now - lastTime);
            velocity = (raw - lastRaw) / dt;
            lastRaw = raw;
            lastTime = now;
          },
          { signal }
        );

        const endSwipe = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          pointerId = -1;
          stopFollow();
          try {
            if (slider.hasPointerCapture(event.pointerId)) {
              slider.releasePointerCapture(event.pointerId);
            }
          } catch {
            /* capture may have been released */
          }

          if (performance.now() - lastTime > 90) velocity = 0;
          const projected = dragTarget + velocity * 190;
          let delta = 0;
          if (projected > 0.32 && current < count - 1) delta = 1;
          else if (projected < -0.32 && current > 0) delta = -1;

          animateTo(delta, velocity);
        };

        slider.addEventListener("pointerup", endSwipe, { signal });
        slider.addEventListener("pointercancel", endSwipe, { signal });

        dialog.addEventListener(
          "click",
          e => {
            const target = e.target as HTMLElement;
            if (
              !target.closest(
                "img, button, .lightbox-caption, .lightbox-counter, .lightbox-slider"
              )
            ) {
              close();
            }
          },
          { signal }
        );

        dialog.addEventListener(
          "close",
          () => {
            document.body.style.overflow = "";
          },
          { signal }
        );

        document.addEventListener(
          "keydown",
          e => {
            if (!dialog.open) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") animateTo(-1, 0);
            if (e.key === "ArrowRight") animateTo(1, 0);
          },
          { signal }
        );
      });

    document.addEventListener(
      "astro:before-swap",
      () => {
        document.body.style.overflow = "";
        lightboxController?.abort();
      },
      { once: true, signal }
    );
  }

  initLightboxes();
  document.addEventListener("astro:page-load", initLightboxes);
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: color-mix(in srgb, var(--background) 94%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
    backdrop-filter: blur(20px) saturate(130%);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.5rem 1.75rem;
    min-height: 0;
    gap: 1rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.1rem;
  }

  .lightbox-slider {
    display: flex;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    cursor: grab;
  }

  .lightbox-slider:active {
    cursor: grabbing;
  }

  .lightbox-slider:focus {
    outline: none;
  }

  .lightbox-track {
    display: flex;
    width: 100%;
    min-width: 0;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .lightbox-slide {
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .lightbox-slide[data-empty="true"] {
    opacity: 0;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 12.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.85rem;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.85);
  }

  .lightbox-caption {
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--foreground) 72%, transparent);
    text-align: center;
    max-width: 52ch;
    line-height: 1.55;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    display: grid;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .lightbox-btn:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .lightbox-btn:focus-visible {
    border-radius: 0.4rem;
    outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    outline-offset: 2px;
  }

  .lightbox-nav {
    flex-shrink: 0;
  }

  .lightbox-nav svg {
    width: 2rem;
    height: 2rem;
  }

  @media (max-width: 640px) {
    .lightbox-topbar {
      padding: 0.9rem 1.1rem 0.5rem;
    }

    .lightbox-main {
      position: relative;
      flex-direction: column;
      justify-content: center;
      padding: 0.25rem 1.1rem 4.3rem;
      gap: 0.75rem;
    }

    .lightbox-figure {
      height: auto;
      gap: 0.85rem;
    }

    .lightbox-image {
      max-width: 100%;
      max-height: calc(100dvh - 14rem);
      border-radius: 0.8rem;
    }

    .lightbox-caption {
      padding-inline: 2.4rem;
      font-size: 0.84rem;
    }

    .lightbox-nav {
      position: absolute;
      top: auto;
      bottom: 1.15rem;
      padding: 0.35rem;
    }

    .lightbox-prev {
      left: 1.1rem;
    }

    .lightbox-next {
      right: 1.1rem;
    }

    .lightbox-nav:hover {
      transform: translateY(-1px);
    }

    .lightbox-nav svg {
      width: 1.85rem;
      height: 1.85rem;
    }

    .lightbox-btn[data-lb-close] {
      width: 2.4rem;
      height: 2.4rem;
    }
  }
</style>
