---
type Props = {
  id: string;
  label?: string;
};

const { id, label = "Image viewer" } = Astro.props;
---

<dialog
  id={id}
  class="lightbox"
  data-gallery-lightbox
  aria-label={label}
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span class="lightbox-counter font-firacode" data-lb-counter></span>
      <button
        class="lightbox-btn"
        data-lb-close
        aria-label="Close"
        title="Close (Esc)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav lightbox-prev"
        data-lb-prev
        aria-label="Previous"
        title="Previous (Left Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-slider" data-lb-slider tabindex="-1">
          <div class="lightbox-track" data-lb-track>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                draggable="false"
                data-lb-img-prev
              />
            </div>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                draggable="false"
                data-lb-img
              />
            </div>
            <div class="lightbox-slide" data-lb-slide>
              <img
                src=""
                alt=""
                class="lightbox-image"
                decoding="async"
                draggable="false"
                data-lb-img-next
              />
            </div>
          </div>
          <span class="lightbox-end-note" data-lb-end-note aria-hidden="true">
            - end -
          </span>
        </div>
        <p class="lightbox-caption text-foreground/80" data-lb-caption></p>
      </div>

      <button
        class="lightbox-btn lightbox-nav lightbox-next"
        data-lb-next
        aria-label="Next"
        title="Next (Right Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  let lightboxController: AbortController | null = null;

  function initLightboxes() {
    lightboxController?.abort();
    lightboxController = new AbortController();
    const { signal } = lightboxController;
    const dialogCleanups: Array<() => void> = [];

    document
      .querySelectorAll<HTMLDialogElement>("[data-gallery-lightbox]")
      .forEach(dialog => {
        const items = Array.from(
          document.querySelectorAll<HTMLButtonElement>(
            `button[data-lb="${dialog.id}"]`
          )
        );
        if (items.length === 0) return;

        const lbImg = dialog.querySelector<HTMLImageElement>("[data-lb-img]");
        const lbPrevImg =
          dialog.querySelector<HTMLImageElement>("[data-lb-img-prev]");
        const lbNextImg =
          dialog.querySelector<HTMLImageElement>("[data-lb-img-next]");
        const slider = dialog.querySelector<HTMLElement>("[data-lb-slider]");
        const track = dialog.querySelector<HTMLElement>("[data-lb-track]");
        const lbCaption =
          dialog.querySelector<HTMLElement>("[data-lb-caption]");
        const lbCounter =
          dialog.querySelector<HTMLElement>("[data-lb-counter]");
        const closeBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-close]");
        const prevBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-prev]");
        const nextBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-next]");

        if (!lbImg || !lbPrevImg || !lbNextImg || !slider || !track) return;

        const count = items.length;
        let current = 0;
        let displayOffset = 0;
        let dragTarget = 0;
        let dragging = false;
        let queueSwipe = false;
        let queueSwipeRaw = 0;
        let animating = false;
        let animTarget = 0;
        let queuedDelta = 0;
        let pointerId = -1;
        let startX = 0;
        let lastRaw = 0;
        let lastTime = 0;
        let velocity = 0;
        let followFrame = 0;
        let finishTimer = 0;
        let bounceTimer = 0;
        let bounceToken = 0;
        let animationToken = 0;
        let lastCaption = "";

        const imageAt = (idx: number) =>
          items[(idx + count) % count]?.querySelector("img");

        // srcset carries the real viewer-sized variants. `img.src` on an
        // Astro <Image> is the original multi-megapixel file, so never use it
        // for the viewer.
        const largestSrcset = (img: HTMLImageElement | null) => {
          const srcset = img?.getAttribute("srcset");
          if (srcset) {
            let best = "";
            let bestWidth = -1;
            for (const candidate of srcset.split(",")) {
              const [url, descriptor = ""] = candidate.trim().split(/\s+/);
              const width = Number.parseFloat(descriptor) || 0;
              if (url && width > bestWidth) {
                bestWidth = width;
                best = url;
              }
            }
            if (best) return best;
          }
          return img?.currentSrc || img?.src || "";
        };

        const lightboxSrc = (idx: number) => {
          const button = items[(idx + count) % count];
          if (!button) return "";
          return (
            button.dataset.lbSrc || largestSrcset(button.querySelector("img"))
          );
        };

        const preloaded = new Map<string, HTMLImageElement>();
        const warm = (idx: number) => {
          const src = lightboxSrc(idx);
          if (!src || preloaded.has(src)) return;
          const cache = new Image();
          cache.decoding = "async";
          cache.src = src;
          preloaded.set(src, cache);
        };
        const warmAround = (idx: number, radius: number) => {
          for (let offset = -radius; offset <= radius; offset += 1) {
            const target = idx + offset;
            if (target >= 0 && target < count) warm(target);
          }
        };

        let warmTimer = 0;
        const stopWarm = () => {
          window.clearTimeout(warmTimer);
          warmTimer = 0;
        };
        const warmRest = () => {
          stopWarm();
          let next = 0;
          const step = () => {
            warmTimer = 0;
            if (!dialog.open) return;
            let batch = 0;
            while (next < count && batch < 2) {
              warm(next);
              next += 1;
              batch += 1;
            }
            if (next < count) warmTimer = window.setTimeout(step, 120);
          };
          step();
        };

        const setSlideImage = (
          element: HTMLImageElement,
          idx: number,
          empty: boolean
        ) => {
          const slide = element.parentElement;
          if (empty) {
            slide?.setAttribute("data-empty", "true");
            return;
          }
          const img = imageAt(idx);
          const src = lightboxSrc(idx);
          if (src && element.getAttribute("src") !== src) {
            element.src = src;
          }
          element.alt = img?.alt ?? "";
          slide?.setAttribute("data-empty", "false");
        };

        const shiftFor = (offset: number) =>
          `translate3d(calc(${-(1 + offset)} * (100% + var(--lb-gap))), 0, 0)`;

        const trackStepWidth = () => {
          const gap =
            Number.parseFloat(getComputedStyle(track).columnGap || "0") || 0;
          return slider.getBoundingClientRect().width + gap;
        };

        const updateCaption = () => {
          const img = imageAt(current);
          if (!lbCaption || !img) return;
          const caption = img.alt.trim();
          const hasCaption = caption.length > 0 && !/^\d+$/.test(caption);
          const nextCaption = hasCaption ? caption : "";
          if (nextCaption === lastCaption) {
            lbCaption.hidden = !hasCaption;
            return;
          }
          lastCaption = nextCaption;
          lbCaption.textContent = nextCaption;
          lbCaption.hidden = !hasCaption;
        };

        const applyOffset = () => {
          track.style.transform = shiftFor(displayOffset);
          slider.dataset.atEnd = String(current === count - 1);
        };

        const follow = () => {
          if (!dragging) return;
          displayOffset += (dragTarget - displayOffset) * 0.32;
          applyOffset();
          followFrame = requestAnimationFrame(follow);
        };

        const stopFollow = () => {
          window.cancelAnimationFrame(followFrame);
          followFrame = 0;
        };

        const stopBounce = () => {
          bounceToken += 1;
          window.clearTimeout(bounceTimer);
          bounceTimer = 0;
        };

        // A short, damped pull towards the missing side. The button stays
        // clickable at the endpoints so the limit is something you can feel,
        // not a dead control that silently swallows the click.
        const bounceEdge = (direction: number) => {
          if (dragging || !dialog.open) return;
          stopBounce();
          const token = bounceToken;
          const peak = direction < 0 ? -0.055 : 0.055;
          track.style.transition =
            "transform 130ms cubic-bezier(0.22, 0.7, 0.3, 1)";
          track.style.transform = shiftFor(peak);
          bounceTimer = window.setTimeout(() => {
            if (token !== bounceToken) return;
            track.style.transition =
              "transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1)";
            track.style.transform = shiftFor(0);
            bounceTimer = window.setTimeout(() => {
              if (token !== bounceToken) return;
              track.style.transition = "none";
            }, 430);
          }, 130);
        };

        const renderSlides = () => {
          stopBounce();
          setSlideImage(lbPrevImg, current - 1, current === 0);
          setSlideImage(lbImg, current, false);
          setSlideImage(lbNextImg, current + 1, current === count - 1);

          if (lbCounter) {
            lbCounter.textContent = `${current + 1} / ${count}`;
          }
          updateCaption();
          if (prevBtn) {
            const atStart = current === 0;
            prevBtn.classList.toggle("is-disabled", atStart);
            prevBtn.setAttribute("aria-disabled", String(atStart));
          }
          if (nextBtn) {
            const atEnd = current === count - 1;
            nextBtn.classList.toggle("is-disabled", atEnd);
            nextBtn.setAttribute("aria-disabled", String(atEnd));
          }

          displayOffset = 0;
          dragTarget = 0;
          slider.dataset.atEnd = String(current === count - 1);
          track.style.transition = "none";
          track.style.transform = shiftFor(0);
          warmAround(current, 2);
        };
        const finishAnimation = (delta: number) => {
          window.clearTimeout(finishTimer);
          if (!animating) return;
          animating = false;
          animationToken += 1;
          if (delta !== 0) {
            current = Math.max(0, Math.min(count - 1, current + delta));
          }
          animTarget = current;
          renderSlides();

          if (queuedDelta !== 0) {
            const next = Math.sign(queuedDelta);
            queuedDelta -= next;
            window.requestAnimationFrame(() => {
              if (!dialog.open) {
                queuedDelta = 0;
                return;
              }
              animateTo(next, 0);
            });
          }
        };

        const animateTo = (delta: number, releaseVelocity: number) => {
          const step = Math.sign(delta);

          if (animating) {
            if (!step) return;
            // Every gesture should count: queue it against the in-flight
            // destination instead of dropping it while the slide animates.
            const projected = animTarget + queuedDelta + step;
            if (projected < 0 || projected > count - 1) return;
            queuedDelta += step;
            return;
          }

          const target = Math.max(0, Math.min(count - 1, current + step));
          const actualDelta = target - current;

          if (actualDelta === 0) {
            if (step !== 0) {
              bounceEdge(step);
              return;
            }
            if (Math.abs(displayOffset) < 0.01) {
              renderSlides();
              return;
            }
            // A short drag that did not reach the commit threshold settles
            // back under the finger instead of snapping.
            stopBounce();
            animating = true;
            animTarget = current;
            const settleToken = ++animationToken;
            track.style.transition =
              "transform 320ms cubic-bezier(0.22, 1, 0.36, 1)";
            requestAnimationFrame(() => {
              if (settleToken !== animationToken) return;
              track.style.transform = shiftFor(0);
            });
            const settle = () => {
              if (settleToken !== animationToken) return;
              animating = false;
              renderSlides();
            };
            track.addEventListener("transitionend", settle, { once: true });
            finishTimer = window.setTimeout(settle, 360);
            return;
          }

          stopBounce();
          animating = true;
          animTarget = target;
          const token = ++animationToken;
          const speed = Math.min(1, Math.abs(releaseVelocity) * 220);
          const duration = 300 + Math.round(speed * 150);
          track.style.transition = `transform ${duration}ms cubic-bezier(0.22, 1, 0.36, 1)`;
          // Let the browser paint the current dragged position first.
          requestAnimationFrame(() => {
            if (token !== animationToken) return;
            track.style.transform = shiftFor(actualDelta);
          });

          const finish = () => {
            if (token !== animationToken) return;
            finishAnimation(actualDelta);
          };
          track.addEventListener("transitionend", finish, { once: true });
          finishTimer = window.setTimeout(finish, duration + 40);
        };

        const go = (direction: number) => {
          if (!dialog.open) return;
          if (!animating) {
            if (direction < 0 && current === 0) {
              bounceEdge(-1);
              return;
            }
            if (direction > 0 && current === count - 1) {
              bounceEdge(1);
              return;
            }
          }
          animateTo(direction, 0);
        };

        function open(idx: number) {
          current = Math.max(0, Math.min(idx, count - 1));
          animTarget = current;
          queuedDelta = 0;
          queueSwipe = false;
          stopBounce();
          stopWarm();
          renderSlides();
          if (!dialog.open) dialog.showModal();
          slider?.focus({ preventScroll: true });
          document.body.style.overflow = "hidden";
          // The clicked image is already in the grid cache; this warms the
          // neighbours immediately and the rest of the set while it is open.
          warmAround(current, 3);
          warmRest();
        }

        function close() {
          stopFollow();
          stopWarm();
          stopBounce();
          dragging = false;
          queueSwipe = false;
          animating = false;
          animTarget = current;
          queuedDelta = 0;
          animationToken += 1;
          window.clearTimeout(finishTimer);
          track!.style.transition = "none";
          track!.style.transform = shiftFor(0);
          if (dialog.open) dialog.close();
          document.body.style.overflow = "";
        }

        items.forEach((btn, idx) => {
          btn.addEventListener("click", () => open(idx), { signal });
          btn.addEventListener("pointerenter", () => warmAround(idx, 1), {
            signal,
          });
          btn.addEventListener("focus", () => warmAround(idx, 1), { signal });
        });

        closeBtn?.addEventListener("click", close, { signal });
        prevBtn?.addEventListener("click", () => go(-1), { signal });
        nextBtn?.addEventListener("click", () => go(1), { signal });

        // Escape must run the same close path as the X button; the native
        // dialog cancel would otherwise skip the track reset.
        dialog.addEventListener(
          "cancel",
          event => {
            event.preventDefault();
            close();
          },
          { signal }
        );

        window.addEventListener(
          "resize",
          () => {
            if (!dialog.open || animating) return;
            track.style.transition = "none";
            applyOffset();
          },
          { signal }
        );

        slider.addEventListener(
          "pointerdown",
          event => {
            if (event.button !== 0) return;

            // A second swipe may start while the previous slide is still
            // animating. Record it so it can be queued, but don't disturb the
            // in-flight transform.
            queueSwipe = animating;
            pointerId = event.pointerId;
            dragging = true;
            startX = event.clientX;
            lastRaw = 0;
            lastTime = performance.now();
            velocity = 0;
            queueSwipeRaw = 0;

            if (!queueSwipe) {
              stopBounce();
              displayOffset = 0;
              dragTarget = 0;
              track.style.transition = "none";
              applyOffset();
              stopFollow();
              followFrame = requestAnimationFrame(follow);
            }

            try {
              slider.setPointerCapture(event.pointerId);
            } catch {
              /* pointer may already be gone */
            }
          },
          { signal }
        );

        slider.addEventListener(
          "pointermove",
          event => {
            if (!dragging || event.pointerId !== pointerId) return;
            const step = trackStepWidth();
            if (!step) return;

            const raw = -(event.clientX - startX) / step;
            const now = performance.now();
            const dt = Math.max(8, now - lastTime);
            velocity = (raw - lastRaw) / dt;
            lastRaw = raw;
            lastTime = now;
            queueSwipeRaw = raw;

            if (queueSwipe) return;

            const atStart = current === 0;
            const atEnd = current === count - 1;
            if ((atStart && raw < 0) || (atEnd && raw > 0)) {
              dragTarget =
                Math.sign(raw) * (1 - 1 / (Math.abs(raw) * 2.6 + 1)) * 0.48;
            } else {
              dragTarget = Math.max(-1, Math.min(1, raw));
            }
          },
          { signal }
        );

        const endSwipe = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;
          const queued = queueSwipe;
          queueSwipe = false;
          dragging = false;
          pointerId = -1;
          stopFollow();
          try {
            if (slider.hasPointerCapture(event.pointerId)) {
              slider.releasePointerCapture(event.pointerId);
            }
          } catch {
            /* capture may have been released */
          }

          if (performance.now() - lastTime > 90) velocity = 0;
          const projected =
            (queued ? queueSwipeRaw : dragTarget) + velocity * 190;
          let delta = 0;
          if (projected > 0.22 && current < count - 1) delta = 1;
          else if (projected < -0.22 && current > 0) delta = -1;

          animateTo(delta, velocity);
        };

        slider.addEventListener("pointerup", endSwipe, { signal });
        slider.addEventListener("pointercancel", endSwipe, { signal });

        dialog.addEventListener(
          "close",
          () => {
            document.body.style.overflow = "";
          },
          { signal }
        );

        document.addEventListener(
          "keydown",
          e => {
            if (!dialog.open) return;
            if (e.key === "Escape") {
              e.preventDefault();
              close();
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              go(-1);
            } else if (e.key === "ArrowRight") {
              e.preventDefault();
              go(1);
            }
          },
          { signal }
        );

        dialogCleanups.push(() => {
          stopWarm();
          stopBounce();
        });
      });

    document.addEventListener(
      "astro:before-swap",
      () => {
        document.body.style.overflow = "";
        dialogCleanups.forEach(cleanup => cleanup());
        lightboxController?.abort();
      },
      { once: true, signal }
    );
  }

  initLightboxes();
  document.addEventListener("astro:page-load", initLightboxes);
</script>

<style>
  .lightbox {
    --lb-gap: 2.2rem;

    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: color-mix(in srgb, var(--background) 94%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
    backdrop-filter: blur(20px) saturate(130%);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.5rem 1.75rem;
    min-height: 0;
    gap: 1rem;
  }

  .lightbox-figure {
    flex: 1;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    width: 100%;
    height: 100%;
    gap: 1.1rem;
  }

  .lightbox-slider {
    position: relative;
    display: flex;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    cursor: grab;
  }

  .lightbox-slider:active {
    cursor: grabbing;
  }

  .lightbox-slider:focus {
    outline: none;
  }

  .lightbox-track {
    display: flex;
    gap: var(--lb-gap);
    width: 100%;
    min-width: 0;
    will-change: transform;
    transform: translate3d(calc(-1 * (100% + var(--lb-gap))), 0, 0);
  }

  .lightbox-slide {
    position: relative;
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    min-width: 0;
    background: transparent;
  }

  .lightbox-slide[data-empty="true"] .lightbox-image {
    visibility: hidden;
  }

  .lightbox-end-note {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: color-mix(in srgb, var(--foreground) 22%, transparent);
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transform: translateY(-50%);
    transition: opacity 0.15s ease;
  }

  .lightbox-slider[data-at-end="true"] .lightbox-end-note {
    opacity: 1;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 12.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow:
      0 18px 40px -30px rgba(0, 0, 0, 0.45),
      0 2px 10px -8px rgba(0, 0, 0, 0.25);
    -webkit-user-drag: none;
    user-select: none;
  }

  .lightbox-caption {
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--foreground) 72%, transparent);
    text-align: center;
    max-width: 52ch;
    line-height: 1.55;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    display: grid;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .lightbox-btn:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .lightbox-nav.is-disabled,
  .lightbox-nav.is-disabled:hover {
    color: color-mix(in srgb, var(--foreground) 20%, transparent);
    transform: none;
  }

  .lightbox-btn:focus-visible {
    border-radius: 0.4rem;
