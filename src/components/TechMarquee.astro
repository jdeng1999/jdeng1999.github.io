---
/**
 * TechMarquee — two continuous tickers that glide in opposite directions.
 * Row one groups backend / infrastructure work, row two groups the frontend
 * and tooling side of the stack. Full-colour brand logos live in `public/tech/`.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = "Tech Stack", class: className = "" } = Astro.props;

const rows = [
  [
    { name: "Java", icon: "java" },
    { name: "Spring Cloud", icon: "springcloud" },
    { name: "Dubbo", icon: "dubbo", ext: ".png", wide: true },
    { name: "MyBatis-Plus", icon: "mybatisplus" },
    { name: "MySQL", icon: "mysql" },
    { name: "PostgreSQL", icon: "postgresql" },
    { name: "Redis", icon: "redis" },
    { name: "Elasticsearch", icon: "elasticsearch" },
    { name: "MongoDB", icon: "mongodb" },
    { name: "RabbitMQ", icon: "rabbitmq" },
    { name: "Maven", icon: "maven" },
    { name: "Docker", icon: "docker" },
    { name: "Nginx", icon: "nginx" },
    { name: "Jenkins", icon: "jenkins" },
    { name: "Linux", icon: "linux" },
    { name: "Git", icon: "git" },
  ],
  [
    { name: "TypeScript", icon: "typescript" },
    { name: "JavaScript", icon: "javascript" },
    { name: "Node.js", icon: "nodejs" },
    { name: "React", icon: "react" },
    { name: "Vue.js", icon: "vue" },
    { name: "Astro", icon: "astro" },
    { name: "Tailwind CSS", icon: "tailwindcss" },
    { name: "Codex", icon: "codex" },
  ],
];

// Repeat each row enough times that the -50% loop never reveals a gap.
const repeats = 4;
---

<div class:list={["tech-marquee", className]} role="region" aria-label={label}>
  {rows.map((row, rowIndex) => (
    <div
      class:list={["marquee", { "marquee-reverse": rowIndex === 1 }]}
      style={`--marquee-duration: ${rowIndex === 1 ? "96s" : "185s"}`}
    >
      <div class="marquee-track">
        {Array.from({ length: repeats }).flatMap((_, copyIndex) =>
          row.map(tech => (
            <div
              class="marquee-item"
              aria-hidden={copyIndex > 0 ? "true" : undefined}
            >
              <img
                class:list={["tech-logo", tech.wide && "tech-logo--wide"]}
                src={`/tech/${tech.icon}${tech.ext ?? ".svg"}`}
                alt=""
                width="32"
                height="32"
                loading={copyIndex === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <span
                class:list={["tech-name", tech.wide && "tech-name--wordmark"]}
              >
                {tech.name}
              </span>
            </div>
          ))
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .tech-marquee {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    min-width: 0;
  }

  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: 0.15rem;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 2.5rem,
      black calc(100% - 2.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 2.5rem,
      black calc(100% - 2.5rem),
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee-scroll var(--marquee-duration, 52s) linear infinite;
    will-change: transform;
  }

  .marquee-reverse .marquee-track {
    animation-direction: reverse;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-item {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
    margin-right: 1.8rem;
    padding: 0.42rem 0.3rem;
  }

  .tech-logo {
    display: block;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  /* Wordmark logos (e.g. DUBBO) keep their wide aspect instead of being
     squeezed into the square icon box. */
  .tech-logo--wide {
    width: auto;
    height: 1.05rem;
  }

  .tech-name {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-foreground) 62%, transparent);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* A wordmark logo already spells the name, so keep the label for screen
     readers only. */
  .tech-name--wordmark {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .marquee-item:hover .tech-logo {
    transform: scale(1.12);
  }

  .marquee-item:hover .tech-name {
    color: color-mix(in srgb, var(--color-accent) 85%, transparent);
  }

  @media (min-width: 640px) {
    .marquee {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
    }

    .marquee-item {
      gap: 0.9rem;
      margin-right: 2.5rem;
      padding: 0.45rem 0.3rem;
    }

    .tech-logo {
      width: 1.85rem;
      height: 1.85rem;
    }

    .tech-logo--wide {
      width: auto;
      height: 1.2rem;
    }

    .tech-name {
      font-size: 0.84rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
    }

    .marquee-track {
      animation: none;
    }

    .marquee-item[aria-hidden="true"] {
      display: none;
    }

    .marquee-item:hover .tech-logo {
      transform: none;
    }
  }

  @media (max-height: 820px) {
    .marquee-item {
      padding-block: 0.28rem;
    }
  }
</style>

<script>
  // Keep both ticker rows running seamlessly across client-side navigations
  // (e.g. a language switch) instead of restarting the animation.
  const MARQUEE_STATE_KEY = "marquee-state";

  const captureMarqueeState = () => {
    const track = document.querySelector<HTMLElement>(".marquee-track");
    const animation = track?.getAnimations()[0];
    if (!animation) return;
    try {
      sessionStorage.setItem(
        MARQUEE_STATE_KEY,
        JSON.stringify({
          time: Number(animation.currentTime ?? 0),
          at: Date.now(),
        })
      );
    } catch {
      /* storage can be unavailable */
    }
  };

  const restoreMarqueeState = () => {
    let raw: string | null = null;
    try {
      raw = sessionStorage.getItem(MARQUEE_STATE_KEY);
      if (raw) sessionStorage.removeItem(MARQUEE_STATE_KEY);
    } catch {
      return;
    }
    if (!raw) return;

    try {
      const { time, at } = JSON.parse(raw) as { time: number; at: number };
      const elapsed = Math.max(0, Date.now() - at);
      document
        .querySelectorAll<HTMLElement>(".marquee-track")
        .forEach(track => {
          const animation = track.getAnimations()[0];
          if (animation) animation.currentTime = Number(time) + elapsed;
        });
    } catch {
      /* ignore malformed state */
    }
  };

  document.addEventListener("astro:before-swap", captureMarqueeState);
  document.addEventListener("astro:page-load", restoreMarqueeState);
</script>
