---
/**
 * TechMarquee — a single, continuous ticker of the tech stack.
 * Full-colour brand logos live in `public/tech/`, and each skill is rendered
 * as a compact glass tile so the strip reads as a row of blocks.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = "Tech Stack", class: className = "" } = Astro.props;

const stack = [
  { name: "Java", icon: "java" },
  { name: "Spring Boot", icon: "springboot" },
  { name: "MySQL", icon: "mysql" },
  { name: "Redis", icon: "redis" },
  { name: "Maven", icon: "maven" },
  { name: "Docker", icon: "docker" },
  { name: "Linux", icon: "linux" },
  { name: "Git", icon: "git" },
  { name: "TypeScript", icon: "typescript" },
  { name: "JavaScript", icon: "javascript" },
  { name: "Node.js", icon: "nodejs" },
  { name: "Astro", icon: "astro" },
  { name: "React", icon: "react" },
  { name: "Tailwind CSS", icon: "tailwindcss" },
];

const items = [...stack, ...stack];
---

<div class:list={["tech-marquee", className]} role="region" aria-label={label}>
  <div class="marquee">
    <div class="marquee-track">
      {items.map((tech, index) => (
        <div
          class="marquee-item"
          aria-hidden={index >= stack.length ? "true" : undefined}
        >
          <img
            class="tech-logo"
            src={`/tech/${tech.icon}.svg`}
            alt=""
            width="32"
            height="32"
            loading={index < stack.length ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: 0.35rem;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 2.5rem,
      black calc(100% - 2.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 2.5rem,
      black calc(100% - 2.5rem),
      transparent 100%
    );
  }

  .marquee-track {
    --marquee-duration: 52s;

    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-item {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.7rem;
    margin-right: 0.7rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 9%, transparent);
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 2.5%,
      var(--color-background)
    );
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .marquee-item:hover {
    border-color: color-mix(in srgb, var(--color-accent) 32%, transparent);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    box-shadow: 0 10px 24px -20px
      color-mix(in srgb, var(--color-accent) 80%, transparent);
    transform: translateY(-1px);
  }

  .tech-logo {
    display: block;
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  .tech-name {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-foreground) 62%, transparent);
    white-space: nowrap;
  }

  .marquee-item:hover .tech-logo {
    transform: scale(1.1);
  }

  @media (min-width: 640px) {
    .marquee {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
    }

    .marquee-item {
      gap: 0.8rem;
      margin-right: 0.8rem;
      padding: 0.7rem 1.1rem;
    }

    .tech-logo {
      width: 1.85rem;
      height: 1.85rem;
    }

    .tech-name {
      font-size: 0.84rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
    }

    .marquee-track {
      animation: none;
    }

    .marquee-item[aria-hidden="true"] {
      display: none;
    }

    .marquee-item:hover {
      transform: none;
    }
  }
</style>
