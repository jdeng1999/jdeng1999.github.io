---
/**
 * TechMarquee — a single, continuous ticker of the tech stack.
 * Logos are monochrome CSS masks so they adapt to both themes and the
 * active accent color. Hovering only scales the icon; the track never stops.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = "Tech Stack", class: className = "" } = Astro.props;

const stack = [
  { name: "Java", icon: "java" },
  { name: "Spring Boot", icon: "springboot" },
  { name: "MySQL", icon: "mysql" },
  { name: "Redis", icon: "redis" },
  { name: "Maven", icon: "maven" },
  { name: "Docker", icon: "docker" },
  { name: "Linux", icon: "linux" },
  { name: "Git", icon: "git" },
  { name: "TypeScript", icon: "typescript" },
  { name: "JavaScript", icon: "javascript" },
  { name: "Node.js", icon: "nodejs" },
  { name: "Astro", icon: "astro" },
  { name: "React", icon: "react" },
  { name: "Tailwind CSS", icon: "tailwindcss" },
];

const items = [...stack, ...stack];
---

<div class:list={["tech-marquee", className]} role="region" aria-label={label}>
  <div class="marquee">
    <div class="marquee-track">
      {items.map((tech, index) => (
        <div
          class="marquee-item"
          aria-hidden={index >= stack.length ? "true" : undefined}
        >
          <span
            class="tech-logo"
            style={`--tech-icon: url('/svg/${tech.icon}.svg')`}
            aria-hidden="true"
          />
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 3rem,
      black calc(100% - 3rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 3rem,
      black calc(100% - 3rem),
      transparent 100%
    );
  }

  .marquee-track {
    --marquee-duration: 44s;

    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-item {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    padding: 0.9rem 1.4rem;
  }

  .tech-logo {
    --tech-icon: none;

    display: block;
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    background-color: color-mix(
      in srgb,
      var(--color-foreground) 72%,
      transparent
    );
    -webkit-mask-image: var(--tech-icon);
    mask-image: var(--tech-icon);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    transition: transform 0.25s ease;
  }

  .tech-name {
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-foreground) 62%, transparent);
    white-space: nowrap;
  }

  .marquee-item:hover .tech-logo {
    transform: scale(1.2);
  }

  @media (min-width: 640px) {
    .marquee {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 4rem,
        black calc(100% - 4rem),
        transparent 100%
      );
    }

    .marquee-item {
      gap: 0.75rem;
      padding: 1rem 1.85rem;
    }

    .tech-logo {
      width: 1.5rem;
      height: 1.5rem;
    }

    .tech-name {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
    }

    .marquee-track {
      animation: none;
    }

    .marquee-item[aria-hidden="true"] {
      display: none;
    }
  }
</style>
