---
import type { HTMLAttributes } from "astro/types";
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import FooterLike from "./FooterLike.astro";
import NowPlaying from "./NowPlaying.astro";
import SiteLogo from "./SiteLogo.astro";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/utils";

const currentYear = new Date().getFullYear();

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const socialLinks = SOCIALS.map(social => ({
  ...social,
  isExternal: /^https?:\/\//.test(social.href),
}));

const credits = [
  {
    label: t("footer.builtWith"),
    name: "Astro",
    icon: "astro",
    href: "https://astro.build/",
  },
  {
    label: t("footer.styledWith"),
    name: "Tailwind CSS",
    icon: "tailwindcss",
    href: "https://tailwindcss.com/",
  },
  {
    label: t("footer.deployedOn"),
    name: "GitHub Pages",
    icon: "github",
    href: "https://pages.github.com/",
  },
];

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["footer-wrapper", { "mt-auto": !noMarginTop }, className]}
  role="contentinfo"
  {...attrs}
>
  <!-- Top gradient border -->
  <div class="h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent"></div>

  <div class="app-layout py-10 sm:py-12">
    <!-- Main footer: brand + connect on the left, credits in the middle, music on the right -->
    <div class="footer-grid">
      <div class="footer-identity">
        <!-- Brand column -->
        <div class="footer-brand flex flex-col items-center gap-4 sm:items-start">
          <a
            href={locale === "es" ? "/es" : locale === "zh" ? "/zh" : "/"}
            aria-label={
              locale === "es"
                ? `Ir al inicio de ${SITE.title}`
                : `Go to home of ${SITE.title}`
            }
            class="group footer-home-link relative flex items-center gap-2 rounded-md"
          >
            <SiteLogo class="text-[1.7rem] opacity-90 transition-opacity duration-300 group-hover:opacity-100" />
            <span class="sr-only">{SITE.title}</span>
          </a>
        </div>

        <!-- Connect: social links and the shared like counter -->
        <div class="footer-connect flex flex-col items-center gap-3 sm:items-start">
          <nav class="flex flex-col items-center gap-3 sm:items-start">
            <ul class="footer-socials flex items-center gap-3" role="list">
              {socialLinks.map(social => (
                <li>
                  <LinkButton
                    href={social.href}
                    target={social.isExternal ? "_blank" : undefined}
                    rel={social.isExternal ? "noopener noreferrer" : undefined}
                    aria-label={social.linkTitle}
                    class="footer-social-btn group relative flex size-8 items-center justify-center text-foreground/45 transition-colors duration-200 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:outline-none"
                  >
                    <social.icon class="size-[1.35rem] fill-current" />
                    <span class="sr-only">{social.linkTitle}</span>
                  </LinkButton>
                </li>
              ))}
            </ul>
          </nav>

          {SITE.likes.enabled && (
            <FooterLike
              base={SITE.likes.base}
              likeLabel={t("footer.likes")}
              ariaLabel={t("footer.likeSite")}
            />
          )}
        </div>
      </div>

      <!-- Credits and references -->
      <div class="footer-meta">
        <ul class="footer-credits" role="list">
          {credits.map(credit => (
            <li class="footer-credit-row">
              <span class="footer-credit-label">{credit.label}</span>
              <span
                class="footer-credit-icon"
                style={`--credit-icon: url('/svg/${credit.icon}.svg')`}
                aria-hidden="true"
              />
              <a
                class="footer-credit-name"
                href={credit.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {credit.name}
              </a>
            </li>
          ))}
        </ul>

        <p class="footer-references">
          <span class="footer-references-label">{t("footer.inspiredBy")}</span>
          <span class="footer-references-links">
            <a
              href="https://devosfera.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Devosfera
              <span class="footer-reference-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
            <span class="footer-reference-sep" aria-hidden="true">
              ·
            </span>
            <a
              href="https://darkminimal.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Dark Minimal
              <span class="footer-reference-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </span>
        </p>
      </div>

      <!-- Music -->
      {SITE.spotify.enabled && (
        <div id="site-music-player" class="footer-music" transition:persist>
          <NowPlaying
            label={t("footer.listening")}
            enjoyLabel={t("footer.enjoy")}
            openLabel={t("footer.openSpotify")}
            playLabel={t("footer.play")}
            pauseLabel={t("footer.pause")}
            restartLabel={t("footer.restart")}
            seekLabel={t("footer.seek")}
            previewLabel={t("footer.preview")}
            previousLabel={t("footer.previous")}
            nextLabel={t("footer.next")}
            modeLabel={t("footer.playMode")}
            orderLabel={t("footer.modeOrder")}
            repeatLabel={t("footer.modeRepeat")}
            shuffleLabel={t("footer.modeShuffle")}
            class="w-full"
          />
        </div>
      )}
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 flex items-center gap-3" aria-hidden="true">
      <div class="h-px flex-1 bg-linear-to-r from-transparent via-border/25 to-transparent"></div>
    </div>

    <div class="mt-4 text-center">
      <p class="footer-copyright">
        <svg
          class="footer-copyright-mark"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M15.6 8.2a4.8 4.8 0 1 0 0 7.6"></path>
        </svg>
        <span class="sr-only">{t("footer.copyright")}</span>
        <span>
          {currentYear} {SITE.title}. {t("footer.rights")}
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    position: relative;
    isolation: isolate;
    /* Soft gradient descending to bottom */
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--background) 30%, transparent),
      color-mix(in srgb, var(--background) 80%, transparent) 80%
    );
  }

  @supports (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .footer-wrapper {
      backdrop-filter: blur(12px) saturate(140%);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
    }
  }

  .footer-home-link {
    outline-offset: 4px;
  }

  .footer-connect {
    gap: 0.7rem;
  }

  .footer-socials {
    gap: 0.3rem;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }

  .footer-references {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28rem;
    width: 100%;
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-foreground) 8%, transparent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  .footer-references-label {
    color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
    font-size: 0.6rem;
  }

  .footer-references-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    font-size: 0.64rem;
  }

  .footer-references-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.16rem;
    color: color-mix(in srgb, var(--color-foreground) 68%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-references-links a:hover {
    color: var(--color-accent);
  }

  .footer-references-links a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 3px;
  }

  .footer-reference-arrow {
    font-size: 0.52rem;
    opacity: 0.45;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .footer-references-links a:hover .footer-reference-arrow,
  .footer-references-links a:focus-visible .footer-reference-arrow {
    opacity: 1;
    transform: translate(0.08rem, -0.08rem);
  }

  .footer-reference-sep {
    color: color-mix(in srgb, var(--color-foreground) 24%, transparent);
    font-size: 0.58rem;
  }

  .footer-copyright {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  .footer-copyright-mark {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: color-mix(in srgb, var(--color-foreground) 64%, transparent);
    transform: translateY(-0.01em);
  }

  /* Footer layout: brand + connect | credits | music */
  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-identity {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .footer-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 1rem 1.5rem;
    }

    .footer-identity {
      min-width: 0;
      justify-self: start;
    }

    .footer-connect {
      align-self: flex-end;
    }

    .footer-credits {
      margin: 0;
    }

    .footer-meta {
      justify-self: center;
    }

    :global(.footer-music) {
      width: min(26rem, 100%);
      max-width: 100%;
      justify-self: end;
    }
  }

  @media (min-width: 1024px) and (max-width: 1599px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 21rem);
    }
  }

  @media (min-width: 1280px) {
    .footer-connect {
      align-self: flex-start;
    }
  }

  :global(.footer-music) {
    container-type: inline-size;
  }

  .footer-social-btn {
    border-radius: 0.4rem;
  }

  :global(#site-music-player .np-controls) {
    gap: 0.5rem;
  }

  .footer-credits {
    display: grid;
    grid-template-columns: max-content 0.95rem max-content;
    align-items: center;
    justify-content: start;
    align-self: center;
    justify-self: center;
    row-gap: 0.72rem;
    column-gap: 0.5rem;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-credit-row {
    display: contents;
  }

  .footer-credit-label {
    grid-column: 1;
    text-align: left;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.02em;
  }

  .footer-credit-name {
    grid-column: 3;
    text-align: left;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-foreground) 74%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-credit-name:hover {
    color: var(--color-accent);
  }

  .footer-credit-name:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 3px;
  }

  .footer-credit-icon {
    width: 0.95rem;
    height: 0.95rem;
    grid-column: 2;
    justify-self: center;
    flex: none;
    background-color: color-mix(
      in srgb,
      var(--color-foreground) 52%,
      transparent
    );
    -webkit-mask-image: var(--credit-icon);
    mask-image: var(--credit-icon);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  @media (max-width: 1023px) {
    .footer-credits {
      align-self: center;
      justify-self: center;
      gap: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social-btn {
      transition: none;
    }
  }
</style>
