---
/**
 * CodeGlitch — canvas of continuously morphing characters, inspired by the
 * "LetterGlitch" visual. The character field is clipped to the site's 邓 mark
 * (sampled from the favicon) with a soft, ragged dissolve. Rendered with plain
 * canvas (no framework) and wired to the site theme tokens, so it follows
 * light/dark and accent changes.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={["code-glitch-panel", className]}
  data-code-glitch
  aria-hidden="true"
  transition:persist
>
  <div class="glitch-canvas-wrap">
    <canvas data-glitch-canvas></canvas>
  </div>
</div>

<script>
  type RGB = { r: number; g: number; b: number };
  type Letter = {
    char: string;
    color: RGB;
    target: RGB;
    progress: number;
    /** 0 = inside the glyph (bright ink), 1 = edge / spill (full palette). */
    zone: 0 | 1;
    alpha: number;
  };

  const GLYPHS =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*()_+-=[]{};:<>/".split("");

  const CHAR_WIDTH = 8;
  const CHAR_HEIGHT = 12;
  const FONT_SIZE = 11;
  const GLITCH_INTERVAL = 55;

  // The browser-tab mark is the shape reference: its gold glyph on a
  // transparent canvas is sampled as a coverage mask.
  const GLYPH_SRC = "/apple-touch-icon.png";
  const GLYPH_INK = { x: 10, y: 18, w: 159, h: 155 };
  const GLYPH_FIT = 0.8;
  const GLYPH_TOP = 0.03;
  const GLYPH_STRETCH = 1.3;

  // Right-hand 阝: a slimmer, longer final stem that reaches below the left
  // 又 and past the old glyph box, drawn in the same mask as the mark.
  const TAIL_X = 155;
  const TAIL_TOP = 132;
  const TAIL_TOP_WIDTH = 14;
  const TAIL_BOTTOM_WIDTH = 7;
  const TAIL_END = 0.965;

  // A gentle weight lift for the 又 top-left corner.
  const BOOST = { x: 36, y: 52, rx: 30, ry: 26, amount: 0.18 };

  let dispose: (() => void) | null = null;

  const init = () => {
    const root = document.querySelector<HTMLElement>("[data-code-glitch]");

    // The module script can run before or after `astro:page-load`;
    // guard against initializing the same root twice.
    if (root?.dataset.glitchReady === "true") return;

    dispose?.();
    dispose = null;

    const canvas = root?.querySelector("[data-glitch-canvas]");
    const stage = canvas?.parentElement;

    if (!root || !(canvas instanceof HTMLCanvasElement) || !stage) return;

    root.dataset.glitchReady = "true";

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let reduced = motion.matches;

    let columns = 0;
    let rows = 0;
    let letters: Letter[] = [];
    let palette: RGB[] = [];
    let paletteBright: RGB[] = [];
    let glyph: HTMLImageElement | null = null;
    let glyphFailed = false;
    let disposed = false;
    let coverage: Float32Array | null = null;
    let frame = 0;
    let running = false;
    let lastGlitch = 0;
    let resizeFrame = 0;
    let lastWidth = 0;
    let lastHeight = 0;

    const parseColor = (value: string): RGB | null => {
      const input = value.trim();
      if (!input) return null;

      const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(input);
      if (hex) {
        let h = hex[1];
        if (h.length === 3) {
          h = h
            .split("")
            .map(c => c + c)
            .join("");
        }
        return {
          r: parseInt(h.slice(0, 2), 16),
          g: parseInt(h.slice(2, 4), 16),
          b: parseInt(h.slice(4, 6), 16),
        };
      }

      const rgb = /^rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/i.exec(input);
      if (rgb) {
        return { r: Number(rgb[1]), g: Number(rgb[2]), b: Number(rgb[3]) };
      }

      return null;
    };

    const readPalette = () => {
      const styles = window.getComputedStyle(document.documentElement);
      const accent = parseColor(styles.getPropertyValue("--accent"));
      const bg = parseColor(styles.getPropertyValue("--background"));

      // All code shades are derived from the site accent, not a parallel
      // palette: the accent itself, a deeper mix toward the page, and a faint
      // mix that only appears in the dissolve halo.
      const base: RGB = accent ?? { r: 0, g: 143, b: 236 };
      const mix = (a: RGB, b: RGB, t: number): RGB => ({
        r: Math.round(a.r + (b.r - a.r) * t),
        g: Math.round(a.g + (b.g - a.g) * t),
        b: Math.round(a.b + (b.b - a.b) * t),
      });

      palette = bg
        ? [base, mix(base, bg, 0.38), mix(base, bg, 0.66)]
        : [
            base,
            mix(base, { r: 255, g: 255, b: 255 }, 0.3),
            mix(base, { r: 0, g: 0, b: 0 }, 0.35),
          ];

      // The glyph's interior needs ink that actually contrasts with the page:
      // on dark that is the accent plus its mid shade; on light it is the
      // darker accent (the pale mixes stay in the dissolve halo).
      const luminance = (c: RGB) => {
        const channel = (value: number) => {
          const v = value / 255;
          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        };
        return (
          0.2126 * channel(c.r) + 0.7152 * channel(c.g) + 0.0722 * channel(c.b)
        );
      };
      const contrast = (a: RGB, b: RGB) => {
        const la = luminance(a);
        const lb = luminance(b);
        return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
      };

      if (bg) {
        const strong = palette.filter(c => contrast(c, bg) >= 2.6);
        paletteBright = strong.length
          ? strong
          : [
              palette.reduce((best, c) =>
                contrast(c, bg) > contrast(best, bg) ? c : best
              ),
            ];
      } else {
        paletteBright = palette.slice(0, Math.max(1, palette.length - 1));
      }
    };

    const randomGlyph = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

    const randomColor = (zone: 0 | 1 = 1) => {
      const source = zone === 0 ? paletteBright : palette;
      return source[Math.floor(Math.random() * source.length)];
    };

    // Stable per-cell noise so the ragged contour does not flicker.
    const noise = (x: number, y: number) => {
      const n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
      return n - Math.floor(n);
    };

    /**
     * Sample the mark into a per-cell coverage grid. 0 = empty, 1 = solid
     * ink. The glyph is centred and stretched a little horizontally so its
     * strokes survive the 8 x 12 character grid.
     */
    const buildCoverage = (
      cols: number,
      rowCount: number,
      cssWidth: number,
      cssHeight: number
    ) => {
      if (!glyph) return null;

      const SS = 2;
      const mask = document.createElement("canvas");
      mask.width = cols * SS;
      mask.height = rowCount * SS;
      const maskCtx = mask.getContext("2d", { willReadFrequently: true });
      if (!maskCtx) return null;

      // Keep the glyph's real aspect while it lives on an 8 x 12 cell grid.
      const hCells = (cssHeight / CHAR_HEIGHT) * GLYPH_FIT;
      const wCells =
        hCells *
        (CHAR_HEIGHT / CHAR_WIDTH) *
        (GLYPH_INK.w / GLYPH_INK.h) *
        GLYPH_STRETCH;
      const x = ((cssWidth / CHAR_WIDTH - wCells) / 2) * SS;
      const y = ((cssHeight * GLYPH_TOP) / CHAR_HEIGHT) * SS;

      const scaleX = (wCells * SS) / GLYPH_INK.w;
      const scaleY = (hCells * SS) / GLYPH_INK.h;

      // A soft pass widens the contour into a gradual dissolve band.
      maskCtx.filter = "blur(0.8px)";
      maskCtx.drawImage(
        glyph,
        GLYPH_INK.x,
        GLYPH_INK.y,
        GLYPH_INK.w,
        GLYPH_INK.h,
        x,
        y,
        wCells * SS,
        hCells * SS
      );

      // Extend the 阝 stem: taper it thinner than the serif stroke, then let
      // the alpha fall off so the tip dissolves into the code field.
      const tailX = x + (TAIL_X - GLYPH_INK.x) * scaleX;
      const tailTop = y + (TAIL_TOP - GLYPH_INK.y) * scaleY;
      const tailEnd = ((cssHeight * TAIL_END) / CHAR_HEIGHT) * SS;

      if (tailEnd > tailTop) {
        const topHalf = (TAIL_TOP_WIDTH * scaleX) / 2;
        const bottomHalf = (TAIL_BOTTOM_WIDTH * scaleX) / 2;
        const grad = maskCtx.createLinearGradient(0, tailTop, 0, tailEnd);
        grad.addColorStop(0, "rgba(255, 255, 255, 0.95)");
        grad.addColorStop(0.6, "rgba(255, 255, 255, 0.9)");
        grad.addColorStop(1, "rgba(255, 255, 255, 0.04)");

        maskCtx.filter = "blur(0.35px)";
        maskCtx.fillStyle = grad;
        maskCtx.beginPath();
        maskCtx.moveTo(tailX - topHalf, tailTop);
        maskCtx.lineTo(tailX + topHalf, tailTop);
        maskCtx.lineTo(tailX + bottomHalf, tailEnd);
        maskCtx.lineTo(tailX - bottomHalf, tailEnd);
        maskCtx.closePath();
        maskCtx.fill();
      }

      const data = maskCtx.getImageData(0, 0, cols * SS, rowCount * SS).data;
      const cov = new Float32Array(cols * rowCount);

      // Soft, local weight boost for the 又 top-left corner. Only cells that
      // already carry ink are lifted, so the stroke gets fuller without a
      // floating patch of new characters.
      const boostX = x + (BOOST.x - GLYPH_INK.x) * scaleX;
      const boostY = y + (BOOST.y - GLYPH_INK.y) * scaleY;
      const boostRx = BOOST.rx * scaleX;
      const boostRy = BOOST.ry * scaleY;

      for (let cy = 0; cy < rowCount; cy++) {
        for (let cx = 0; cx < cols; cx++) {
          let sum = 0;
          for (let sy = 0; sy < SS; sy++) {
            for (let sx = 0; sx < SS; sx++) {
              const px = ((cy * SS + sy) * cols * SS + (cx * SS + sx)) * 4 + 3;
              sum += data[px] / 255;
            }
          }
          let value = sum / (SS * SS);

          if (value > 0.02) {
            const mx = (cx + 0.5) * SS;
            const my = (cy + 0.5) * SS;
            const dx = (mx - boostX) / boostRx;
            const dy = (my - boostY) / boostRy;
            const d2 = dx * dx + dy * dy;
            if (d2 < 1) value = Math.min(1, value + BOOST.amount * (1 - d2));
          }

          cov[cy * cols + cx] = value;
        }
      }

      return cov;
    };

    const createLetters = () => {
      letters = Array.from({ length: columns * rows }, (_, index) => {
        if (!coverage) {
          // No mask (image failed): keep the original full-grid look.
          const color = randomColor(1);
          return {
            char: randomGlyph(),
            color: { ...color },
            target: { ...color },
            progress: 1,
            zone: 1 as const,
            alpha: 0.85,
          };
        }

        const cov = coverage[index];
        const cx = index % columns;
        const cy = Math.floor(index / columns);
        const n = noise(cx, cy);
        let alpha = 0;
        let zone: 0 | 1 = 1;

        if (cov >= 0.5) {
          // Solid interior: dense, bright ink.
          alpha = 0.85;
          zone = 0;
        } else if (cov >= 0.28) {
          // Inner edge: still filled, but thinning towards the contour.
          alpha = 0.45 + 0.4 * ((cov - 0.28) / 0.22);
          zone = cov >= 0.4 ? 0 : 1;
        } else if (cov >= 0.1) {
          // Dissolve band: ragged, translucent cells.
          if (n < 0.25 + cov) {
            alpha = 0.2 + 0.9 * (cov - 0.1);
          }
        } else if (cov > 0.02) {
          // Faint spill beyond the contour.
          if (n < (cov - 0.02) * 1.5) {
            alpha = 0.12 + 0.5 * cov;
          }
        }

        const color = randomColor(zone);
        return {
          char: randomGlyph(),
          color: { ...color },
          target: { ...color },
          progress: 1,
          zone,
          alpha,
        };
      });
    };

    const draw = () => {
      if (!columns || !rows) return;

      ctx.clearRect(0, 0, columns * CHAR_WIDTH, rows * CHAR_HEIGHT);
      ctx.font = `${FONT_SIZE}px "Fira Code", ui-monospace, monospace`;
      ctx.textBaseline = "top";

      for (let i = 0; i < letters.length; i++) {
        const letter = letters[i];
        if (letter.alpha <= 0) continue;

        const x = (i % columns) * CHAR_WIDTH;
        const y = Math.floor(i / columns) * CHAR_HEIGHT;

        ctx.globalAlpha = letter.alpha;
        ctx.fillStyle = `rgb(${letter.color.r}, ${letter.color.g}, ${letter.color.b})`;
        ctx.fillText(letter.char, x, y);
      }

      ctx.globalAlpha = 1;
    };

    const glitch = () => {
      if (!letters.length) return;
      const count = Math.max(1, Math.floor(letters.length * 0.05));

      for (let i = 0; i < count; i++) {
        const letter = letters[Math.floor(Math.random() * letters.length)];
        letter.char = randomGlyph();
        letter.target = randomColor(letter.zone);

        if (reduced) {
          letter.color = { ...letter.target };
          letter.progress = 1;
        } else {
          letter.progress = 0;
        }
      }
    };

    const stepColors = () => {
      let changed = false;

      for (const letter of letters) {
        if (letter.progress >= 1) continue;

        letter.progress = Math.min(1, letter.progress + 0.06);
        letter.color.r += (letter.target.r - letter.color.r) * 0.18;
        letter.color.g += (letter.target.g - letter.color.g) * 0.18;
        letter.color.b += (letter.target.b - letter.color.b) * 0.18;
        changed = true;

        if (letter.progress >= 1) {
          letter.color = { ...letter.target };
        }
      }

      return changed;
    };

    const tick = (now: number) => {
      if (!running) return;

      let needsDraw = false;

      if (now - lastGlitch >= GLITCH_INTERVAL) {
        glitch();
        needsDraw = true;
        lastGlitch = now;
      }

      if (stepColors()) needsDraw = true;
      if (needsDraw) draw();

      frame = window.requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reduced) return;
      running = true;
      lastGlitch = performance.now();
      frame = window.requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      window.cancelAnimationFrame(frame);
    };

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      if (
        Math.round(rect.width) === lastWidth &&
        Math.round(rect.height) === lastHeight
      ) {
        return;
      }

      lastWidth = Math.round(rect.width);
      lastHeight = Math.round(rect.height);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      columns = Math.ceil(rect.width / CHAR_WIDTH);
      rows = Math.ceil(rect.height / CHAR_HEIGHT);

      if (!glyph && !glyphFailed) {
        // Wait for the mark; drawing the fallback rectangle first would flash.
        letters = [];
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }

      coverage = buildCoverage(columns, rows, rect.width, rect.height);
      createLetters();
      draw();
    };

    const queueResize = () => {
      window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(resize);
    };

    const loadGlyph = () => {
      const img = new Image();
      img.decoding = "async";
      img.onload = () => {
        if (disposed) return;
        glyph = img;
        lastWidth = 0;
        lastHeight = 0;
        resize();
      };
      img.onerror = () => {
        if (disposed) return;
        glyphFailed = true;
        lastWidth = 0;
        lastHeight = 0;
        resize();
      };
      img.src = GLYPH_SRC;
    };

    readPalette();
    loadGlyph();
    resize();

    if (document.fonts?.ready) {
      document.fonts.ready.then(() => draw()).catch(() => {});
    }

    const resizeObserver = new ResizeObserver(queueResize);
    resizeObserver.observe(stage);

    const intersection = new IntersectionObserver(
      entries => {
        if (entries.some(entry => entry.isIntersecting)) start();
        else stop();
      },
      { rootMargin: "120px" }
    );
    intersection.observe(root);

    // Theme/accent changes animate the CSS tokens for 300ms; wait for that
    // settle, then retarget every character so the code shades follow the new
    // accent with the existing colour interpolation (no hard jump).
    let paletteTimer: number | undefined;

    const applyPalette = () => {
      readPalette();

      for (const letter of letters) {
        letter.target = randomColor(letter.zone);
        letter.progress = reduced ? 1 : 0;
        if (reduced) letter.color = { ...letter.target };
      }

      if (reduced) draw();
    };

    const themeObserver = new MutationObserver(() => {
      window.clearTimeout(paletteTimer);
      paletteTimer = window.setTimeout(applyPalette, 340);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme", "data-accent"],
    });

    const onMotionChange = () => {
      reduced = motion.matches;

      if (reduced) {
        stop();
        for (const letter of letters) {
          letter.color = { ...letter.target };
          letter.progress = 1;
        }
        draw();
      } else {
        start();
      }
    };
    motion.addEventListener("change", onMotionChange);

    dispose = () => {
      disposed = true;
      stop();
      window.cancelAnimationFrame(resizeFrame);
      window.clearTimeout(paletteTimer);
      resizeObserver.disconnect();
      intersection.disconnect();
      themeObserver.disconnect();
      motion.removeEventListener("change", onMotionChange);
      delete root.dataset.glitchReady;
    };
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .code-glitch-panel {
    width: 100%;
  }

  .glitch-canvas-wrap {
    height: clamp(190px, calc(31vh + 40px), 272px);
  }

  .glitch-canvas-wrap canvas {
    display: block;
  }

  @media (min-width: 1024px) {
    .glitch-canvas-wrap {
      height: clamp(220px, calc(26vh + 40px), 308px);
    }
  }
</style>
