---
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import { SITE } from "@/config";
import { useTranslations, isActive as checkRouteActive } from "@/i18n/utils";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const localePrefix = locale === "es" ? "/es" : locale === "zh" ? "/zh" : "";

const isActive = (path: string) => checkRouteActive(currentPath, path);

const accents = [
  { key: "pink", color: "#db2777", label: t("accent.pink") },
  { key: "rose", color: "#e11d48", label: t("accent.rose") },
  { key: "orange", color: "#ea580c", label: t("accent.orange") },
  { key: "amber", color: "#d97706", label: t("accent.amber") },
  { key: "green", color: "#059669", label: t("accent.green") },
  { key: "teal", color: "#0d9488", label: t("accent.teal") },
  { key: "cyan", color: "#0891b2", label: t("accent.cyan") },
  { key: "blue", color: "#1158d1", label: t("accent.blue") },
  { key: "purple", color: "#7c3aed", label: t("accent.purple") },
];
---

<div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true">
  <!-- Overlay/Backdrop -->
  <div class="mobile-menu-backdrop"></div>

  <!-- Floating Glass Panel -->
  <div class="app-layout">
    <div class="mobile-menu-panel relative mx-auto mt-2 mb-6 w-full overflow-hidden rounded-2xl border border-white/10 shadow-2xl dark:border-white/5">
      <div class="mobile-menu-inner">
        <!-- Primary navigation links -->
        <nav
          class="mobile-nav-links"
          aria-label={
            locale === "es"
              ? "Navegación principal"
              : locale === "zh"
                ? "主导航"
                : "Main navigation"
          }
        >
          <!-- Posts -->
          <a
            href={`${localePrefix}/posts`}
            class:list={["mobile-nav-link", { active: isActive("/posts") }]}
            style="--i:0"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- Document icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </span>
            <span>{t("nav.posts")}</span>
            {isActive("/posts") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          <!-- About -->
          <a
            href={`${localePrefix}/about`}
            class:list={["mobile-nav-link", { active: isActive("/about") }]}
            style="--i:1"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- User icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </span>
            <span>{t("nav.about")}</span>
            {isActive("/about") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          <!-- Tags -->
          <a
            href={`${localePrefix}/tags`}
            class:list={["mobile-nav-link", { active: isActive("/tags") }]}
            style="--i:2"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- Tag icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 6h.008v.008H6V6Z"
                ></path>
              </svg>
            </span>
            <span>{t("nav.tags")}</span>
            {isActive("/tags") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          {SITE.showArchives && (
            <a
              href={`${localePrefix}/archives`}
              class:list={[
                "mobile-nav-link",
                { active: isActive("/archives") },
              ]}
              style="--i:3"
            >
              <span class="mobile-nav-icon" aria-hidden="true">
                <IconArchive class="size-4" />
              </span>
              <span>{t("nav.archives")}</span>
              {isActive("/archives") && (
                <span class="mobile-nav-active-dot" aria-hidden="true" />
              )}
            </a>
          )}
          {SITE.showGalleries && (
            <a
              href={`${localePrefix}/galleries`}
              class:list={[
                "mobile-nav-link",
                { active: isActive("/galleries") },
              ]}
              style="--i:4"
            >
              <span class="mobile-nav-icon" aria-hidden="true">
                <IconGallery class="size-4" />
              </span>
              <span>{t("nav.galleries")}</span>
              {isActive("/galleries") && (
                <span class="mobile-nav-active-dot" aria-hidden="true" />
              )}
            </a>
          )}
        </nav>

        <!-- Divider -->
        <div class="mobile-menu-divider"></div>

        <!-- Utilities section label -->
        <p class="mobile-section-label">
          {locale === "es"
            ? "Herramientas"
            : locale === "zh"
              ? "工具"
              : "Tools"}
        </p>

        <!-- Action row: Search -->
        <div class="mobile-menu-actions">
          <button
            data-search-trigger
            class="mobile-action-btn"
            aria-label={t("nav.openSearch")}
          >
            <IconSearch class="size-4 shrink-0" />
            <span>{t("nav.search")}</span>
            <kbd class="mobile-kbd ml-auto">⌘K</kbd>
          </button>
        </div>

        <!-- Divider -->
        <div class="mobile-menu-divider"></div>

        <!-- Preferences section label -->
        <p class="mobile-section-label">
          {locale === "es"
            ? "Preferencias"
            : locale === "zh"
              ? "偏好设置"
              : "Preferences"}
        </p>

        <!-- Accent color -->
        <div class="mobile-accent-row">
          <span class="mobile-accent-label">{t("nav.accentColor")}</span>
          <div
            class="accent-swatches"
            role="group"
            aria-label={t("nav.changeAccent")}
          >
            {accents.map(accent => (
              <button
                type="button"
                class="accent-swatch"
                data-accent-color={accent.key}
                style={`background-color: ${accent.color}`}
                data-tip={accent.label}
                aria-label={accent.label}
              ></button>
            ))}
          </div>
        </div>

        <!-- Sound + help -->
        <div class="mobile-prefs-row">
          <button
            type="button"
            class="mobile-pref-btn flex-1"
            data-sound-toggle
            data-label-on={t("nav.soundFxOn")}
            data-label-off={t("nav.soundFxOff")}
            aria-pressed="false"
          >
            <svg
              class="size-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M11 5 6 9H3v6h3l5 4V5Z"
              />
              <path
                stroke-linecap="round"
                d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"
              />
            </svg>
            <span data-sound-label>{t("nav.soundFxOff")}</span>
          </button>

          <button
            type="button"
            class="mobile-pref-btn flex-1"
            data-shortcuts-open
          >
            <svg
              class="size-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.8 9a2.3 2.3 0 1 1 3.6 1.9c-.9.6-1.4 1.1-1.4 2.1"
              />
              <path stroke-linecap="round" d="M12 16.5h.01" />
            </svg>
            <span>{t("nav.shortcuts")}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Declarative scroll lock when menu is open on mobile */
  @media (max-width: 1023px) {
    /* Lock the page scroll without turning the body into a scroll container:
       body scrolling disables the sticky header and makes the sheet jump to
       the document top. Locking <html> keeps the header in place and leaves
       the page layout untouched. */
    :global(html:has(#mobile-menu.is-open)) {
      overflow: hidden;
    }
  }

  /* ─── Mobile Menu Floating Sheet ─── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 20;
    pointer-events: none;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    opacity: 0;
    pointer-events: none;
    transition:
      background-color 0.4s ease,
      opacity 0.4s ease,
      backdrop-filter 0.4s ease,
      -webkit-backdrop-filter 0.4s ease;
  }

  .mobile-menu.is-open .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--accent) 5%, transparent),
        transparent 46%
      ),
      color-mix(in srgb, var(--background) 98.5%, transparent);
    box-shadow:
      0 28px 64px -28px rgba(0, 0, 0, 0.45),
      0 4px 14px -6px rgba(0, 0, 0, 0.16);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.35s;
    visibility: hidden;
  }

  .mobile-menu .mobile-menu-panel {
    border-color: color-mix(in srgb, var(--foreground) 10%, transparent);
  }

  .mobile-menu.is-open .mobile-menu-panel {
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* ─── Mobile Menu Inner ─── */
  .mobile-menu-inner {
    position: relative;
    max-height: calc(100dvh - 7rem);
    padding: 1rem 1rem 1.1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ─── Section labels ─── */
  .mobile-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 35%, transparent);
    padding: 0 0.3rem 0.5rem;
    font-family: var(--font-firacode, monospace);
    user-select: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    transition-delay: 0.35s;
  }

  .mobile-menu.is-open .mobile-section-label {
    opacity: 1;
  }

  /* ─── Mobile Nav Links ─── */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.9rem;
    padding: 0.7rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.75rem;
    transition:
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    opacity: 0;
    transform: translateY(8px);
    position: relative;
  }

  .mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    transition-delay: calc(0.07s * var(--i, 0) + 0.1s);
  }

  :is(.mobile-nav-link, .mobile-action-btn, .mobile-pref-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* ─── Nav icon container ─── */
  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    flex-shrink: 0;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .mobile-nav-link.active .mobile-nav-icon,
  .mobile-nav-link:hover .mobile-nav-icon {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }

  /* ─── Active dot (right side) ─── */
  .mobile-nav-active-dot {
    display: block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
    margin-left: auto;
    flex-shrink: 0;
  }

  /* ─── Menu Divider ─── */
  .mobile-menu-divider {
    margin: 0.625rem 0.25rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 40%, transparent),
      transparent
    );
  }

  /* ─── Mobile Action Buttons ─── */
  .mobile-menu-actions {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0.32s;
    margin-bottom: 0.5rem;
  }

  .mobile-menu.is-open .mobile-menu-actions {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-action-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.55rem;
    padding: 0.5625rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    border-radius: 0.625rem;
    border: none;
    background: transparent;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
    text-align: left;
    width: 100%;
  }

  /* KBD inside mobile actions */
  .mobile-kbd {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 80%, transparent);
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    font-family: inherit;
    line-height: 1;
  }

  /* ─── Preferences Row ─── */
  .mobile-prefs-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0.38s;
  }

  .mobile-menu.is-open .mobile-prefs-row {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-pref-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.65rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--foreground) 75%, transparent);
    border-radius: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
    white-space: nowrap;
  }

  .mobile-pref-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-pref-btn[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-accent-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
    margin-bottom: 0.15rem;
    padding: 0.7rem 0.75rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--border) 22%, transparent);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--foreground) 4%, transparent);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0.4s;
  }

  .mobile-menu.is-open .mobile-accent-row {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-accent-label {
    font-family: var(--font-firacode, monospace);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 35%, transparent);
    user-select: none;
  }
</style>
