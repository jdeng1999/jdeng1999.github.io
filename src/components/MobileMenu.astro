---
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconDeviceDesktop from "@/assets/icons/IconDeviceDesktop.svg";
import { SITE } from "@/config";
import {
  useTranslations,
  getTargetLanguageUrl,
  isActive as checkRouteActive,
} from "@/i18n/utils";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const localePrefix = locale === "es" ? "/es" : locale === "zh" ? "/zh" : "";

const { pathname } = Astro.url;
const targetLocale = locale === "zh" ? "en" : "zh";
const targetLanguageUrl = getTargetLanguageUrl(pathname, targetLocale);
const langToggleTitle =
  targetLocale === "zh" ? "切换到中文" : "Switch to English";
const langToggleText = targetLocale === "zh" ? "CN" : "EN";
const langNextText = locale === "zh" ? "CN" : "EN";

const isActive = (path: string) => checkRouteActive(currentPath, path);

const accents = [
  { key: "pink", color: "#db2777", label: t("accent.pink") },
  { key: "rose", color: "#e11d48", label: t("accent.rose") },
  { key: "orange", color: "#ea580c", label: t("accent.orange") },
  { key: "amber", color: "#d97706", label: t("accent.amber") },
  { key: "green", color: "#059669", label: t("accent.green") },
  { key: "teal", color: "#0d9488", label: t("accent.teal") },
  { key: "cyan", color: "#0891b2", label: t("accent.cyan") },
  { key: "blue", color: "#1158d1", label: t("accent.blue") },
  { key: "purple", color: "#7c3aed", label: t("accent.purple") },
];
---

<div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true">
  <!-- Overlay/Backdrop -->
  <div class="mobile-menu-backdrop"></div>

  <!-- Floating Glass Panel -->
  <div class="app-layout">
    <div class="mobile-menu-panel relative mb-6 w-full overflow-hidden">
      <div class="mobile-menu-inner">
        <!-- Primary navigation links -->
        <nav
          class="mobile-nav-links"
          aria-label={
            locale === "es"
              ? "Navegación principal"
              : locale === "zh"
                ? "主导航"
                : "Main navigation"
          }
        >
          <!-- Posts -->
          <a
            href={`${localePrefix}/posts`}
            class:list={["mobile-nav-link", { active: isActive("/posts") }]}
            style="--i:0"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- Document icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </span>
            <span>{t("nav.posts")}</span>
            {isActive("/posts") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          <!-- About -->
          <a
            href={`${localePrefix}/about`}
            class:list={["mobile-nav-link", { active: isActive("/about") }]}
            style="--i:1"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- User icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </span>
            <span>{t("nav.about")}</span>
            {isActive("/about") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          <!-- Tags -->
          <a
            href={`${localePrefix}/tags`}
            class:list={["mobile-nav-link", { active: isActive("/tags") }]}
            style="--i:2"
          >
            <span class="mobile-nav-icon" aria-hidden="true">
              <!-- Tag icon -->
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"
                ></path>
                <circle
                  cx="7.1"
                  cy="7.1"
                  r="1"
                  fill="currentColor"
                  stroke="none"
                ></circle>
              </svg>
            </span>
            <span>{t("nav.tags")}</span>
            {isActive("/tags") && (
              <span class="mobile-nav-active-dot" aria-hidden="true" />
            )}
          </a>

          {SITE.showArchives && (
            <a
              href={`${localePrefix}/archives`}
              class:list={[
                "mobile-nav-link",
                { active: isActive("/archives") },
              ]}
              style="--i:3"
            >
              <span class="mobile-nav-icon" aria-hidden="true">
                <IconArchive class="size-4" />
              </span>
              <span>{t("nav.archives")}</span>
              {isActive("/archives") && (
                <span class="mobile-nav-active-dot" aria-hidden="true" />
              )}
            </a>
          )}
          {SITE.showGalleries && (
            <a
              href={`${localePrefix}/galleries`}
              class:list={[
                "mobile-nav-link",
                { active: isActive("/galleries") },
              ]}
              style="--i:4"
            >
              <span class="mobile-nav-icon" aria-hidden="true">
                <IconGallery class="size-4" />
              </span>
              <span>{t("nav.galleries")}</span>
              {isActive("/galleries") && (
                <span class="mobile-nav-active-dot" aria-hidden="true" />
              )}
            </a>
          )}
        </nav>

        <!-- Divider -->
        <div class="mobile-menu-divider"></div>

        <!-- Preferences section label -->
        <p class="mobile-section-label">
          {locale === "es"
            ? "Preferencias"
            : locale === "zh"
              ? "偏好设置"
              : "Preferences"}
        </p>

        <!-- Theme, language, sound and shortcuts -->
        <div class="mobile-utility-row">
          {SITE.lightAndDarkMode && (
            <button
              type="button"
              id="theme-btn-mobile"
              class="mobile-icon-btn"
              aria-label="auto"
              aria-live="polite"
              title={t("nav.themeLabel")}
            >
              <span class="mobile-theme-dial" aria-hidden="true">
                <span class="theme-dial" data-theme-dial>
                  <span class="theme-dial-slot" data-theme-icon="light">
                    <IconSunHigh class="size-4" />
                  </span>
                  <span class="theme-dial-slot" data-theme-icon="dark">
                    <IconMoon class="size-4" />
                  </span>
                  <span class="theme-dial-slot" data-theme-icon="system">
                    <IconDeviceDesktop class="size-4" />
                  </span>
                </span>
              </span>
            </button>
          )}

          <a
            href={targetLanguageUrl}
            class="mobile-icon-btn mobile-lang-btn"
            aria-label={langToggleTitle}
            title={langToggleTitle}
            data-lang-toggle={targetLocale}
            hreflang={targetLocale === "zh" ? "zh-CN" : "en"}
          >
            <svg
              class="size-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c-.03.077-.07.154-.114.23-.9 1.54-2.11 3.05-3.535 4.5M6.412 9a14.95 14.95 0 003.535 4.5m0 0a14.973 14.973 0 01-3.298 3.19M6.412 9H3.9M15 9h-2.5"
              ></path>
            </svg>
            <span class="mobile-lang-code lang-roll" data-lang-roll>
              <span class="lang-roll-item" data-lang-current>
                {langToggleText}
              </span>
              <span
                class="lang-roll-item lang-roll-item--next"
                aria-hidden="true"
              >
                {langNextText}
              </span>
            </span>
          </a>

          <button
            type="button"
            class="mobile-icon-btn"
            data-sound-toggle
            data-sound-level="0"
            data-label-on={t("nav.soundFxOn")}
            data-label-off={t("nav.soundFxOff")}
            aria-pressed="false"
            aria-label={t("nav.soundFxToggle")}
            title={t("nav.soundFxToggle")}
          >
            <span class="sound-glyph-stack" aria-hidden="true">
              <!-- One wave -->
              <svg
                class="sound-glyph sound-glyph--low"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5 6 9H3v6h3l5 4V5Z"
                />
                <path stroke-linecap="round" d="M15.5 8.5a5 5 0 0 1 0 7" />
              </svg>
              <!-- Two waves -->
              <svg
                class="sound-glyph sound-glyph--high"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5 6 9H3v6h3l5 4V5Z"
                />
                <path
                  stroke-linecap="round"
                  d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"
                />
              </svg>
              <!-- Muted -->
              <svg
                class="sound-glyph sound-glyph--off"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5 6 9H3v6h3l5 4V5Z"
                />
                <path stroke-linecap="round" d="m16 9 5 5m0-5-5 5" />
              </svg>
            </span>
          </button>

          <button
            type="button"
            class="mobile-icon-btn"
            data-shortcuts-open
            aria-label={t("nav.shortcuts")}
            title={t("nav.shortcuts")}
          >
            <svg
              class="size-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.8 9a2.3 2.3 0 1 1 3.6 1.9c-.9.6-1.4 1.1-1.4 2.1"
              />
              <path stroke-linecap="round" d="M12 16.5h.01" />
            </svg>
          </button>
        </div>

        <!-- Accent color -->
        <div class="mobile-accent-row">
          <span class="mobile-accent-label">{t("nav.accentColor")}</span>
          <div
            class="accent-swatches"
            role="group"
            aria-label={t("nav.changeAccent")}
          >
            {accents.map(accent => (
              <button
                type="button"
                class="accent-swatch"
                data-accent-color={accent.key}
                style={`background-color: ${accent.color}`}
                data-tip={accent.label}
                aria-label={accent.label}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Declarative scroll lock when menu is open on mobile */
  @media (max-width: 1023px) {
    /* Lock the page scroll without turning the body into a scroll container:
       body scrolling disables the sticky header and makes the sheet jump to
       the document top. Locking <html> keeps the header in place and leaves
       the page layout untouched. */
    :global(html:has(#mobile-menu.is-open)) {
      overflow: hidden;
    }
  }

  /* ─── Mobile Menu Floating Sheet ─── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 20;
    pointer-events: none;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: fixed;
    top: var(--menu-top, 0px);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    opacity: 0;
    pointer-events: none;
    transition:
      background-color 0.4s ease,
      opacity 0.4s ease,
      backdrop-filter 0.4s ease,
      -webkit-backdrop-filter 0.4s ease;
  }

  .mobile-menu.is-open .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    background: var(--background);
    margin-inline: -1rem;
    width: calc(100% + 2rem);
    /* Clip the drop shadow at the top edge: it used to paint over the sticky
       header and made the two surfaces look like different colors. */
    clip-path: inset(0 -12rem -12rem -12rem);
    box-shadow:
      0 28px 64px -28px rgba(0, 0, 0, 0.45),
      0 4px 14px -6px rgba(0, 0, 0, 0.16);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.35s;
    visibility: hidden;
  }

  /* Fuse the open menu with the navigation bar above it. */
  :global(#main-header:has(#mobile-menu.is-open)) {
    background: var(--background) !important;
    box-shadow: none;
    transition: none;
  }

  /* Restoring the menu after a language switch: show it already expanded so
     the sheet does not replay its open animation. */
  .mobile-menu.is-instant .mobile-menu-backdrop,
  .mobile-menu.is-instant .mobile-menu-panel,
  .mobile-menu.is-instant .mobile-nav-link,
  .mobile-menu.is-instant .mobile-section-label,
  .mobile-menu.is-instant .mobile-utility-row,
  .mobile-menu.is-instant .mobile-accent-row {
    transition: none !important;
  }

  :global(html:has(#mobile-menu.is-instant) .hamburger-line) {
    transition: none !important;
  }

  .mobile-menu.is-open .mobile-menu-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* ─── Mobile Menu Inner ─── */
  .mobile-menu-inner {
    position: relative;
    max-height: calc(100svh - 7rem);
    padding: 1rem 1rem 1.1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .mobile-menu-inner::-webkit-scrollbar {
    display: none;
  }

  /* ─── Section labels ─── */
  .mobile-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 35%, transparent);
    padding: 0 0.3rem 0.5rem;
    font-family: var(--font-firacode, monospace);
    user-select: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    transition-delay: 0.35s;
  }

  .mobile-menu.is-open .mobile-section-label {
    opacity: 1;
  }

  /* ─── Mobile Nav Links ─── */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.9rem;
    padding: 0.7rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.75rem;
    transition:
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    opacity: 0;
    transform: translateY(8px);
    position: relative;
  }

  .mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    transition-delay: calc(0.07s * var(--i, 0) + 0.1s);
  }

  :is(.mobile-nav-link, .mobile-icon-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* ─── Nav icon container ─── */
  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    flex-shrink: 0;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .mobile-nav-link.active .mobile-nav-icon,
  .mobile-nav-link:hover .mobile-nav-icon {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }

  /* ─── Active dot (right side) ─── */
  .mobile-nav-active-dot {
    display: block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
    margin-left: auto;
    flex-shrink: 0;
  }

  /* ─── Menu Divider ─── */
  .mobile-menu-divider {
    margin: 0.625rem 0.25rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 40%, transparent),
      transparent
    );
  }

  /* ─── Compact icon utilities ─── */
  .mobile-utility-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.55rem, 3vw, 0.95rem);
    margin: 0.15rem 0 0.2rem;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0.36s;
  }

  .mobile-menu.is-open .mobile-utility-row {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-icon-btn {
    display: inline-grid;
    flex: none;
    width: 2.85rem;
    height: 2.85rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0.8rem;
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 64%, transparent);
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.18s ease;
  }

  .mobile-utility-row,
  .mobile-utility-row * {
    -webkit-tap-highlight-color: transparent;
  }

  /* No container/frame in any state: these utilities are free-floating icons. */
  @media (hover: hover) {
    .mobile-icon-btn:hover {
      color: var(--accent);
    }
  }

  .mobile-icon-btn:active,
  .mobile-icon-btn:focus-visible {
    color: var(--accent);
    background: transparent;
    outline: none;
  }

  .mobile-icon-btn.active {
    color: var(--accent);
  }

  /* The theme control must blend into the sheet: no fill, ring, or shadow in
     any state, including the focus state set by the browser. */
  #theme-btn-mobile,
  #theme-btn-mobile:hover,
  #theme-btn-mobile:active,
  #theme-btn-mobile:focus,
  #theme-btn-mobile:focus-visible,
  #theme-btn-mobile *,
  #theme-btn-mobile *::before,
  #theme-btn-mobile *::after {
    background-color: transparent !important;
    box-shadow: none !important;
    border-color: transparent !important;
    outline: none !important;
  }

  .mobile-lang-btn {
    display: inline-flex;
    width: auto;
    min-width: 2.85rem;
    padding: 0 0.65rem;
    gap: 0.28rem;
    align-items: center;
    justify-content: center;
  }

  .mobile-lang-code {
    font-family: var(--font-firacode, monospace);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.18;
  }

  .mobile-icon-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Three-state volume glyph: one wave, two waves, muted. */
  .sound-glyph-stack {
    position: relative;
    display: inline-grid;
    width: 1.1rem;
    height: 1.1rem;
    place-items: center;
  }

  .sound-glyph {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.7) rotate(-10deg);
    transition:
      opacity 0.18s ease,
      transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-sound-level="0"] .sound-glyph--off,
  [data-sound-level="1"] .sound-glyph--low,
  [data-sound-level="2"] .sound-glyph--high {
    opacity: 1;
    transform: none;
  }

  .mobile-theme-dial {
    position: relative;
    display: inline-grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    overflow: hidden;
    border-radius: 0.35rem;
  }

  .mobile-theme-dial .theme-dial {
    --dial-radius: 1.05rem;
    width: 100%;
    height: 100%;
  }

  .mobile-theme-dial .theme-dial-slot {
    width: 1.5rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
  }

  .mobile-theme-dial .theme-dial-slot svg {
    width: 1rem;
    height: 1rem;
  }

  .mobile-accent-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
    margin: 0.35rem 0 0;
    padding: 0.35rem 0.15rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0.4s;
  }

  .mobile-menu.is-open .mobile-accent-row {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-accent-row .accent-swatches {
    width: 100%;
    min-height: 0;
    justify-content: space-between;
    gap: 0.35rem;
