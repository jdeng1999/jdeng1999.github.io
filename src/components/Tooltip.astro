---
/**
 * Tooltip — one themed, localized tooltip for elements that still need a
 * short written explanation. Elements opt in with `data-tip="…"`.
 */
---

<div
  id="site-tooltip"
  class="site-tooltip"
  role="tooltip"
  aria-hidden="true"
></div>

<style is:global>
  .site-tooltip {
    position: fixed;
    z-index: 200;
    max-width: 16rem;
    padding: 0.4rem 0.62rem;
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow:
      0 14px 34px -16px color-mix(in srgb, #000 55%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--foreground) 6%, transparent);
    color: color-mix(in srgb, var(--foreground) 82%, transparent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.68rem;
    line-height: 1.35;
    letter-spacing: 0.015em;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, 4px) scale(0.97);
    transform-origin: 50% 0;
    pointer-events: none;
    transition:
      opacity 0.14s ease,
      transform 0.14s ease;
  }

  .site-tooltip[data-open="true"] {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-tooltip {
      transition: none;
    }
  }
</style>

<script>
  const initTooltip = () => {
    const tip = document.getElementById("site-tooltip");
    if (!tip || tip.dataset.ready === "true") return;
    tip.dataset.ready = "true";

    let showTimer = 0;
    let current: HTMLElement | null = null;

    const hide = () => {
      window.clearTimeout(showTimer);
      current = null;
      tip.dataset.open = "false";
      tip.setAttribute("aria-hidden", "true");
    };

    const place = (target: HTMLElement) => {
      const text = target.getAttribute("data-tip");
      if (!text) return;

      tip.textContent = text;
      tip.dataset.open = "true";
      tip.setAttribute("aria-hidden", "false");

      const rect = target.getBoundingClientRect();
      const tipRect = tip.getBoundingClientRect();
      const gap = 10;

      let top = rect.top - tipRect.height - gap;
      if (top < 8) top = rect.bottom + gap;

      const half = tipRect.width / 2;
      let left = rect.left + rect.width / 2;
      left = Math.min(Math.max(left, half + 8), window.innerWidth - half - 8);

      tip.style.top = `${Math.round(top)}px`;
      tip.style.left = `${Math.round(left)}px`;
    };

    const show = (target: HTMLElement) => {
      current = target;
      window.clearTimeout(showTimer);
      showTimer = window.setTimeout(() => {
        if (current === target) place(target);
      }, 120);
    };

    document.addEventListener("pointerover", event => {
      if (event.pointerType === "touch") return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-tip]");
      if (!trigger) return;
      if (trigger === current) return;
      show(trigger);
    });

    document.addEventListener("pointerout", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-tip]");
      if (!trigger || trigger !== current) return;
      hide();
    });

    document.addEventListener("focusin", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-tip]");
      if (trigger) show(trigger);
    });

    document.addEventListener("focusout", hide);
    document.addEventListener("click", hide, true);
    window.addEventListener("scroll", hide, { passive: true, capture: true });
    window.addEventListener("resize", hide);
  };

  initTooltip();
  document.addEventListener("astro:page-load", initTooltip);
</script>
