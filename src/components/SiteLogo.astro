---
/**
 * SiteLogo — the compact text wordmark used in the header and footer.
 */
interface Props {
  class?: string;
  cursor?: boolean;
}

const { class: className = "", cursor = false } = Astro.props;
---

<span class:list={["site-logo", className]} aria-hidden="true">
  <span class="site-logo-mark">J.</span>
  <span class="site-logo-text">Deng</span>
  {cursor && (
    <span class="site-logo-cursor" aria-hidden="true">
      _
    </span>
  )}
</span>

<style>
  .site-logo {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-wotfard), ui-sans-serif, sans-serif;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.015em;
    color: var(--color-foreground);
    user-select: none;
  }

  .site-logo-mark {
    color: var(--color-accent);
  }

  .site-logo-text {
    margin-left: 0.18em;
  }

  .site-logo-cursor {
    margin-left: 0.09em;
    color: var(--color-accent);
    font-weight: 500;
    opacity: 0.9;
    animation: site-logo-blink 1.7s steps(1, end) infinite;
  }

  @keyframes site-logo-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-logo-cursor {
      animation: none;
    }
  }
</style>
