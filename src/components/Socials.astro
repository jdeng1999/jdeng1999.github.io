---
/**
 * Socials — Renders the author's social media profile links (e.g. GitHub, LinkedIn, Twitter).
 * It dynamically maps over the SOCIALS array defined in `constants.ts`.
 * Typically used in the Footer or Author bio sections.
 */
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {SOCIALS.map(social => (
    <LinkButton
      href={social.href}
      class="p-2 hover:rotate-6 sm:p-1"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={social.linkTitle}
    >
      <social.icon class="inline-block size-5 fill-current sm:scale-110" />
      <span class="sr-only">{social.linkTitle}</span>
    </LinkButton>
  ))}
</div>
