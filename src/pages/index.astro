---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import CodeGlitch from "@/components/CodeGlitch.astro";
import TechMarquee from "@/components/TechMarquee.astro";
import HeroTerminal from "@/components/HeroTerminal.astro";
import { useTranslations } from "@/i18n/utils";
import { getEntryPath } from "@/utils/contentEntry";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const prefix = locale === "es" ? "/es" : "";

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog", ({ id }) => id.startsWith(`${locale}/`)),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries", ({ id }) => id.startsWith(`${locale}/`))
    : Promise.resolve([]),
]);
const posts = [...blogPosts, ...galleryPosts];

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(
  ({ data }) => "featured" in data && data.featured
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !("featured" in data && data.featured)
);

const terminalPosts = sortedPosts.map(post => ({
  title: post.data.title,
  href: `${prefix}${getEntryPath(post)}`,
}));

const whatIDo =
  locale === "es"
    ? [
        {
          title: "Ingeniería Backend",
          icon: "server" as const,
          items: [
            "Java y Spring Boot",
            "APIs REST y arquitectura limpia",
            "MySQL, Redis y Maven",
          ],
        },
        {
          title: "Frontend e Interfaces",
          icon: "layout" as const,
          items: [
            "Astro y Tailwind CSS",
            "Diseño responsive y accesible",
            "Detalles de interacción",
          ],
        },
        {
          title: "DevOps y Entrega",
          icon: "terminal" as const,
          items: [
            "Docker y Linux",
            "Flujos de trabajo con Git",
            "Builds y despliegues automatizados",
          ],
        },
      ]
    : [
        {
          title: "Backend Engineering",
          icon: "server" as const,
          items: [
            "Java & Spring Boot services",
            "REST APIs & clean architecture",
            "MySQL, Redis & Maven",
          ],
        },
        {
          title: "Frontend & Interfaces",
          icon: "layout" as const,
          items: [
            "Astro & Tailwind CSS",
            "Responsive, accessible layouts",
            "Interaction details",
          ],
        },
        {
          title: "DevOps & Delivery",
          icon: "terminal" as const,
          items: [
            "Docker & Linux",
            "Git workflows",
            "Build & deploy automation",
          ],
        },
      ];

const whatIcons = {
  server: `<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01M11 7.5h2M11 16.5h2"/>`,
  layout: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 21V9"/>`,
  terminal: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>`,
} as const;
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section
      id="hero"
      class="hero-section relative pt-8 pb-10 sm:pt-10 sm:pb-14"
    >
      <div class="relative z-10">
        <div class="hero-copy">
          <!-- Terminal prompt badge + interactive shell -->
          <HeroTerminal posts={terminalPosts} />

          <p class="hero-greeting">
            <span class="hero-greeting-dot" aria-hidden="true"></span>
            {t("index.heroGreeting")}
            <span class="hero-name">J. Deng</span>
          </p>

          <div class="hero-role-grid">
            <h1 class="hero-role">
              <span class="hero-role-line">Software</span>
              <span class="hero-role-line hero-role-accent">Engineer</span>
            </h1>

            <div class="hero-intro-panel">
              <p class="hero-intro">
                {t("index.heroIntroBefore")}
                <span class="shiny-accent">
                  {t("index.heroIntroHighlight")}
                </span>
                {t("index.heroIntroAfter")}
              </p>

              <div class="hero-meta-row">
                <p class="hero-written">
                  {t("index.writtenBy")}
                  <LinkButton
                    class="font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
                    href={SITE.profile}
                    target="_blank"
                  >
                    {SITE.author}
                  </LinkButton>
                </p>

                {SOCIALS.length > 0 && (
                  <div class="hero-socials">
                    <Socials />
                    <a
                      target="_blank"
                      href={`${prefix}/rss.xml`}
                      class="hero-rss"
                      aria-label="RSS Feed"
                      title="RSS Feed"
                    >
                      <IconRss width={16} height={16} />
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ TECH STACK ═══════════════════ -->
    <TechMarquee label={t("index.techStack")} class="mb-10" />

    <!-- ═══════════════════ WHAT I DO ═══════════════════ -->
    <section id="what-i-do" class="what-section relative mb-12">
      <div class="what-head">
        <div class="what-head-copy">
          <p class="what-kicker">{locale === "es" ? "ENFOQUE" : "FOCUS"}</p>
          <h2 class="what-title">{t("index.whatIDo")}</h2>
        </div>
        <p class="what-sub">{t("index.whatIDoSub")}</p>
      </div>

      <div class="what-grid">
        <div class="what-list">
          {whatIDo.map((item, index) => (
            <details class="what-item" open={index === 0}>
              <summary>
                <span class="what-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={whatIcons[item.icon]}
                  />
                </span>
                <span class="what-item-title">{item.title}</span>
                <svg
                  class="what-chevron"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul class="what-items">
                {item.items.map(entry => (
                  <li>
                    <span class="what-bullet" aria-hidden="true" />
                    <span>{entry}</span>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>

        <div class="what-visual">
          <div class="what-visual-frame">
            <div class="what-visual-head">
              <span class="what-live-dot" aria-hidden="true"></span>
              {locale === "es" ? "VISTA DE CÓDIGO" : "CODE PREVIEW"}
            </div>
            <CodeGlitch />
          </div>
          <p class="what-visual-note">
            {t("index.whatIDoFocus")}
            <span>Java · Spring Boot · Astro</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ FEATURED ═══════════════════ -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="pb-6">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="flex items-center gap-2 text-sm font-bold tracking-widest text-accent uppercase">
            <svg
              class="size-4"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {t("index.featured")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 [&>li]:my-0">
          {featuredPosts.map((data, index) => (
            <Card
              variant="h3"
              featured={true}
              id={data.id}
              collection={data.collection}
              data={data.data}
              body={data.body}
              filePath={data.filePath}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index < 2 ? "high" : "auto"}
            />
          ))}
        </ul>
      </section>
    )}

    <!-- ═══════════════════ RECENT POSTS ═══════════════════ -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-6 pb-6">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="text-sm font-bold tracking-widest uppercase">
            {t("index.recent")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
          <span class="font-firacode text-xs text-accent/80 select-none">
            [{recentPosts.slice(0, SITE.postPerIndex).length}/
            {recentPosts.length}]
          </span>
        </div>
        <ul
          class:list={[
            SITE.indexPostsGrid &&
              "grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3",
          ]}
        >
          {recentPosts.map(
            (data, index) =>
              index < SITE.postPerIndex && (
                <Card
                  variant="h3"
                  id={data.id}
                  collection={data.collection}
                  data={data.data}
                  body={data.body}
                  filePath={data.filePath}
                  loading={index < 2 ? "eager" : "lazy"}
                  fetchpriority={index < 2 ? "high" : "auto"}
                />
              )
          )}
        </ul>

        <!-- ═══════════════════ CTA ═══════════════════ -->
        <div class="mt-8 mb-4 flex justify-center w-full">
          <LinkButton
            href={`${prefix}/posts/`}
            class="group inline-flex items-center w-full sm:w-auto justify-center gap-2 rounded-xl border border-accent/20 bg-accent/10 px-8 py-4 text-base font-bold text-accent transition-all duration-300 hover:border-accent hover:bg-accent/20 hover:shadow-xl hover:shadow-accent/20 hover:-translate-y-0.5"
          >
            {t("index.exploreAll")}
            <IconArrowRight class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:-rotate-180" />
          </LinkButton>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero-copy {
    min-width: 0;
  }

  .hero-greeting {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.35rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-foreground) 48%, transparent);
  }

  .hero-greeting-dot {
    width: 0.38rem;
    height: 0.38rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .hero-name {
    color: var(--color-foreground);
    letter-spacing: 0.06em;
  }

  .hero-role-grid {
    display: grid;
    gap: 1.4rem 2.5rem;
    margin-top: 1.1rem;
  }

  .hero-role {
    margin: 0;
    font-size: clamp(3.6rem, 8.4vw, 7.2rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-role-line {
    display: block;
  }

  .hero-role-accent {
    background: linear-gradient(
      120deg,
      var(--color-accent) 0%,
      color-mix(in oklab, var(--color-accent) 45%, var(--color-foreground)) 45%,
      var(--color-accent) 100%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 7s ease-in-out infinite;
  }

  .hero-intro-panel {
    align-self: end;
    max-width: 37rem;
    padding-left: 1.4rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-accent) 26%, transparent);
  }

  .hero-intro {
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-foreground) 68%, transparent);
  }

  .shiny-accent {
    background: linear-gradient(
      120deg,
      var(--color-accent) 15%,
      color-mix(in oklab, var(--color-accent) 35%, #ffffff) 50%,
      var(--color-accent) 85%
    );
    background-size: 240% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 4.5s linear infinite;
  }

  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.1rem;
    margin-top: 1.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-foreground) 9%, transparent);
  }

  .hero-written {
    margin: 0;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .hero-rss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-left: 0.1rem;
    border-radius: 999px;
    color: color-mix(in srgb, var(--color-foreground) 38%, transparent);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .hero-rss:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .hero-rss :global(svg) {
    stroke: currentColor;
    stroke-width: 2.2;
  }

  @media (min-width: 1024px) {
    .hero-role-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: end;
    }
  }

  @media (max-width: 1023px) {
    .hero-intro-panel {
      padding-top: 1.25rem;
      padding-left: 0;
      border-top: 1px solid
        color-mix(in srgb, var(--color-accent) 20%, transparent);
      border-left: 0;
    }
  }

  /* ── What I do ── */
  .what-section {
    position: relative;
  }

  .what-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 1.1rem;
  }

  .what-kicker {
    margin: 0 0 0.3rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .what-title {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .what-sub {
    max-width: 25rem;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-foreground) 48%, transparent);
  }

  .what-grid {
    display: grid;
    gap: 1rem;
  }

  .what-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  .what-item {
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 9%, transparent);
    border-radius: 0.8rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 2.5%,
      var(--color-background)
    );
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .what-item[open] {
    border-color: color-mix(in srgb, var(--color-accent) 28%, transparent);
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--color-accent) 7%, transparent),
        transparent 65%
      ),
      color-mix(in srgb, var(--color-foreground) 2.5%, var(--color-background));
  }

  .what-item summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    list-style: none;
    cursor: pointer;
  }

  .what-item summary::-webkit-details-marker {
    display: none;
  }

  .what-item summary:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: -3px;
  }

  .what-icon {
    display: inline-grid;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    color: var(--color-accent);
  }

  .what-icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .what-item-title {
    flex: 1;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .what-chevron {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    color: color-mix(in srgb, var(--color-foreground) 36%, transparent);
    transition: transform 0.25s ease;
  }

  .what-item[open] .what-chevron {
    transform: rotate(180deg);
  }

  .what-items {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0 1rem 1rem 3.95rem;
    list-style: none;
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground) 56%, transparent);
    animation: what-items-in 0.22s ease-out;
  }

  @keyframes what-items-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .what-items li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .what-bullet {
    width: 0.28rem;
    height: 0.28rem;
    flex: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  .what-visual {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 8%, transparent);
    border-radius: 1rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 2.5%,
      var(--color-background)
    );
  }

  .what-visual-frame {
    position: relative;
    flex: 1;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 7%, transparent);
    border-radius: 0.72rem;
    background:
      radial-gradient(
        90% 120% at 100% 0%,
        color-mix(in srgb, var(--color-accent) 10%, transparent),
        transparent 60%
      ),
      color-mix(in srgb, var(--color-background) 96%, #05070d);
  }

  .what-visual-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-foreground) 7%, transparent);
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-foreground) 38%, transparent);
  }

  .what-live-dot {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
  }

  .what-visual-note {
    margin: 0;
    padding: 0 0.15rem 0.1rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-foreground) 38%, transparent);
  }

  .what-visual-note span {
    color: color-mix(in srgb, var(--color-accent) 78%, transparent);
  }

  @media (min-width: 1024px) {
    .what-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: stretch;
    }
  }

  @media (max-width: 640px) {
    .what-sub {
      flex-basis: 100%;
      max-width: 100%;
    }
  }

  @keyframes hero-shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-role-accent,
    .shiny-accent {
      animation: none;
    }

    .what-item,
    .what-chevron,
    .what-icon {
      transition: none;
    }

    .what-items {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }

    // ── Card glow follow cursor ──
    document.querySelectorAll<HTMLElement>(".card-glow").forEach(card => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });

    // ── "What I do?" behaves as a single-open accordion ──
    document
      .querySelectorAll<HTMLDetailsElement>(".what-item")
      .forEach(item => {
        if (item.dataset.accordionReady === "true") return;
        item.dataset.accordionReady = "true";

        item.addEventListener("toggle", () => {
          if (!item.open) return;
          document
            .querySelectorAll<HTMLDetailsElement>(".what-item")
            .forEach(other => {
              if (other !== item) other.open = false;
            });
        });
      });
  });
</script>
