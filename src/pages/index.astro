    }
  }

  @media (max-height: 860px) and (min-width: 1024px) {
    .hero-role {
      font-size: clamp(3.2rem, 7vw, 6.1rem);
    }

    .what-visual-rain {
      min-height: 12rem;
    }
  }

  @media (max-height: 800px) {
    .hero-role {
      font-size: clamp(2.75rem, 5.9vw, 5rem);
    }

    .hero-greeting {
      margin-top: 0.15rem;
    }

    .hero-role-grid {
      margin-top: 0.85rem;
    }

    .hero-meta-row {
      margin-top: 1rem;
      padding-top: 0.8rem;
    }

    .what-head {
      margin-bottom: 0.8rem;
    }

    .what-item summary {
      padding: 0.6rem 0.85rem;
    }

    .what-visual-rain {
      min-height: 11rem;
    }
  }

  /* Very short viewports: favour showing the whole first screen */
  @media (max-height: 820px) {
    .hero-role {
      font-size: clamp(2.6rem, 5.4vw, 4.7rem);
    }

    .hero-intro {
      font-size: 1.04rem;
      line-height: 1.62;
    }

    .hero-meta-row {
      margin-top: 0.85rem;
      padding-top: 0.65rem;
    }

    .home-intro-bottom {
      margin-top: 0.7rem;
    }

    .what-section {
      margin-top: 0.75rem;
    }

    .what-head {
      margin-bottom: 0.6rem;
    }

    .what-title {
      font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    }

    .what-item summary {
      padding: 0.48rem 0.8rem;
    }

    .what-icon {
      width: 1.7rem;
      height: 1.7rem;
    }
  }

  /* ── Featured carousel ── */
  #what-i-do,
  #featured,
  #recent-posts {
    scroll-margin-top: 5.5rem;
  }

  .featured-controls {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.35rem;
  }

  .featured-counter {
    margin-right: 0.3rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-foreground) 34%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .featured-arrow {
    display: inline-grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 999px;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 42%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .featured-arrow:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .featured-arrow:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
  }

  .featured-arrow:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 2px;
  }

  .featured-arrow svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .featured-rail {
    position: relative;
    margin-inline: -0.25rem;
  }

  .featured-track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
  }

  .featured-track > :global(li) {
    flex: 0 0 calc(50% - 0.5rem);
    min-width: 0;
    margin: 0;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* More than two featured posts: horizontal rail with the next card peeking */
  .featured-rail.is-scrollable .featured-track > :global(li) {
    flex-basis: calc(50% - 1rem);
  }

  .featured-rail.is-scrollable {
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    will-change: scroll-position;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 1.6rem,
      black calc(100% - 4.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 1.6rem,
      black calc(100% - 4.5rem),
      transparent 100%
    );
  }

  .featured-rail.is-scrollable.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .featured-rail.is-scrollable::-webkit-scrollbar {
    display: none;
  }

  .featured-progress {
    height: 1px;
    margin: 0.8rem 0.5rem 0;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .featured-progress span {
    display: block;
    width: var(--featured-progress, 20%);
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-accent) 65%, transparent);
    transition: width 0.18s ease;
  }

  @media (max-width: 640px) {
    .featured-track {
      flex-direction: column;
      gap: 0.75rem;
    }

    .featured-track > :global(li) {
      flex-basis: auto;
      width: 100%;
    }

    .featured-rail.is-scrollable {
      margin-inline: -0.25rem;
    }

    .featured-rail.is-scrollable .featured-track {
      flex-direction: row;
      gap: 0.75rem;
    }

    .featured-rail.is-scrollable .featured-track > :global(li) {
      flex: 0 0 100%;
      width: auto;
    }

    .featured-counter {
      display: none;
    }

    .featured-arrow {
      width: 1.6rem;
      height: 1.6rem;
    }
  }

  @keyframes hero-shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-role-accent,
    .shiny-accent {
      animation: none;
    }

    .what-item,
    .what-chevron,
    .what-icon {
      transition: none;
    }

    .what-items {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }

    // ── Card glow follow cursor ──
    document.querySelectorAll<HTMLElement>(".card-glow").forEach(card => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });

    // ── "What I do?" behaves as a single-open accordion ──
    const accordionItems = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".what-item")
    );
    const savedAccordion = Number(localStorage.getItem("what-open"));
    const initialAccordion =
      Number.isInteger(savedAccordion) &&
      savedAccordion >= 0 &&
      savedAccordion < accordionItems.length
        ? savedAccordion
        : 0;
    accordionItems.forEach((item, itemIndex) => {
      if (item.dataset.accordionReady === "true") return;
      item.dataset.accordionReady = "true";
      item.open = itemIndex === initialAccordion;

      const summary = item.querySelector("summary");
      summary?.addEventListener("click", event => {
        // Clicking the open item must not collapse it (that would move the
        // page); clicking a closed one closes its siblings *before* the
        // browser opens it, so two panels are never open at once.
        if (item.open) {
          event.preventDefault();
          return;
        }
        document
          .querySelectorAll<HTMLDetailsElement>(".what-item")
          .forEach(other => {
            if (other !== item) other.open = false;
          });
      });

      item.addEventListener("toggle", () => {
        if (!item.open) return;
        localStorage.setItem("what-open", String(itemIndex));
        document
          .querySelectorAll<HTMLDetailsElement>(".what-item")
          .forEach(other => {
            if (other !== item) other.open = false;
          });
      });
    });

    // ── First-screen scroll cue ──
    const cue = document.querySelector<HTMLButtonElement>("[data-scroll-cue]");
    if (cue && cue.dataset.cueReady !== "true") {
      cue.dataset.cueReady = "true";

      const syncCue = () => {
        const visible = window.scrollY < 48;
        cue.dataset.visible = String(visible);
        cue.tabIndex = visible ? 0 : -1;
        cue.setAttribute("aria-hidden", String(!visible));
      };

      cue.addEventListener("click", () => {
        const target =
          document.querySelector("#featured") ??
          document.querySelector("#recent-posts");
        target?.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      window.addEventListener("scroll", syncCue, { passive: true });
      syncCue();
    }

    // ── Featured rail: arrows, counter, progress ──
    const rail = document.querySelector<HTMLElement>("[data-featured-rail]");
    if (rail && rail.dataset.carouselReady !== "true") {
      rail.dataset.carouselReady = "true";

      const track = rail.querySelector<HTMLElement>(".featured-track");
      const cards = track
        ? Array.from(track.children).filter(
            child => child instanceof HTMLElement
          )
        : [];
      const prev = document.querySelector<HTMLButtonElement>(
        "[data-featured-prev]"
      );
      const next = document.querySelector<HTMLButtonElement>(
        "[data-featured-next]"
      );
      const counter = document.querySelector<HTMLElement>(
        "[data-featured-counter]"
      );
      const progress = document.querySelector<HTMLElement>(
        "[data-featured-progress]"
      );

      if (cards.length && rail.classList.contains("is-scrollable")) {
        const pad = (value: number) => String(value).padStart(2, "0");
        const gap = 16;

        const update = () => {
          const max = rail.scrollWidth - rail.clientWidth;
          const cardWidth =
            cards[0] instanceof HTMLElement
              ? cards[0].getBoundingClientRect().width
              : rail.clientWidth / 2;
          const active = Math.min(
            cards.length,
            Math.max(1, Math.round(rail.scrollLeft / (cardWidth + gap)) + 1)
          );

          if (counter) {
            counter.textContent = `${pad(active)} / ${pad(cards.length)}`;
          }

          progress?.style.setProperty(
            "--featured-progress",
            `${Math.max(6, max > 0 ? (rail.scrollLeft / max) * 100 : 0)}%`
          );

          if (prev) prev.disabled = rail.scrollLeft <= 8;
          if (next) next.disabled = rail.scrollLeft >= max - 8;
        };

        const step = () => {
          const cardWidth =
            cards[0] instanceof HTMLElement
              ? cards[0].getBoundingClientRect().width
              : rail.clientWidth / 2;
          return cardWidth + gap;
        };

        prev?.addEventListener("click", () =>
          rail.scrollBy({ left: -step(), behavior: "smooth" })
        );
        next?.addEventListener("click", () =>
          rail.scrollBy({ left: step(), behavior: "smooth" })
        );
        rail.addEventListener("scroll", () => requestAnimationFrame(update), {
          passive: true,
        });
        window.addEventListener("resize", update);
        update();

        // ── Drag to slide (mouse / pen); touch keeps native momentum ──
        let dragStartX = 0;
        let dragStartLeft = 0;
        let dragTargetLeft = 0;
        let dragPointer = -1;
        let dragging = false;
        let dragFrame = 0;
        let suppressClick = false;

        rail.addEventListener("dragstart", event => event.preventDefault());

        rail.addEventListener("pointerdown", event => {
          if (event.pointerType === "touch" || event.button !== 0) return;
          dragPointer = event.pointerId;
          dragStartX = event.clientX;
          dragStartLeft = rail.scrollLeft;
          dragTargetLeft = dragStartLeft;
          dragging = false;
        });

        rail.addEventListener("pointermove", event => {
          if (event.pointerId !== dragPointer) return;
          const dx = event.clientX - dragStartX;
          if (!dragging) {
            if (Math.abs(dx) < 5) return;
            dragging = true;
            rail.classList.add("is-dragging");
          }
          dragTargetLeft = dragStartLeft - dx;
          if (dragFrame) return;
          dragFrame = requestAnimationFrame(() => {
            dragFrame = 0;
            rail.scrollLeft = dragTargetLeft;
          });
        });

        const endDrag = (event: PointerEvent) => {
          if (event.pointerId !== dragPointer) return;
          dragPointer = -1;
          if (!dragging) return;
          dragging = false;
          cancelAnimationFrame(dragFrame);
          dragFrame = 0;
          rail.scrollLeft = dragTargetLeft;
          rail.classList.remove("is-dragging");
          suppressClick = true;
          requestAnimationFrame(() => {
            suppressClick = false;
          });
        };

        rail.addEventListener("pointerup", endDrag);
        rail.addEventListener("pointercancel", endDrag);
        rail.addEventListener("pointerleave", endDrag);

        rail.addEventListener(
          "click",
          event => {
            if (!suppressClick) return;
            event.preventDefault();
            event.stopPropagation();
          },
          true
        );
      }
    }
  });
</script>
