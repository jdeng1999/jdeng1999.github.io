---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import CodeGlitch from "@/components/CodeGlitch.astro";
import TechMarquee from "@/components/TechMarquee.astro";
import HeroTerminal from "@/components/HeroTerminal.astro";
import { useTranslations } from "@/i18n/utils";
import { getEntryPath } from "@/utils/contentEntry";
import { getLocalizedTitle } from "@/utils/localizedTitle";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const introVariantIds: Array<"en" | "zh" | "es"> =
  locale === "es"
    ? ["es", "en"]
    : [locale === "zh" ? "zh" : "en", locale === "zh" ? "en" : "zh"];
const introVariants = introVariantIds.map(id => ({
  id,
  t: useTranslations(id),
  active: id === locale,
}));
const prefix = locale === "es" ? "/es" : locale === "zh" ? "/zh" : "";
const contentLocale = locale;

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog", ({ id }) => id.startsWith(`${contentLocale}/`)),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries", ({ id }) => id.startsWith(`${contentLocale}/`))
    : Promise.resolve([]),
]);
const posts = [...blogPosts, ...galleryPosts];

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(
  ({ data }) => "featured" in data && data.featured
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !("featured" in data && data.featured)
);

const terminalPosts = sortedPosts.map(post => ({
  title: getLocalizedTitle(post.id, post.data.title, locale),
  href: `${prefix}${getEntryPath(post)}`,
}));

const whatIDo =
  locale === "zh"
    ? [
        {
          title: "后端工程",
          icon: "server" as const,
          items: [
            "Java 与 Spring Boot",
            "REST API 与整洁架构",
            "MySQL、Redis、Maven",
          ],
        },
        {
          title: "前端与界面",
          icon: "layout" as const,
          items: ["Astro 与 Tailwind CSS", "响应式与可访问布局", "交互细节"],
        },
        {
          title: "DevOps 与交付",
          icon: "terminal" as const,
          items: ["Docker 与 Linux", "Git 工作流", "构建与部署自动化"],
        },
      ]
    : locale === "es"
      ? [
          {
            title: "Ingeniería Backend",
            icon: "server" as const,
            items: [
              "Java y Spring Boot",
              "APIs REST y arquitectura limpia",
              "MySQL, Redis y Maven",
            ],
          },
          {
            title: "Frontend e Interfaces",
            icon: "layout" as const,
            items: [
              "Astro y Tailwind CSS",
              "Diseño responsive y accesible",
              "Detalles de interacción",
            ],
          },
          {
            title: "DevOps y Entrega",
            icon: "terminal" as const,
            items: [
              "Docker y Linux",
              "Flujos de trabajo con Git",
              "Builds y despliegues automatizados",
            ],
          },
        ]
      : [
          {
            title: "Backend Engineering",
            icon: "server" as const,
            items: [
              "Java & Spring Boot services",
              "REST APIs & clean architecture",
              "MySQL, Redis & Maven",
            ],
          },
          {
            title: "Frontend & Interfaces",
            icon: "layout" as const,
            items: [
              "Astro & Tailwind CSS",
              "Responsive, accessible layouts",
              "Interaction details",
            ],
          },
          {
            title: "DevOps & Delivery",
            icon: "terminal" as const,
            items: [
              "Docker & Linux",
              "Git workflows",
              "Build & deploy automation",
            ],
          },
        ];

const whatIcons = {
  server: `<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01M11 7.5h2M11 16.5h2"/>`,
  layout: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 21V9"/>`,
  terminal: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>`,
} as const;
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <div class="home-intro">
      <!-- ═══════════════════ HERO ═══════════════════ -->
      <section
        id="hero"
        class="hero-section relative pt-2 pb-5 sm:pt-3 sm:pb-7"
      >
        <div class="relative z-10">
          <div class="hero-copy">
            <!-- Terminal prompt badge + interactive shell -->
            <HeroTerminal posts={terminalPosts} />

            <p class="hero-greeting">
              <span class="hero-greeting-dot" aria-hidden="true"></span>
              {t("index.heroGreeting")}
              <span class="hero-name">
                J. Deng
                <span class="hero-name-native">(邓佳)</span>
              </span>
            </p>

            <div class="hero-role-grid">
              <h1 class="hero-role">
                <span class="hero-role-line">Software</span>
                <span class="hero-role-line hero-role-accent">Engineer</span>
              </h1>

              <div class="hero-intro-panel">
                <div class="hero-intro-stack">
                  {introVariants.map(variant => (
                    <p
                      class:list={[
                        "hero-intro",
                        { "is-active": variant.active },
                      ]}
                      aria-hidden={variant.active ? undefined : "true"}
                    >
                      {variant.t("index.heroIntroBefore")}
                      <span class="shiny-accent">
                        {variant.t("index.heroIntroHighlight")}
                      </span>
                      {variant.t("index.heroIntroAfter")}
                      <span class="hero-intro-tail">
                        {variant.t("index.heroIntroTail")}
                      </span>
                    </p>
                  ))}
                </div>

                <div class="hero-meta-row">
                  <p class="hero-written">
                    {t("index.writtenBy")}
                    <LinkButton
                      class="font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
                      href={SITE.profile}
                      target="_blank"
                    >
                      {SITE.author}
                    </LinkButton>
                  </p>

                  {SOCIALS.length > 0 && (
                    <div class="hero-socials">
                      <Socials />
                      <a
                        target="_blank"
                        href={`${prefix}/rss.xml`}
                        class="hero-rss"
                        aria-label="RSS Feed"
                        title="RSS Feed"
                      >
                        <IconRss width={16} height={16} />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════ TECH STACK ═══════════════════ -->
      <div class="home-intro-bottom">
        <TechMarquee label={t("index.techStack")} />
      </div>

      <!-- ═══════════════════ WHAT I DO ═══════════════════ -->
      <section id="what-i-do" class="what-section relative">
        <div class="what-head">
          <div class="what-head-copy">
            <h2 class="what-title">{t("index.whatIDo")}</h2>
          </div>
          <div class="what-head-line" aria-hidden="true"></div>
        </div>

        <div class="what-grid">
          <div class="what-list">
            {whatIDo.map((item, index) => (
              <details class="what-item" open={index === 0}>
                <summary>
                  <span class="what-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={whatIcons[item.icon]}
                    />
                  </span>
                  <span class="what-item-title">{item.title}</span>
                  <svg
                    class="what-chevron"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <ul class="what-items">
                  {item.items.map(entry => (
                    <li>
                      <span class="what-bullet" aria-hidden="true" />
                      <span>{entry}</span>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>

          <div class="what-visual">
            <div class="what-visual-rain">
              <CodeGlitch />
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ═══════════════════ FEATURED ═══════════════════ -->
    {featuredPosts.length > 0 && (
      <section id="featured" class="featured-section pb-6">
        <div class="mb-5 flex items-center gap-3">
          <h2 class="flex items-center gap-2 text-sm font-bold tracking-widest text-accent uppercase">
            <svg
              class="size-4"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {t("index.featured")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
          {featuredPosts.length > 2 && (
            <div class="featured-controls">
              <span class="featured-counter" data-featured-counter>
                01 / {String(featuredPosts.length).padStart(2, "0")}
              </span>
              <button
                type="button"
                class="featured-arrow"
                data-featured-prev
                aria-label={
                  locale === "es"
                    ? "Anterior"
                    : locale === "zh"
                      ? "上一篇"
                      : "Previous"
                }
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
              </button>
              <button
                type="button"
                class="featured-arrow"
                data-featured-next
                aria-label={
                  locale === "es"
                    ? "Siguiente"
                    : locale === "zh"
                      ? "下一篇"
                      : "Next"
                }
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </button>
            </div>
          )}
        </div>

        <div
          class:list={[
            "featured-rail",
            featuredPosts.length > 2 && "is-scrollable",
          ]}
          data-featured-rail
        >
          <ul class="featured-track" role="list">
            {featuredPosts.map((data, index) => (
              <Card
                variant="h3"
                featured={true}
                id={data.id}
                collection={data.collection}
                data={data.data}
                body={data.body}
                filePath={data.filePath}
                loading={index < 2 ? "eager" : "lazy"}
                fetchpriority={index < 2 ? "high" : "auto"}
              />
            ))}
          </ul>
        </div>

        {featuredPosts.length > 2 && (
          <div
            class="featured-progress"
            data-featured-progress
            aria-hidden="true"
          >
            <span></span>
          </div>
        )}
      </section>
    )}

    <!-- ═══════════════════ RECENT POSTS ═══════════════════ -->
    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-6 pb-6">
        <div class="mb-6 flex items-center gap-3">
          <h2 class="text-sm font-bold tracking-widest uppercase">
            {t("index.recent")}
          </h2>
          <div class="h-px flex-1 bg-border/20" />
          <span class="font-firacode text-xs text-accent/80 select-none">
            [{recentPosts.slice(0, SITE.postPerIndex).length}/
            {recentPosts.length}]
          </span>
        </div>
        <ul
          class:list={[
            SITE.indexPostsGrid &&
              "grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3",
          ]}
        >
          {recentPosts.map(
            (data, index) =>
              index < SITE.postPerIndex && (
                <Card
                  variant="h3"
                  id={data.id}
                  collection={data.collection}
                  data={data.data}
                  body={data.body}
                  filePath={data.filePath}
                  sequence={index + 1}
                  loading={index < 2 ? "eager" : "lazy"}
                  fetchpriority={index < 2 ? "high" : "auto"}
                />
              )
          )}
        </ul>

        <!-- ═══════════════════ CTA ═══════════════════ -->
        <div class="mt-8 mb-4 flex justify-center w-full">
          <LinkButton
            href={`${prefix}/posts/`}
            class="group inline-flex items-center w-full sm:w-auto justify-center gap-2 rounded-xl border border-accent/20 bg-accent/10 px-8 py-4 text-base font-bold text-accent transition-all duration-300 hover:border-accent hover:bg-accent/20 hover:shadow-xl hover:shadow-accent/20 hover:-translate-y-0.5"
          >
            {t("index.exploreAll")}
            <IconArrowRight class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:-rotate-180" />
          </LinkButton>
        </div>
      </section>
    )}

    <!-- Bare scroll cue: only visible at the top of the home page -->
    <button
      type="button"
      class="scroll-cue"
      data-scroll-cue
      data-visible="false"
      aria-label={
        locale === "es"
          ? "Ir a los artículos"
          : locale === "zh"
            ? "前往文章"
            : "Scroll to articles"
      }
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
  </main>
  <Footer />
</Layout>

<style>
  /* ── First screen: hero + marquee + What I do ── */
  .home-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - 4.5rem);
    padding-bottom: 3.5rem;
  }

  .hero-section {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
  }

  .home-intro-bottom {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    margin-top: clamp(0.9rem, 2vh, 1.7rem);
  }

  .what-section {
    margin-top: clamp(1.9rem, 3.8vh, 3.1rem);
  }

  .scroll-cue {
    position: fixed;
    z-index: 30;
    bottom: 1.4rem;
    left: 50%;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--color-foreground) 38%, transparent);
    cursor: pointer;
    transform: translateX(-50%);
    transition: color 0.2s ease;
  }

  .scroll-cue svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .scroll-cue:hover {
    color: var(--color-accent);
  }

  .scroll-cue:focus-visible {
    border-radius: 999px;
    outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    outline-offset: 3px;
  }

  .scroll-cue[data-visible="false"] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
  }

  @media (max-width: 640px) {
    .scroll-cue {
      bottom: calc(0.9rem + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 640px) {
    .home-intro {
      min-height: calc(100svh - 4.25rem);
      padding-bottom: 3.25rem;
    }
  }

  /* ── Hero ── */
  .hero-copy {
    min-width: 0;
  }

  .hero-greeting {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.35rem;
    font-family: var(--font-firacode), ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-foreground) 48%, transparent);
  }

  .hero-greeting-dot {
    width: 0.38rem;
    height: 0.38rem;
    flex: none;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .hero-name {
    color: var(--color-foreground);
    letter-spacing: 0.06em;
  }

  .hero-name-native {
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .hero-role-grid {
    display: grid;
    gap: 1.4rem 2.5rem;
    margin-top: 1.1rem;
  }

  .hero-role {
    margin: 0;
    padding-bottom: 0.05em;
    font-size: clamp(3.6rem, 8.4vw, 7.2rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-role-line {
    display: block;
  }

  .hero-role-accent {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    background: linear-gradient(
      120deg,
      var(--color-accent) 0%,
      color-mix(in oklab, var(--color-accent) 45%, var(--color-foreground)) 45%,
      var(--color-accent) 100%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 7s ease-in-out infinite;
  }

  .hero-intro-panel {
    position: relative;
    align-self: end;
    max-width: 37rem;
    padding-left: 1.7rem;
  }

  /* Tapered gradient rule: wide and bright at the top, thinning into nothing */
  .hero-intro-panel::before {
    position: absolute;
    top: 0.2rem;
    bottom: 0.35rem;
    left: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent) 0%,
      color-mix(in srgb, var(--color-accent) 62%, transparent) 42%,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 78%,
      transparent 100%
    );
    clip-path: polygon(0 0, 100% 0, 68% 100%, 32% 100%);
    content: "";
  }

  .hero-intro-panel::after {
    position: absolute;
    top: 0;
    left: -1px;
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--color-accent);
    box-shadow: 0 0 10px 1px
      color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: rotate(45deg);
    content: "";
  }

  .hero-intro {
    margin: 0;
    font-size: 1.14rem;
    line-height: 1.78;
    letter-spacing: 0.002em;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    text-wrap: pretty;
  }

  /* All locales share the same footprint, so switching language can never
     move the divider, meta row or socials. */
  .hero-intro-stack {
    display: grid;
  }

  .hero-intro-stack > .hero-intro {
    grid-area: 1 / 1;
  }

  .hero-intro-stack > .hero-intro:not(.is-active) {
    visibility: hidden;
  }

  .hero-intro-tail {
    font-family:
      "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.16em;
    letter-spacing: 0.005em;
    color: color-mix(in srgb, var(--color-accent) 82%, var(--color-foreground));
  }

  .shiny-accent {
    font-weight: 600;
    background: linear-gradient(
      120deg,
      var(--color-accent) 15%,
      color-mix(in oklab, var(--color-accent) 35%, #ffffff) 50%,
      var(--color-accent) 85%
    );
    background-size: 240% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-shine 4.5s linear infinite;
  }

  .hero-meta-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1rem;
    margin-top: 1.1rem;
    padding-top: 0.85rem;
  }

  .hero-meta-row::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-accent) 28%, transparent),
      color-mix(in srgb, var(--color-foreground) 7%, transparent) 45%,
      transparent
    );
    content: "";
  }

  .hero-written {
    margin: 0;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--color-foreground) 46%, transparent);
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .hero-socials::before {
    width: 1px;
    height: 1.15rem;
    margin-right: 0.9rem;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-foreground) 18%, transparent),
      transparent
    );
    content: "";
  }

  .hero-rss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-left: 0.1rem;
    color: color-mix(in srgb, var(--color-foreground) 38%, transparent);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-rss:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .hero-rss :global(svg) {
    stroke: currentColor;
    stroke-width: 2.2;
  }

  @media (min-width: 1024px) {
    .hero-role-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: end;
    }
  }

  @media (max-width: 1023px) {
    .hero-intro-panel {
      max-width: 100%;
    }
  }

  /* ── What I do ── */
  .what-section {
    position: relative;
  }

  .what-head {
    display: flex;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .what-head-line {
    flex: 1;
    height: 1px;
    margin-bottom: 0.35rem;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-foreground) 9%, transparent),
      transparent
    );
  }

  .what-title {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.015em;
    word-spacing: 0.06em;
  }

  .what-grid {
    display: grid;
    gap: 1rem;
  }

  .what-list {
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    min-width: 0;
