  .what-item[open] {
    border-color: color-mix(in srgb, var(--color-accent) 28%, transparent);
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--color-accent) 7%, transparent),
        transparent 65%
      ),
      color-mix(in srgb, var(--color-foreground) 2.5%, var(--color-background));
